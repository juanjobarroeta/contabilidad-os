// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // hashed, null if OAuth only
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Operador de plataforma: supervisión cross-despacho. Ve y opera TODAS las
  // empresas activas de todos los despachos (soporte/supervisión de pilotos).
  // Sólo se activa por script (scripts/set-operador.mjs) — nunca self-serve.
  esOperador Boolean @default(false)

  // Subscription / trial — billing-per-RFC, sub lives on the account owner
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  // Stripe (filled in when phase 5 lands)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?

  // Preferencias de notificaciones push, por categoría. Modelo opt-out: una
  // categoría ausente o true = activada. Shape: { cfdis?: bool, declaraciones?: bool }.
  notifPrefs Json?

  accounts            Account[]
  sessions            Session[]
  memberships         CompanyMember[]
  // Despacho membership — each user belongs to at most ONE despacho.
  // Companies owned by the despacho are automatically visible to all members.
  // Per-company CompanyMember rows are still used for one-off access grants
  // to users outside the owning despacho.
  despachoMemberships DespachoMember[]
  // Verified WhatsApp numbers bound to this user (W0 channel).
  whatsappLinks       WhatsappLink[]
  // Pending link codes (deep-link flow): the user sends the code TO the business
  // number from WhatsApp to bind their number — no phone known at creation time.
  whatsappLinkCodes   WhatsappLinkCode[]
  chatConversations   ChatConversation[]
  // Refresh tokens de la API de satélites (flujo access corto + refresh rotatorio).
  apiRefreshTokens    ApiRefreshToken[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Companies (Multi-tenant core) ───────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Despacho that owns this company. All despacho members have implicit ADMIN
  // access. Nullable for backwards-compat with companies created before the
  // despacho model was introduced; backfilled by the migration script.
  despachoId String?
  despacho   Despacho? @relation(fields: [despachoId], references: [id], onDelete: SetNull)

  // Grupo (sub-conjunto de empresas del mismo dueño que se facturan entre sí).
  // Habilita la detección de operaciones intercompañía (Art. 69-B CFF) y las
  // funciones del piloto (comisiones, materialidad) por grupo.
  grupoId String?
  grupo   Grupo?  @relation(fields: [grupoId], references: [id], onDelete: SetNull)

  // SAT / fiscal data
  rfc             String  @unique
  razonSocial     String
  regimenFiscal   String // e.g. "601" = General de Ley Personas Morales
  codigoPostal    String
  domicilioFiscal String?

  // Contact / additional info
  nombreComercial    String?
  email              String?
  telefono           String?
  actividadEconomica String? // SCIAN code description

  // CSD — Certificado de Sello Digital (for CFDI stamping).
  // All three are AES-256-GCM encrypted at rest via lib/crypto (enc:v1:… envelope).
  csdCer      String?   @db.Text // encrypted(base64 .cer)
  csdKey      String?   @db.Text // encrypted(base64 .key — private key!)
  csdPassword String? // encrypted password
  csdVigencia DateTime? // expiry date

  // e.firma / FIEL (for SAT declarations). Encrypted at rest (see above).
  fielCer      String?   @db.Text // encrypted(base64 .cer)
  fielKey      String?   @db.Text // encrypted(base64 .key — private key!)
  fielPassword String? // encrypted password
  fielVigencia DateTime? // expiry date

  // Automatic SAT sync (cron-driven Descarga Masiva). When enabled, the
  // background job periodically pulls emitidos/recibidos CFDIs without the
  // user having to click "Sincronizar". Defaults on so every company with a
  // valid FIEL is covered; can be turned off per-company.
  autoSyncEnabled Boolean   @default(true)
  lastAutoSyncAt  DateTime? // last time the cron touched this company

  // How far back to pull CFDIs on the initial historical backfill, chosen at
  // onboarding. 5 = SAT legal maximum, 1 = last year, 0 = no backfill. Still
  // clamped by fechaInicioOperaciones so we never ask before the RFC existed.
  satBackfillYears       Int       @default(5)
  // Set once the historical backfill has fully completed (all in-range periods
  // imported). Lets the throttled backfill cron skip finished companies.
  satBackfillCompletedAt DateTime?

  // Marca el momento en que se importó por ÚNICA vez la Contabilidad Electrónica
  // (Anexo 24) desde Syntage como apertura del ejercicio (catálogo + balanza). El
  // arranque automático es irrepetible: una vez fijado, el sync NUNCA vuelve a
  // importar la balanza del SAT como apertura (sobreescribiría el libro vivo). El
  // botón manual ("Traer de Syntage automáticamente") es el único forzado de
  // re-importación y puede re-fijar esta marca.
  ceBootstrapAt DateTime?

  // Selected subscription plan (UI/trial only for now — no billing yet):
  // "BASICO" | "PROFESIONAL" | "DESPACHO".
  plan String?

  // Earliest date this RFC could have CFDIs — captured from the Constancia de
  // Situación Fiscal (fechaInicioRegimen) at onboarding. Used to clamp the
  // historical backfill so we don't ask SAT for periods before the company
  // existed (which would waste the per-RFC request quota).
  fechaInicioOperaciones DateTime?

  // Facturapi integration
  facturapiOrgId           String? // Facturapi organization ID for this company
  facturapiApiKey          String? // live API key stored encrypted
  // When the user acknowledged they must sign Facturapi's Carta Manifiesto
  // (signed with e.firma on Facturapi's portal — we can't verify completion,
  // only that they were prompted during onboarding).
  facturapiManifiestoAckAt DateTime?

  // Logo / branding
  logoUrl String?

  // ISR — Coeficiente de utilidad (Art. 14 LISR) set once per fiscal year
  coeficienteUtilidad Float? // Stored after user confirms/overrides auto-calculation
  coeficienteAnio     Int? // Which fiscal year this coeficiente applies to

  // ISR — Pérdidas fiscales de ejercicios anteriores pendientes de aplicar (Art. 14)
  perdidaFiscalPendiente Float? // Monto ACTUALIZADO del remanente pendiente de amortizar
  perdidaFiscalAnio      Int? // Ejercicio al que corresponde el remanente (última anual)

  // Apertura fiscal — momento en que el contador revisó y CONFIRMÓ el punto de
  // partida (saldo a favor de IVA inicial, pérdidas por amortizar, coeficiente,
  // pagos provisionales previos y obligaciones). Null = aún sin confirmar. Las
  // correcciones posteriores no borran la marca; re-confirmar la actualiza.
  aperturaConfirmadaAt  DateTime?
  aperturaConfirmadaPor String? // email (o id) del usuario que confirmó

  // Precio mensual por empresa para análisis de rentabilidad (centavos MXN).
  // Sólo unit economics; desacoplado del trial/subscription gating.
  precioMensualCentavos Int?

  // Tier comercial — define qué se sirve y, sobre todo, qué COGS se incurre.
  // ASISTENTE = CFDIs + IA (sin Syntage, COGS ~0). AUTOMATIZADO+ = incluye
  // extracciones de Syntage (opinión/CSF/declaraciones). Lo usa el
  // aprovisionamiento para NO gastar Syntage en empresas que no lo pagan.
  // (Distinto del `plan` string de subscription/UI de arriba.)
  tier CompanyPlan @default(AUTOMATIZADO)

  // Plataformas tecnológicas (régimen 625, Art. 113-A LISR): tipo de actividad
  // que define la tasa de retención. "transporte" (2.1%), "hospedaje" (4%) o
  // "servicios" = enajenación de bienes / prestación de servicios (1%).
  // Null → el motor asume "servicios" y lo señala.
  plataformaActividad String?

  // Nómina — IMSS registro patronal (required for CFDI nómina emisor block)
  registroPatronal String? // e.g. "A7025105103"

  // Cadencia de nómina de la empresa — gobierna el recordatorio proactivo T-1
  // (avisar "mañana toca timbrar"). Default QUINCENAL (lo más común en MX); el
  // cron infiere la real desde la periodicidad de los empleados / corridas
  // pasadas cuando puede. No bloquea ni dispara timbrado: sólo recuerda.
  periodicidadNomina PeriodicidadNomina @default(QUINCENAL)

  isActive Boolean @default(true)

  // Relations
  members           CompanyMember[]
  invoices          Invoice[]
  customers         Customer[]
  suppliers         Supplier[]
  bankAccounts      BankAccount[]
  bankTransactions  BankTransaction[]
  employees         Employee[]
  payrollRuns       PayrollRun[]
  taxDeclarations   TaxDeclaration[]
  obligations       CompanyObligation[]
  perdidasFiscales  PerdidaFiscal[]
  costEvents        CostEvent[]
  coeEnvios         CoeEnvio[]
  accountingEntries AccountingEntry[]
  accounts          ChartAccount[]
  accountingPeriods AccountingPeriod[]
  satSyncRequests   SatSyncRequest[]

  // Module gating (SaaS): which features this company has contracted
  modules CompanyModule[]

  // Construction module (only used when CONSTRUCCION is enabled)
  proyectos           Proyecto[]
  conceptos           Concepto[]
  apus                APU[]
  insumos             Insumo[]
  presupuestos        Presupuesto[]
  estimaciones        Estimacion[]
  estimacionTemplates EstimacionTemplate[]
  solicitudesCompra   SolicitudCompra[]
  pagos               Pago[]
  imssMovimientos     ImssMovimiento[]
  incidencias         Incidencia[]

  // CONSTRUCCION_CUADRILLAS add-on (only populated when that module is enabled)
  cuadrillas Cuadrilla[]
  rayas      RayaSemanal[]

  // Gastos (Katia's validation + pay workflow for Bartiz field expenses)
  gastos     Gasto[]
  reembolsos ReembolsoSemanal[]

  // Despacho per-company scoping junction
  despachoMemberScopes DespachoMemberCompany[]

  // Client invitations scoped to this company
  invitations CompanyInvitation[]

  // WhatsApp channel (W0)
  whatsappLinks         WhatsappLink[]         @relation("WhatsappActiveCompany")
  whatsappConversations WhatsappConversation[]
  stagedActions         StagedAction[]
  importBatches         ImportBatch[]
  // Reglas de categorización persistidas por el usuario (Rappi, OpenAI, …): se
  // recuerdan y se re-aplican al importar y en el escaneo retroactivo.
  categorizationRules   CategorizationRule[]

  // Post-sync IVA-change notices (one baseline per unfiled period)
  ivaPeriodNotices IvaPeriodNotice[]

  // Activo fijo / inversiones — registro de depreciación (Art. 31/34 LISR)
  activosFijos ActivoFijo[]

  // Conversaciones del asistente IA (chat persistente, por empresa)
  chatConversations ChatConversation[]

  // All SAT régimenes this taxpayer is registered under. `regimenFiscal` above
  // remains the single "primary" (operative) régimen used by most flows; this
  // list captures the rest (common for personas físicas) so obligation and
  // annual-declaration logic can reason across all of them.
  regimenes CompanyRegimen[]

  // PADEL module (only used when PADEL is enabled) — see "Module: Padel" below.
  padelConfig  PadelClubConfig?
  courts       Court[]
  clubMembers  ClubMember[]
  reservations Reservation[]

  // RESTAURANTE module (only used when RESTAURANTE is enabled) — see
  // "Module: Restaurante" below.
  restauranteConfig  RestauranteConfig?
  restInsumos        RestInsumo[]
  restCompras        RestCompra[]
  restMenuCategorias RestMenuCategoria[]
  restMenuItems      RestMenuItem[]
  restOrdenes        RestOrden[]
}

model CompanyMember {
  id        String     @id @default(cuid())
  userId    String
  companyId String
  role      MemberRole @default(VIEWER)
  createdAt DateTime   @default(now())

  /// Per-user module restriction. Empty array = full access to every module
  /// the company has enabled (backwards-compatible default). Non-empty =
  /// this user can ONLY see/use the listed modules on this company, even if
  /// the company itself has more modules enabled.
  ///
  /// Use case: a construction PM (Rosy) should only access CONSTRUCCION
  /// on CONSTRUCTORA BARTIZ-VERT — not the accounting CFDI / bancos /
  /// nómina modules. Set allowedModules = ["CONSTRUCCION"].
  ///
  /// Enforced in THREE places:
  ///   1. /api/auth/token + /api/companies: filters the `modulos` array in
  ///      the login response so satellite apps only see the allowed subset
  ///   2. requireModule(companyId, modulo, req): 403s if the module isn't in
  ///      the user's allowed set for that company
  ///   3. (app)/layout.tsx: redirects users with no CONTABILIDAD access away
  ///      from the contabilidad-os web UI entirely
  allowedModules ModuloApp[] @default([])

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

enum MemberRole {
  OWNER
  ADMIN
  ACCOUNTANT
  VIEWER
}

// ─── Despacho (multi-user organization) ─────────────────────────────────────
//
// A Despacho groups users under one "agency / firma contable" umbrella.
// All companies owned by a despacho are automatically visible to every
// despacho member; no per-company invitation needed.
//
// Roles inside the despacho:
//   OWNER      — full control, incl. inviting users + deleting the despacho
//   ADMIN      — full control except delete despacho
//   ACCOUNTANT — can view/edit all despacho companies but can't manage users
//
// Despacho membership is IN ADDITION to per-company CompanyMember rows. A
// user outside the owning despacho can still be given specific company access
// via the existing CompanyMember flow — this covers edge cases like "external
// contador gets read-only access to one company".
model Despacho {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Precio mensual del despacho para análisis de rentabilidad (centavos MXN).
  // Sólo para unit economics; desacoplado del trial/subscription gating.
  precioMensualCentavos Int?

  members     DespachoMember[]
  companies   Company[]
  grupos      Grupo[]
  costEvents  CostEvent[]
  invitations CompanyInvitation[]
}

// Grupo de empresas — sub-conjunto del despacho del mismo dueño que se factura
// entre sí (p.ej. 3 empresas que se emiten CFDIs). Es la base de la detección
// intercompañía (Art. 69-B CFF) y de las funciones del piloto (comisiones,
// materialidad). Vive bajo el despacho; una empresa pertenece a 0 o 1 grupo.
model Grupo {
  id         String   @id @default(cuid())
  despachoId String
  nombre     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  despacho  Despacho  @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  companies Company[]

  @@index([despachoId])
}

model DespachoMember {
  id         String       @id @default(cuid())
  despachoId String
  userId     String
  role       DespachoRole @default(ACCOUNTANT)
  createdAt  DateTime     @default(now())

  despacho Despacho @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-company scoping: if this member has DespachoMemberCompany rows,
  // they can ONLY access those companies. If they have ZERO rows, they
  // get access to ALL despacho companies (backwards-compatible default).
  companyScopes DespachoMemberCompany[]

  @@unique([userId, despachoId])
  // A user belongs to at most one despacho — enforced by unique(userId)
  // so we can't accidentally double-enroll. Remove this if you ever need
  // multi-despacho users.
  @@unique([userId])
}

// Per-company access scoping within a despacho. When a DespachoMember has
// rows here, they can only access those specific companies. When they have
// NO rows, they get access to all despacho companies (default/owner behavior).
model DespachoMemberCompany {
  id               String   @id @default(cuid())
  despachoMemberId String
  companyId        String
  createdAt        DateTime @default(now())

  member  DespachoMember @relation(fields: [despachoMemberId], references: [id], onDelete: Cascade)
  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([despachoMemberId, companyId])
}

enum DespachoRole {
  OWNER
  ADMIN
  ACCOUNTANT
}

// ─── Client invitations (self-serve, scoped to ONE company) ─────────────────
//
// A despacho admin (OWNER/ADMIN of the despacho that OWNS the company) invites
// a CLIENT — their customer — to access EXACTLY ONE company. Accepting the
// invite creates a single CompanyMember row on that one company and NEVER a
// DespachoMember, so the client can only ever read that one company and never
// its despacho siblings.
//
// The token is delivered to the client out-of-band (link). Only its SHA-256
// hash is stored, so a database leak can't be replayed into account takeover.
// Single-use: status flips to ACCEPTED on first acceptance and the row is
// thereafter inert (acceptance is idempotent — re-hitting a consumed invite
// for the same email is a no-op success).
model CompanyInvitation {
  id              String                  @id @default(cuid())
  companyId       String
  despachoId      String
  // Despacho member (user) who created the invite — audit trail.
  invitedByUserId String
  email           String // lower-cased target email
  role            MemberRole              @default(VIEWER) // client role on the company
  // SHA-256 hash of the raw token (hex). The raw token only ever leaves the
  // server once, embedded in the accept link returned at creation time.
  tokenHash       String                  @unique
  status          CompanyInvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  // User that ultimately consumed the invite (set on accept).
  acceptedUserId  String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  despacho Despacho @relation(fields: [despachoId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([despachoId])
  @@index([email])
}

enum CompanyInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// ─── Module gating (SaaS) ────────────────────────────────────────────────────
// Tracks which product modules each Company has contracted. CONTABILIDAD is
// the base product and is enabled for every new company. Add-ons (CONSTRUCCION,
// FLOTA, etc.) are enabled manually or via Stripe webhook on add-on purchase.

model CompanyModule {
  id           String    @id @default(cuid())
  companyId    String
  modulo       ModuloApp
  habilitado   Boolean   @default(true)
  habilitadoAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, modulo])
}

enum ModuloApp {
  CONTABILIDAD
  CONSTRUCCION
  CONSTRUCCION_CUADRILLAS
  FLOTA
  MARKETING
  PADEL
  RESTAURANTE
}

// ─── Module 3: Invoicing / CFDI ───────────────────────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rfc           String
  razonSocial   String
  regimenFiscal String
  email         String?
  phone         String?
  domicilio     String?
  codigoPostal  String?

  // Facturapi customer ID
  facturapiId String?

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices    Invoice[]
  proyectos   Proyecto[]
  clubMembers ClubMember[]
  restOrdenes RestOrden[]

  @@unique([companyId, rfc])
}

model Supplier {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rfc           String
  razonSocial   String
  regimenFiscal String?
  email         String?

  // Datos bancarios para enviar SPEIs. CLABE es el dato canónico (18 dígitos);
  // `banco` y `cuentaBancaria` son auxiliares cuando el proveedor proporciona
  // sólo cuenta interbancaria. `titularCuenta` cubre el caso donde la cuenta
  // está a nombre de un tercero (común con personas físicas que facturan a
  // otro RFC).
  clabe          String?
  banco          String?
  cuentaBancaria String?
  titularCuenta  String?

  company           Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankTransactions  BankTransaction[]
  solicitudesCompra SolicitudCompra[]
  cotizaciones      SolicitudCompraCotizacion[]
  pagosProveedor    PagoProveedor[]
  terms             SupplierTerms?
  restCompras       RestCompra[]

  @@unique([companyId, rfc])
}

// Términos de crédito del proveedor — datos operativos del módulo
// construcción, deliberadamente fuera del Supplier fiscal (que se queda en
// RFC / régimen / CLABE). Relación 1:1 con el proveedor; cuentas-por-pagar /
// cashflow derivan el vencimiento de diasCredito más adelante.
model SupplierTerms {
  id         String   @id @default(cuid())
  supplierId String   @unique
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  tieneCredito  Boolean  @default(false)
  diasCredito   Int      @default(0) // 0 = contado
  limiteCredito Decimal? @db.Decimal(14, 2) // tope de crédito opcional (MXN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("construccion_supplier_terms")
}

model Invoice {
  id         String   @id @default(cuid())
  companyId  String
  customerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // CFDI data
  tipo       InvoiceType // INGRESO, EGRESO, TRASLADO, NOMINA, PAGO
  serie      String?
  folio      String?
  fecha      DateTime
  formaPago  String // SAT catalog key e.g. "01" = Efectivo
  metodoPago String // "PUE" or "PPD"
  usoCfdi    String // SAT catalog key e.g. "G01"

  // TipoDeComprobante del SAT (I/E/N/P/T). Null = legado (se asume I para
  // INGRESO/EGRESO). "E" marca una NOTA DE CREDITO: dentro de su tipo, el
  // motor fiscal la NETEA con signo negativo (emitida reduce ingresos e IVA
  // trasladado; recibida reduce deducciones e IVA acreditable).
  tipoSat             String?
  // CFDI relacionado (nota de credito emitida): UUID del padre y clave de
  // relacion SAT ("01" = nota de credito de los documentos relacionados).
  cfdiRelacionadoUuid String?
  tipoRelacion        String?
  moneda              String  @default("MXN")
  tipoCambio          Float   @default(1.0)
  subtotal            Float
  descuento           Float   @default(0)
  totalImpuestos      Float   @default(0)
  total               Float
  notas               String?

  // Contador override: if set, the posting engine uses this SAT account
  // instead of whatever classifyInvoice() would return. Stores the short
  // code like "601.15" — must match a ChartAccount in the catalog.
  overrideCuenta String?

  // Naturaleza fiscal (deducibilidad): GASTO | INVERSION | INVENTARIO |
  // SIN_EFECTOS, derivada del usoCfdi al importar (ver lib/fiscal/clasificar-cfdi).
  // Decide CÓMO se deduce un EGRESO (gasto inmediato vs depreciación vs costo de
  // lo vendido). NO se consume aún en el cálculo de ISR — se prepara el dato.
  naturaleza         String?
  /**
   * True cuando la clasificación necesita revisión del contador (señal no concluyente).
   */
  naturalezaRevision Boolean @default(false)
  /**
   * True cuando el contador fijó la naturaleza a mano — no la sobrescribe el re-sync.
   */
  naturalezaManual   Boolean @default(false)
  /**
   * El contador excluyó este CFDI del acreditamiento de IVA (p. ej. PUE no pagado:
   * el IVA sólo es acreditable si se pagó, Art. 5-I LIVA). Default false = sin efecto.
   */
  ivaNoAcreditable   Boolean @default(false)
  /**
   * El contador excluyó este CFDI del IVA trasladado (p. ej. PUE no cobrado:
   * el IVA se causa cuando se cobra, Art. 1-B/11/17 LIVA). Default false = sin efecto.
   */
  ivaNoCausado       Boolean @default(false)

  // Nómina (CFDI tipo "N"): datos del complemento de nómina 1.2 que el import del
  // SAT antes descartaba. regimenNomina = c_TipoRegimen del Receptor del
  // complemento (02 = sueldos; 05–11 = asimilados a salarios, Art. 94 LISR).
  // isrRetenidoNomina = ISR retenido por el retenedor (Deduccion TipoDeduccion
  // "002"); para asimilados RECIBIDOS es ISR acreditable del receptor. Null si el
  // CFDI no es nómina o se importó antes de parsear el complemento.
  regimenNomina     String?
  tipoNomina        String? // "O" ordinaria | "E" extraordinaria
  isrRetenidoNomina Float?

  // SAT stamping data (from PAC/Facturapi)
  status         InvoiceStatus @default(DRAFT)
  // Folio fiscal. Único POR EMPRESA, no global: un CFDI intercompañía (emisor y
  // receptor ambos en el sistema, p.ej. un grupo) debe poder guardarse en ambas
  // empresas — una como INGRESO y otra como EGRESO. La dedup de importación
  // filtra por companyId. Ver @@unique([companyId, uuid]) abajo.
  uuid           String? // Folio fiscal
  facturapiId    String? // Facturapi invoice ID
  xmlUrl         String?
  pdfUrl         String?
  // Original CFDI XML as downloaded from SAT (or uploaded). Stored so we can
  // re-send the authentic file (the legal artifact) over WhatsApp/web without
  // re-querying SAT. Only populated for CFDIs imported after this shipped.
  rawXml         String?       @db.Text
  cadenaOriginal String?       @db.Text
  selloSAT       String?       @db.Text
  selloCFD       String?       @db.Text

  // Cancellation (CFDI 4.0). motivo: SAT reason code 01-04. For motivo 01 a
  // substitution UUID is required (the replacement CFDI). We only set status
  // CANCELLED once Facturapi/SAT confirms — never optimistically.
  canceladaAt         DateTime?
  cancelMotivo        String? // "01" | "02" | "03" | "04"
  cancelSustituyeUuid String? // required when motivo = 01

  // Provenance: which product module created this invoice. NULL = generic/manual.
  origenModulo ModuloApp?

  // Llave de idempotencia para el timbrado vía POST /api/facturas: el cliente
  // manda una llave única por intento (header Idempotency-Key) y la ruta
  // RESERVA la llave creando esta fila ANTES de llamar al PAC — un segundo
  // request con la misma llave choca con @@unique([companyId, idempotencyKey])
  // y no consume otro timbre. NULL para importaciones y llamadores externos
  // que no mandan llave (Postgres permite múltiples NULL en el unique).
  idempotencyKey String?

  // Última verificación de vigencia por UUID contra el servicio público del SAT
  // (cron sat-vigencia-sync). Cursor del barrido incremental: se revisan primero
  // las facturas nunca verificadas y luego las de verificación más antigua.
  vigenciaCheckedAt DateTime?

  company              Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer             Customer?              @relation(fields: [customerId], references: [id])
  items                InvoiceItem[]
  taxes                InvoiceTax[]
  bankTransactions     BankTransaction[]
  // Conciliación uno-a-varios: porciones de movimientos asignadas a esta factura.
  conciliacionDetalles ConciliacionDetalle[]
  estimacion           Estimacion?
  // When this invoice is a complemento de pago (tipo=PAGO), the parent
  // invoice UUIDs it pays off (parsed from <pago:DoctoRelacionado>).
  doctosRelacionados   PagoDoctoRelacionado[]

  // Activos fijos registrados a partir de este CFDI (naturaleza = INVERSION).
  activosFijos ActivoFijo[]

  // Construcción: vínculo operativo (a requisición / gasto / estimación) +
  // estado de conciliación manual. Datos del módulo, no fiscales.
  construccionVinculo ConstruccionCfdiVinculo?

  // Restaurante: la orden (comanda) que se facturó con este CFDI.
  restOrden RestOrden?

  // Único por empresa: permite que un CFDI intercompañía viva en las dos
  // empresas (emisor + receptor) sin chocar, y evita duplicados dentro de una.
  @@unique([companyId, uuid])
  // Reserva de idempotencia al timbrar (ver campo idempotencyKey arriba).
  @@unique([companyId, idempotencyKey])
  // Listados por empresa ordenados/filtrados por fecha (GET /api/facturas).
  @@index([companyId, fecha])
  // Forma dominante de agregados fiscales: igualdad en companyId+tipo+status
  // y rango sobre fecha (dashboard, impuestos.computeTaxPosition, auto-conciliar).
  @@index([companyId, tipo, status, fecha])
}

// Vínculo operativo de un CFDI con su requisición / gasto / estimación, más el
// estado de conciliación manual (VINCULADA / IGNORADA). Es dato del módulo
// construcción —el CFDI fiscal vive en Invoice— join 1:1 por invoiceId. Los
// estados SUGERIDA / PAGADA / SIN_VINCULAR se derivan al leer; aquí sólo se
// persiste lo que el usuario confirma.
model ConstruccionCfdiVinculo {
  id          String   @id @default(cuid())
  invoiceId   String   @unique
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  companyId   String
  estado      String // VINCULADA | IGNORADA
  targetTipo  String? // SOLICITUD | GASTO | ESTIMACION | BANK_TX
  targetId    String?
  targetLabel String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@map("construccion_cfdi_vinculo")
}

// ── Activo fijo / inversión — registro de depreciación (Art. 31/34/36 LISR) ──
// Un CFDI con naturaleza INVERSION no se deduce de golpe: se capitaliza aquí y
// se deduce vía depreciación (lib/fiscal/depreciacion.ts). Un CFDI puede traer
// varios activos; por eso es una tabla aparte y no campos en Invoice.
model ActivoFijo {
  id        String   @id @default(cuid())
  companyId String
  invoiceId String? // CFDI de origen (null si se capturó a mano)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  descripcion      String
  tipo             String // construccion|mobiliario|transporte|computo|herramental|comunicaciones|maquinaria|otro
  moi              Float // Monto Original de la Inversión (sin IVA)
  fechaAdquisicion DateTime
  /**
   * Mes en que inicia su utilización, si difiere de la adquisición (Art. 31).
   */
  fechaInicioUso   DateTime?
  tasaAnual        Float // por ciento máximo Art. 34 aplicado (puede sobreescribirse)

  // Automóviles: tope MOI deducible (Art. 36-II). Pickups de carga: esAutomovil=false.
  esAutomovil        Boolean @default(false)
  esElectricoHibrido Boolean @default(false)

  // Baja / enajenación
  fechaBaja  DateTime?
  motivoBaja String?

  // True cuando lo creó el sync automáticamente desde un CFDI INVERSION (vs alta
  // manual). El contador debe revisar tipo/tasa/tope — sobre todo transporte
  // (auto de pasajeros con tope vs camioneta de carga sin tope).
  autoCreado Boolean @default(false)

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([invoiceId])
}

// One <pago:DoctoRelacionado> line on a complemento de pago (REP). Links a
// PAGO Invoice to the UUID of a parent invoice it pays. Stored for both
// emitidos and recibidos so we can tell, accurately, whether a PPD invoice's
// payment has been complementado (vs. a fragile RFC+amount heuristic).
model PagoDoctoRelacionado {
  id               String @id @default(cuid())
  pagoInvoiceId    String // the tipo=PAGO Invoice that carries this node
  parentUuid       String // UUID of the invoice being paid (IdDocumento)
  impPagado        Float?
  numParcialidad   Int?
  impSaldoAnterior Float?
  impSaldoInsoluto Float?

  // FechaPago of the parent <pago:Pago> node — the legal date of the payment,
  // which the SAT uses to attribute IVA to a period (not the REP's emission
  // date). Present in both complemento 1.0 and 2.0.
  fechaPago DateTime?

  // Per-docto IVA breakdown. Complemento de Pago 2.0 carries ImpuestosDR/
  // TrasladoDR (firm, payment-level IVA); 1.0 does not. When the XML lacks the
  // breakdown (legacy 1.0, or 2.0 ObjetoImpDR "03"), these are null and
  // ivaDerivado is set so the tax engine prorates the parent invoice's IVA
  // instead of reading a firm value.
  baseTraslado  Float?
  ivaTrasladado Float?
  ivaDerivado   Boolean @default(false)

  pagoInvoice Invoice @relation(fields: [pagoInvoiceId], references: [id], onDelete: Cascade)

  @@unique([pagoInvoiceId, parentUuid])
  @@index([parentUuid])
  @@index([fechaPago])
}

// Tracks the last IVA trasladado we baselined/notified per (company, period),
// so the post-sync job can detect when a newly imported REP moves an unfiled
// period's IVA and avoid re-notifying about an unchanged figure.
model IvaPeriodNotice {
  id             String    @id @default(cuid())
  companyId      String
  periodo        String // "YYYY-MM"
  ivaTrasladado  Float // value at last baseline/notification
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, periodo])
}

model InvoiceItem {
  id            String  @id @default(cuid())
  invoiceId     String
  cantidad      Float
  claveUnidad   String // SAT catalog key e.g. "E48"
  unidad        String?
  claveProdServ String // SAT product/service catalog key
  descripcion   String
  valorUnitario Float
  importe       Float
  descuento     Float   @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceTax {
  id        String    @id @default(cuid())
  invoiceId String
  tipo      TaxType // IVA, ISR, IEPS
  factor    TaxFactor // TASA, CUOTA, EXENTO
  tasa      Float
  // Base del impuesto (atributo Base del nodo Traslado a nivel comprobante).
  // Para filas EXENTO es el valor de los actos exentos — el insumo de la
  // proporción de acreditamiento (Art. 5 LIVA). Null en filas legacy/retención.
  base      Float?
  importe   Float
  retencion Boolean   @default(false)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum InvoiceType {
  INGRESO
  EGRESO
  TRASLADO
  NOMINA
  PAGO
}

enum InvoiceStatus {
  DRAFT
  STAMPED // timbrado
  CANCELLED
}

enum TaxType {
  IVA
  ISR
  IEPS
}

enum TaxFactor {
  TASA
  CUOTA
  EXENTO
}

// ─── Module 4: Bank Reconciliation ───────────────────────────────────────────

model BankAccount {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  banco        String // e.g. "BBVA", "Banamex", "Santander"
  nombre       String // friendly name
  numeroCuenta String
  clabe        String?
  moneda       String  @default("MXN")

  // CHEQUES = main operating account; TARJETA_DEPARTAMENTAL = debit card
  // handed to a specific person (GDCS, Esteban…) whose CSV gets imported
  // separately; CAJA = petty cash fund held by a field PM (Rosy's $5k caja chica).
  tipo    BankAccountTipo @default(CHEQUES)
  titular String? // free-text cardholder / account owner name

  // Belvo / open banking
  belvoAccountId String?
  belvoLinkId    String?

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions  BankTransaction[]
  gastos        Gasto[]
  reembolsos    ReembolsoSemanal[]
  importBatches ImportBatch[]

  @@unique([companyId, numeroCuenta])
}

enum BankAccountTipo {
  CHEQUES
  TARJETA_DEPARTAMENTAL
  CAJA
}

model BankTransaction {
  id            String   @id @default(cuid())
  companyId     String
  bankAccountId String
  createdAt     DateTime @default(now())

  fecha       DateTime
  descripcion String
  referencia  String?
  monto       Float // positive = credit, negative = debit
  saldo       Float?
  tipo        BankTransactionType

  // Reconciliation
  status           ReconciliationStatus @default(UNMATCHED)
  invoiceId        String?
  supplierId       String?
  notes            String?
  // Conciliación de pagos de impuestos: el movimiento (egreso) que pagó una
  // línea de captura SIPARE o de una declaración federal. v1: un movimiento
  // paga UNA declaración y viceversa (el segundo intento se rechaza con 409).
  taxDeclarationId String?

  // Source
  source        String  @default("UPLOAD") // UPLOAD or BELVO or PADEL
  belvoId       String? @unique // Belvo transaction ID (for dedup)
  belvoCategory String? // Belvo auto-category (e.g. "Bills & Utilities")
  externalRef   String? @unique // idempotency key for external app ingest (e.g. PADEL payment id)
  // Lote de importación (estado de cuenta) al que pertenece — habilita el
  // "deshacer última importación": borrar exactamente ese lote sin tocar el resto.
  importBatchId String?

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount           BankAccount            @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  importBatch           ImportBatch?           @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  supplier              Supplier?              @relation(fields: [supplierId], references: [id])
  invoice               Invoice?               @relation(fields: [invoiceId], references: [id])
  taxDeclaration        TaxDeclaration?        @relation(fields: [taxDeclarationId], references: [id])
  rayaPagada            RayaSemanal?
  gastoPagado           Gasto?
  reembolsoPagado       ReembolsoSemanal?
  solicitudCompraPagada SolicitudCompra?
  adjudicacionPagada    SolicitudAdjudicacion? @relation("AdjudicacionPago")
  estimacionCobrada     Estimacion?
  reservacionCobrada    Reservation?
  compraRestPagada      RestCompra?
  ordenRestCobrada      RestOrden?
  // Conciliación uno-a-varios: asignaciones por factura (ver ConciliacionDetalle).
  conciliacionDetalles  ConciliacionDetalle[]

  // Devolución bancaria (pago rebotado): el movimiento de DEVOLUCIÓN apunta al
  // pago ORIGINAL. Emparejados, ambos quedan IGNORED —se netean: no son ingreso
  // ni gasto ni evidencia de pago— pero el vínculo conserva la historia (a
  // diferencia de un "Ignorado" suelto) y al vincular se deshace la
  // conciliación del original (la factura vuelve a no-pagada). @unique: un
  // original tiene a lo más UNA devolución.
  devolucionDeId String?          @unique
  devolucionDe   BankTransaction? @relation("DevolucionPago", fields: [devolucionDeId], references: [id], onDelete: SetNull)
  devolucionPor  BankTransaction? @relation("DevolucionPago")

  // Conciliación: los flujos calientes filtran por cuenta + status
  // (auto-conciliar UNMATCHED, groupBy de status en /api/bancos).
  @@index([bankAccountId, status])
  // Consultas por empresa con rango de fechas (reportes/listados) y el
  // conteo de pendientes por empresa (cockpit de despacho usa el prefijo).
  @@index([companyId, fecha])
  // Conciliación de impuestos: «¿qué movimiento pagó esta declaración?»
  // (guard de segundo movimiento y detalle en la respuesta del PATCH).
  @@index([taxDeclarationId])
  // "Deshacer última importación": último lote por empresa/cuenta y borrado del lote.
  @@index([importBatchId])
}

// Lote de importación de estado de cuenta — agrupa los movimientos que entraron
// juntos (una subida) para poder DESHACER exactamente ese lote. Se conserva la
// fila aunque se deshaga (auditoría: undoneAt), pero sus movimientos se borran.
model ImportBatch {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  companyId      String
  bankAccountId  String
  source         String // WHATSAPP | UPLOAD | …
  banco          String?
  periodo        String?
  count          Int       @default(0) // movimientos importados en este lote
  undoneAt       DateTime?
  undoneByUserId String?

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount  BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@index([companyId, createdAt])
  @@index([bankAccountId])
}

// Regla de categorización de conceptos bancarios SIN CFDI, persistida por
// empresa. Nace cuando el usuario categoriza un movimiento recurrente sin CFDI
// (Rappi, OpenAI, restaurantes, …) y pide "categorizar todos los similares":
// se recuerda el patrón + la familia elegida y se re-aplica automáticamente al
// importar nuevos estados de cuenta y en el escaneo retroactivo de movimientos
// existentes. Las reglas del usuario GANAN sobre el motor de reglas hardcodeado
// (ver sugerirCategoriaConcepto). La `familia` reutiliza las MISMAS etiquetas
// que lee el cierre mensual (postMonth) desde BankTransaction.notes.
model CategorizationRule {
  id        String   @id @default(cuid())
  companyId String
  // Token/patrón a buscar dentro de la descripción del movimiento (case- e
  // insensible a acentos; la comparación vive en el matcher puro).
  pattern   String
  // CONTAINS (default) | EXACT | STARTS_WITH — cómo se compara el patrón.
  matchType String   @default("CONTAINS")
  // Familia contable (valor de FamiliaConcepto): COMISION, TAX_PAYMENT,
  // PAYROLL_NO_CFDI, INTERNAL_TRANSFER, FINANCIAL_INCOME, RENT, NON_DEDUCTIBLE.
  familia   String
  // Restringe la regla a un signo del movimiento (CREDITO/DEBITO). Null = ambos.
  signo     String?
  activo    Boolean  @default(true)
  // Procedencia: USER (confirmada por el usuario, se auto-aplica al importar) o
  // SYSTEM/SUGGESTED (semilla, no se auto-aplica sin confirmación).
  origen    String   @default("USER")
  // Cuántas veces esta regla ha etiquetado un movimiento (telemetría de utilidad).
  hitCount  Int      @default(0)
  createdBy String? // email o id del usuario que la creó
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, activo])
}

enum BankTransactionType {
  CREDITO
  DEBITO
}

enum ReconciliationStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

// Conciliación uno-a-varios: un movimiento bancario (p. ej. una transferencia
// que paga varias facturas mensuales de un cliente) se reparte entre varias
// facturas con un monto asignado por factura. El vínculo legado 1:1
// (BankTransaction.invoiceId) sigue vigente para los matches sencillos; los
// matches múltiples dejan invoiceId en NULL y viven aquí. Aditivo: prod usa
// `prisma db push`, nada existente cambia.
model ConciliacionDetalle {
  id                String   @id @default(cuid())
  bankTransactionId String
  invoiceId         String
  montoAsignado     Float // porción (valor absoluto) del movimiento asignada a esta factura
  createdAt         DateTime @default(now())

  bankTransaction BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  invoice         Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Un movimiento no asigna dos veces a la misma factura.
  @@unique([bankTransactionId, invoiceId])
  // Acumulado de cobros por factura (guard PUE/PPD, complementos, candidatos).
  @@index([invoiceId])
}

// ─── Module 2: Nómina & IMSS ──────────────────────────────────────────────────

model Employee {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nombre          String
  apellidoPaterno String
  apellidoMaterno String?
  rfc             String
  curp            String
  nss             String // Número de Seguridad Social
  // CP del domicilio FISCAL del empleado (su CSF). CFDI 4.0 valida que el
  // DomicilioFiscalReceptor del recibo de nómina coincida con el registrado en
  // el SAT para su RFC — el CP de la empresa NO pasa esa validación. Null =
  // fallback al CP de la empresa (comportamiento previo).
  codigoPostal    String?
  email           String?
  fechaIngreso    DateTime
  fechaBaja       DateTime?
  isActive        Boolean   @default(true)

  // Contract
  tipoContrato           String // e.g. "01" = Indefinido
  tipoJornada            String // e.g. "01" = Diurna
  tipoRegimen            String  @default("02") // "02" = Sueldos, "05" = Asimilados
  salarioDiario          Float // SBC for IMSS
  salarioDiarioIntegrado Float? // SDI
  periodicidadPago       String // "04" = Quincenal, "05" = Mensual
  numEmpleado            String? // Internal employee number; defaults to short id
  departamento           String?
  puesto                 String?
  riesgoPuesto           String  @default("1") // 1=Class I, 2=II, 3=III, 4=IV, 5=V
  claveEntFed            String  @default("PUE") // Estado SAT code (PUE, JAL, CMX, etc.)

  // Datos bancarios para dispersión SPEI (opcionales — empleados existentes no los tienen)
  clabe String? // CLABE interbancaria de 18 dígitos
  banco String? // Nombre del banco

  // INFONAVIT
  creditoInfonavit       String?
  tipoDescuentoInfonavit String? // "PCT_SBC" | "VSM" | "PESOS"
  descuentoInfonavit     Float?

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollItems      PayrollItem[]
  imssMovimientos   ImssMovimiento[]
  incidencias       Incidencia[]
  cuadrillaMiembros CuadrillaMiembro[]

  @@unique([companyId, rfc])
}

// Incidencias — absences, overtime, sick leave, permits that affect payroll
model Incidencia {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  createdAt  DateTime @default(now())

  tipo         IncidenciaTipo
  fecha        DateTime // Date of the incident
  fechaFin     DateTime? // End date for multi-day (incapacidad, vacaciones)
  dias         Float          @default(1) // Number of days affected
  horas        Float? // For overtime: DOUBLE hours (dentro/fuera del límite LFT las separa el cálculo)
  // Horas extra TRIPLES (las que exceden el límite de la jornada extraordinaria,
  // LFT Art. 68: se pagan al 200% adicional y son 100% gravadas). Columna
  // ADITIVA — prod usa `prisma db push`.
  horasTriples Float?
  // Monto en pesos para incidencias económicas (BONO, COMISION, DESCUENTO).
  // Columna ADITIVA — prod usa `prisma db push`.
  monto        Float?

  // Incapacidad-specific
  folioImss String? // IMSS disability folio number
  ramoImss  String? // "01"=Riesgo trabajo, "02"=Enfermedad, "03"=Maternidad

  notas   String?
  periodo String? // e.g. "2026-04" — linked to payroll period

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId, periodo])
  @@index([employeeId, fecha])
}

enum IncidenciaTipo {
  FALTA // Absence (unjustified)
  FALTA_JUSTIFICADA // Justified absence
  INCAPACIDAD // IMSS disability leave
  PERMISO_CON_GOCE // Paid leave
  PERMISO_SIN_GOCE // Unpaid leave
  HORAS_EXTRA // Overtime
  VACACIONES // Vacation days taken
  RETARDO // Late arrival
  // Valores ADITIVOS (prod usa `prisma db push`) — incidencias económicas del
  // periodo que alimentan el cálculo de la corrida:
  BONO // Bono / gratificación / destajo — 100% gravado (Arts. 94 y 96 LISR)
  COMISION // Comisiones — 100% gravadas (Arts. 94 y 96 LISR)
  DESCUENTO // Descuento neto post-impuestos (préstamos, uniformes, etc.)
}

// IMSS Movimientos Afiliatorios — auto-detected from employee changes
model ImssMovimiento {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  createdAt  DateTime @default(now())

  tipo            ImssMovimientoTipo // ALTA, BAJA, MODIFICACION_SALARIO, REINGRESO
  fechaMovimiento DateTime // When the movement should be effective
  sbcAnterior     Float? // Previous SBC (for modifications)
  sbcNuevo        Float? // New SBC
  motivo          String? // Reason text

  // Filing status
  status           ImssMovimientoStatus @default(PENDING)
  filedAt          DateTime? // When it was filed with IMSS
  idseConfirmation String? // IDSE confirmation number

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId, status])
}

enum ImssMovimientoTipo {
  ALTA
  BAJA
  MODIFICACION_SALARIO
  REINGRESO
}

enum ImssMovimientoStatus {
  PENDING // Needs to be filed
  EXPORTED // Included in an IDSE export
  FILED // Filed with IMSS
  REJECTED // IMSS rejected it
}

model PayrollRun {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  periodo   String // e.g. "2024-01-01/2024-01-15"
  fechaPago DateTime
  tipo      PayrollRunType // ORDINARIA, EXTRAORDINARIA, FINIQUITO, AGUINALDO
  status    PayrollStatus  @default(DRAFT)

  totalPercepciones Float @default(0)
  totalDeducciones  Float @default(0)
  totalNeto         Float @default(0)

  // Type-specific data (e.g. { utilidadFiscalGravable } for PTU,
  // { diasAguinaldo, fechaCorte } for AGUINALDO)
  extraData Json?

  // Procedencia de la corrida. "APP" = creada y calculada en la app (flujo
  // normal). "SAT" = reconstruida desde los CFDIs de nómina ya timbrados que
  // trajo la sincronización con el SAT (histórico de sólo lectura: no se
  // re-timbra ni se dispersa). Columna ADITIVA — prod usa `prisma db push`.
  origen String @default("APP")

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   PayrollItem[]
}

model PayrollItem {
  id           String @id @default(cuid())
  payrollRunId String
  employeeId   String

  // Percepciones
  sueldoBase        Float
  horasExtra        Float @default(0)
  bonosPagoFijo     Float @default(0)
  bonosPagoVar      Float @default(0)
  vales             Float @default(0)
  otrasPercepciones Float @default(0)

  // Deducciones
  isrRetenido  Float @default(0)
  imssObrero   Float @default(0)
  imssPatronal Float @default(0) // Informational (employer cost, not deducted from employee)
  infonavit    Float @default(0)
  otrasDeducc  Float @default(0)

  // Extraordinary percepciones (aguinaldo, vacaciones, PTU)
  aguinaldo       Float @default(0)
  primaVacacional Float @default(0)
  vacaciones      Float @default(0)
  ptu             Float @default(0)

  totalPercepciones Float
  totalDeducciones  Float
  netoAPagar        Float

  // CFDI nómina
  cfdiUuid    String?
  facturapiId String?

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])
}

// Cadencia con la que la empresa paga (y timbra) su nómina ordinaria.
// SEMANAL = paga viernes (recordatorio el jueves). QUINCENAL = paga el 15 y
// el último día del mes (recordatorio el 14 y la víspera del fin de mes).
// MENSUAL = paga el último día del mes (recordatorio la víspera).
enum PeriodicidadNomina {
  SEMANAL
  QUINCENAL
  MENSUAL
}

enum PayrollRunType {
  ORDINARIA
  EXTRAORDINARIA
  FINIQUITO
  AGUINALDO
  VACACIONES
  PTU
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  STAMPED
  PAID
}

// ─── Module 1: Tax Declarations ───────────────────────────────────────────────

// Tax declarations. Created organically when the app computes a period,
// or bulk-imported as historical baseline (isHistorical=true) during
// onboarding via the AI wizard so contadores starting mid-year don't lose
// the carryover of IVA saldos a favor and ISR provisional pagado.
model TaxDeclaration {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tipo    TaxDeclarationType // IVA_MENSUAL, ISR_PROVISIONAL, DIOT, ANUAL
  periodo String // e.g. "2024-01" or "2024"
  status  DeclarationStatus  @default(DRAFT)

  // IVA
  ivaTrasladadoCobrado  Float?
  ivaAcreditableGastado Float?
  ivaSaldoFavor         Float?
  ivaPagar              Float?
  ivaSaldoFavorAnterior Float? // Carryover from previous months

  // ISR
  isrIngresos            Float?
  isrDeducciones         Float?
  isrBaseGravable        Float?
  isrTasa                Float?
  isrPagar               Float?
  isrCoeficienteUtilidad Float? // Coeficiente asignado por el SAT del ejercicio anterior
  // DECLARACION_ANUAL: remanente de pérdidas fiscales de ejercicios anteriores
  // pendiente de aplicar a ejercicios FUTUROS (actualizado), extraído del acuse.
  // Lo amortiza el pago provisional de PM (Art. 14) como respaldo del valor
  // manual de la empresa — ver computeTaxPosition.
  isrPerdidaPendiente    Float?
  // Saldo a favor de ISR generado en el periodo (RESICO PF: retención 1.25% de
  // PM, Art. 113-J, que excedió el ISR definitivo del mes). Se arrastra al
  // periodo siguiente dentro del mismo ejercicio — el excedente de diciembre se
  // recupera en la anual (Art. 113-F), no contra enero.
  isrSaldoFavor          Float?

  // Retenciones (enteramiento de ISR retenido a terceros — p.ej. nómina). Es un
  // impuesto del trabajador que el patrón sólo retiene y entera (Art. 96 LISR);
  // NO se acredita contra el ISR provisional propio de la empresa, por eso vive
  // en su propio renglón con tipo RETENCIONES_ISR.
  retencionesIsr Float? // ISR retenido a enterar en el periodo

  // Cuotas IMSS (SIPARE) — monto pagado/por pagar del periodo. En filas
  // IMSS_MENSUAL: cuotas obrero-patronales del mes; en IMSS_BIMESTRAL: RCV +
  // Infonavit del bimestre. Se precarga con el estimado desde la nómina
  // timbrada y el usuario lo ajusta a la cifra exacta del SUA al registrar.
  imssCuotas Float?

  // DIOT
  diotXmlUrl String?

  // Presentación
  acuseUrl          String?
  lineaCaptura      String?
  fechaPresentacion DateTime?
  fechaLimitePago   DateTime?

  // Acuse PDF guardado completo. POR AHORA en la BD (bytea) — los acuses son
  // chicos (~100-200KB). TODO: migrar a object storage (Cloudflare R2) y dejar
  // sólo la URL; ver docs/HANDOFF.md. Reemplaza la captura manual de línea de
  // captura/monto: subes el PDF, se parsea y se conserva el original.
  acusePdf       Bytes?
  acusePdfNombre String?

  // True when the declaration was imported as a historical baseline during
  // onboarding (from a SAT acuse PDF). These rows are treated normally by
  // the carryover logic (saldo a favor, ISR pagado anterior) but are
  // visually marked in the UI and excluded from "periodos pendientes de
  // cierre" lists.
  isHistorical Boolean @default(false)

  // SAT acuse capture (cierre mensual). When the user uploads the acuse PDF at
  // filing time we extract the filed figures and store them here alongside a
  // snapshot of what the app computed + the flagged diffs. The filed values are
  // authoritative (they drive carry-forward: ivaSaldoFavor, isrCoeficienteUtilidad);
  // the snapshot/diffs keep a filing mistake visible (e.g. needing a complementaria).
  // Shape: { extractedAt, tipoImpuesto, tipoPago, filed:{…}, computed:{…}, diffs:[…] }
  acuseData Json?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Conciliación bancaria del pago (SIPARE/línea de captura). En la práctica
  // v1 es 0 o 1 movimiento MATCHED (un segundo intento se rechaza con 409);
  // la lista existe porque la FK vive del lado del movimiento.
  bankTransactions BankTransaction[]
}

// Pérdida fiscal pendiente de amortizar (Art. 57 LISR). Una por ejercicio de
// origen y empresa. El saldo se guarda YA ACTUALIZADO por INPC hasta
// `mesUltimaActualizacion`; la declaración anual la actualiza a junio y la aplica
// FIFO contra la utilidad. Expira 10 ejercicios después del origen.
model PerdidaFiscal {
  id                      String   @id @default(cuid())
  companyId               String
  ejercicioOrigen         Int // año en que se generó la pérdida
  montoOriginal           Float // pérdida nominal del ejercicio
  // Saldo pendiente de amortizar, actualizado hasta `mesUltimaActualizacion`.
  saldoActualizado        Float
  mesUltimaActualizacion  String // "YYYY-MM"
  agotada                 Boolean  @default(false)
  // Último ejercicio en que se aplicó (idempotencia del guardado de la anual).
  ultimoEjercicioAplicado Int?
  // "CALCULADA" (generada por la anual) | "IMPORTADA" (acuse/captura inicial).
  origen                  String   @default("CALCULADA")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, ejercicioOrigen])
  @@index([companyId])
}

// Costo-por-servir (unit economics). Un evento por operación que cuesta dinero:
// llamada LLM (tokens) o extracción Syntage. Costo en MICRO-USD (entero); la
// conversión a MXN se hace al mostrar con el FIX. companyId/despachoId nullables
// y onDelete:SetNull para que el histórico de costo sobreviva a la baja de una
// empresa. La rentabilidad por despacho se obtiene uniendo por companyId.
model CostEvent {
  id            String   @id @default(cuid())
  despachoId    String?
  companyId     String?
  categoria     String // "LLM" | "SYNTAGE"
  subtipo       String // "llm.parse_acuse" | "syntage.extraction.tax_status" | …
  unidades      Float // tokens (LLM) o conteo (extracciones)
  costoMicroUsd Int // costo estimado en micro-USD (USD × 1e6)
  meta          Json?
  occurredAt    DateTime @default(now())
  createdAt     DateTime @default(now())

  company  Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  despacho Despacho? @relation(fields: [despachoId], references: [id], onDelete: SetNull)

  @@index([companyId, occurredAt])
  @@index([despachoId, occurredAt])
  @@index([occurredAt])
}

// Envíos de Contabilidad Electrónica (COE) por periodo. Guarda el hash del
// contenido para decidir automáticamente N (normal) vs C (complementaria): si la
// balanza cambia respecto al último envío, el siguiente es complementaria y lleva
// FechaModBal. Un registro por (empresa, tipoDoc, periodo).
model CoeEnvio {
  id            String   @id @default(cuid())
  companyId     String
  tipoDoc       String // "BALANZA" | "CATALOGO"
  periodo       String // "YYYY-MM" (o "YYYY-13" para el cierre)
  contenidoHash String
  tipoEnvio     String // "N" | "C"
  fechaModBal   String? // "YYYY-MM-DD" cuando tipoEnvio = "C"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, tipoDoc, periodo])
  @@index([companyId])
}

// Tracks which fiscal obligations each company has (derived from régimen or parsed from CSF)
model CompanyObligation {
  id             String  @id @default(cuid())
  companyId      String
  tipo           String // "IVA_MENSUAL" | "ISR_PROVISIONAL" | "DIOT" | "ISR_ANUAL" | etc.
  descripcion    String
  periodicidad   String // "MENSUAL" | "BIMESTRAL" | "ANUAL"
  diaVencimiento Int // day of month due (17 for most, 31 for ISR anual PM, 30 for PF)
  mesVencimiento Int? // for ANUAL: 3 = March (PM), 4 = April (PF)
  activa         Boolean @default(true)
  fuente         String  @default("REGIMEN") // "REGIMEN" | "CSF"
  desdeAnio      Int?
  desdeMes       Int?

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, tipo])
}

// Resultado del cotejo automático de un dataset fiscal versionado (INPC, …)
// contra su fuente oficial (INEGI). Lo escribe el cron /api/cron/cotejo-fiscal;
// lo lee la cobertura para subir "sin cotejar" → "al día" cuando los valores
// cargados empatan con la fuente. Una fila por dataset.
model CotejoFiscal {
  id              String    @id @default(cuid())
  dataset         String    @unique // "INPC"
  verificado      Boolean   @default(false)
  verifiedThrough String? // último periodo cotejado, "YYYY-MM"
  matchedAt       DateTime?
  mismatch        Json? // discrepancias detectadas (si las hay)
  fuente          String? // p.ej. "INEGI BIE"
  updatedAt       DateTime  @updatedAt
}

enum TaxDeclarationType {
  IVA_MENSUAL
  ISR_PROVISIONAL
  RETENCIONES_ISR
  DIOT
  DECLARACION_ANUAL
  CERO
  // Cuotas obrero-patronales IMSS (SIPARE) — mensuales (LSS Art. 39, día 17 del
  // mes siguiente) y RCV + Infonavit bimestrales (día 17 del mes siguiente al
  // cierre del bimestre). El periodo bimestral se guarda con el mes que CIERRA
  // el bimestre ("2026-02" = ene-feb).
  IMSS_MENSUAL
  IMSS_BIMESTRAL
}

enum DeclarationStatus {
  DRAFT
  CALCULATED
  FILED
  PAID
}

// ─── Module 5: Chart of Accounts / COE ────────────────────────────────────────

model ChartAccount {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())

  // SAT COE catalog
  cuentaSAT  String // e.g. "101"
  subcuenta  String? // e.g. "101.01"
  nombre     String
  tipo       AccountType // ACTIVO, PASIVO, CAPITAL, INGRESO, GASTO, COSTO
  nivel      Int         @default(1)
  // Naturaleza COE: "D" (deudora) | "A" (acreedora). Null = derivar del tipo.
  // Explícita para contra-cuentas (p.ej. depreciación acumulada = "A" en ACTIVO).
  naturaleza String?
  isActive   Boolean     @default(true)

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries AccountingEntry[]

  @@unique([companyId, cuentaSAT, subcuenta])
}

model AccountingEntry {
  id             String   @id @default(cuid())
  companyId      String
  chartAccountId String
  createdAt      DateTime @default(now())

  fecha          DateTime
  // Posting period (year + month) — denormalized so we can filter/delete
  // entire periods efficiently without a range query over fecha.
  year           Int
  month          Int // 1-12
  periodId       String? // FK to AccountingPeriod row
  descripcion    String
  referencia     String? // e.g. UUID del CFDI, ESTIMACION id, etc.
  referenciaTipo String? // "CFDI" | "ESTIMACION" | "SOLICITUD_COMPRA" | "BANK_TX" | etc.
  monto          Float
  tipo           EntryType // CARGO, ABONO
  fuente         EntrySource // CFDI, NOMINA, BANCO, MANUAL, CONSTRUCCION, FLOTA

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chartAccount ChartAccount      @relation(fields: [chartAccountId], references: [id])
  period       AccountingPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@index([companyId, year, month])
}

// Tracks which fiscal months have been posted to the general ledger.
// Monthly posting is a manual step: user clicks "Cerrar mes" → posting
// engine scans all CFDIs and bank txs with fecha in [monthStart, monthEnd]
// and writes the corresponding AccountingEntry rows.
model AccountingPeriod {
  id           String                 @id @default(cuid())
  companyId    String
  year         Int
  month        Int // 1-12
  status       AccountingPeriodStatus @default(DRAFT)
  postedAt     DateTime?
  postedById   String?
  // Summary counts so the UI can show period health at a glance
  entriesCount Int                    @default(0)
  totalCargos  Float                  @default(0)
  totalAbonos  Float                  @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries AccountingEntry[]

  @@unique([companyId, year, month])
}

enum AccountingPeriodStatus {
  DRAFT // No entries yet (month hasn't been closed)
  POSTED // Entries generated — can still be deleted and re-posted
  CLOSED // Officially closed — no more edits (for audit)
}

// ─────────────────────────────────────────────────────────────────────────────
// SAT Descarga Masiva — request lifecycle tracking
//
// Each "Sincronizar con SAT" click creates two SatSyncRequest rows (emitidos
// + recibidos). We persist them so we can:
//   1. Reuse pending requests instead of creating new ones (SAT limits N
//      concurrent requests per RFC — error code 5002 when exceeded)
//   2. Resume polling across page reloads
//   3. Show the user the request history per period
// ─────────────────────────────────────────────────────────────────────────────
model SatSyncRequest {
  id             String           @id @default(cuid())
  companyId      String
  tipo           SatRequestType
  year           Int
  month          Int
  requestId      String           @unique // SAT's RequestID
  status         SatRequestStatus @default(PENDING)
  cfdisFound     Int              @default(0)
  imported       Int              @default(0)
  lastVerifiedAt DateTime?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, year, month, tipo])
}

enum SatRequestType {
  EMITIDOS
  RECIBIDOS
  // Consultas de METADATA (no XML) para detectar CFDIs cancelados en el SAT.
  METADATA_EMITIDOS
  METADATA_RECIBIDOS
}

enum SatRequestStatus {
  PENDING // Just submitted, SAT hasn't acknowledged yet
  ACCEPTED // SAT accepted the request, queued for processing
  IN_PROGRESS // SAT is preparing the package
  FINISHED // Packages ready (or empty)
  FAILED // SAT rejected or our parsing failed
  EXPIRED // SAT removed the request (>72h typically)
}

enum AccountType {
  ACTIVO
  PASIVO
  CAPITAL
  INGRESO
  GASTO
  COSTO
}

enum EntryType {
  CARGO
  ABONO
}

enum EntrySource {
  CFDI
  NOMINA
  BANCO
  MANUAL
  CONSTRUCCION
  FLOTA
  PADEL
  RESTAURANTE
  APERTURA // saldos iniciales / asiento de apertura (no se borra al re-postear el mes)
  CIERRE // asiento de cierre anual (mes 13) — cancela ingresos/costos/gastos a resultado
}

// ─── Module 6: Construction Project Management ───────────────────────────────
// Gated behind CompanyModule(modulo = CONSTRUCCION). Tables exist for every
// company but are only populated and exposed in the UI when the module is on.

model Proyecto {
  id         String   @id @default(cuid())
  companyId  String
  customerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  codigo      String
  nombre      String
  descripcion String?
  ubicacion   String?
  tipo        ProyectoTipo   @default(PRIVADO)
  estado      ProyectoEstado @default(PLANEACION)

  // Government contract metadata
  numeroContrato     String?
  numeroLicitacion   String?
  modalidadContrato  String? // "OBRA_PUBLICA" | "ADJUDICACION_DIRECTA" | "INVITACION"
  dependenciaCliente String?

  fechaInicio     DateTime?
  fechaFinPlan    DateTime?
  fechaFinReal    DateTime?
  montoContratado Float?
  anticipoPorc    Float? // typical 30
  retencionPorc   Float? // typical 5

  // Decolsa workflow: el contrato con el cliente es costo directo + utilidad
  // (típicamente 10% en vivienda — sector sin IVA). Se aplica sobre la suma
  // de leaves del Presupuesto. Si null, no se aplica utilidad sobre direct.
  utilidadPorc Float? @default(10)

  // Vivienda en sector privado no causa IVA. Para otros proyectos (gobierno,
  // remodelación comercial) sí. Default true para no romper el flujo
  // existente; Decolsa lo apaga al crear sus proyectos.
  aplicaIva Boolean @default(true)

  // Track the source spreadsheet so we can audit / re-import. The file
  // itself is stored elsewhere (S3 / Railway volume) — we just keep a
  // pointer + an "imported at" timestamp so the UI can tell Gerardo whether
  // the project's master Presupuesto was loaded from Excel and when.
  presupuestoSourceFile  String?
  presupuestoImportadoAt DateTime?

  // Estimación / vivienda tracking (Decolsa workflow).
  //   viviendasObjetivo = denominador para % avance por partida
  //                       (48 = 2 torres × 24 deptos en Torres Platino).
  //   weekCount         = semanas del programa físico financiero (default
  //                       calculado de fechaInicio..fechaFinPlan).
  // Ambos editables después del import.
  viviendasObjetivo Int?
  weekCount         Int?

  // Anticipo tracking — filled when the customer pays the anticipo
  anticipoMonto      Float? // actual $ received (montoContratado × anticipoPorc / 100)
  anticipoFecha      DateTime? // date received
  anticipoAmortizado Float     @default(0) // running total amortized across estimaciones
  anticipoBankTxId   String? // link to the BankTransaction that recorded the deposit
  anticipoInvoiceId  String? // link to the CFDI de anticipo (Invoice)

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id])
  presupuestos       Presupuesto[]
  estimaciones       Estimacion[]
  estimacionTemplate EstimacionTemplate?
  programa           ProgramaActividad[]
  solicitudesCompra  SolicitudCompra[]
  bitacora           BitacoraEntrada[]
  pagos              Pago[]
  unidades           UnidadProyecto[]
  cuadrillas         Cuadrilla[]
  rayas              RayaSemanal[]
  gastos             Gasto[]
  reembolsos         ReembolsoSemanal[]

  @@unique([companyId, codigo])
  @@index([companyId, estado])
}

enum ProyectoTipo {
  GOBIERNO
  PRIVADO
  MIXTO
}

enum ProyectoEstado {
  PLANEACION
  EN_EJECUCION
  SUSPENDIDO
  TERMINADO
  CANCELADO
}

// Catálogo de conceptos: master list per company. Each concepto is the
// header of an APU and is reusable across projects.
model Concepto {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  codigo      String
  descripcion String
  unidad      String // "m3", "m2", "ton", "pza"
  categoria   String? // "Preliminares" | "Cimentación" | etc.

  // Pointer to the current/active APU version. Versioning lives on APU.
  apuActualId String? @unique
  apuActual   APU?    @relation("ConceptoApuActual", fields: [apuActualId], references: [id])

  apus         APU[]                @relation("ConceptoApus")
  partidas     PresupuestoPartida[]
  usedAsSubAPU APUInsumo[]          @relation("SubAPU") // where this concepto is referenced as a sub-APU
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, codigo])
}

// Análisis de Precios Unitarios: canonical cost breakdown for one Concepto.
// Versioned: each material edit creates a new APU; conceptos point to current.
model APU {
  id         String   @id @default(cuid())
  companyId  String
  conceptoId String
  createdAt  DateTime @default(now())
  version    Int      @default(1)

  // Roll-up totals (computed from APUInsumo at write time, validated server-side)
  costoDirecto    Float // sum of all insumos
  indirectosPorc  Float @default(0)
  financierosPorc Float @default(0)
  utilidadPorc    Float @default(0)
  cargosAdicPorc  Float @default(0)
  precioUnitario  Float // final PU after all overhead
  rendimiento     Float @default(1) // qty produced per cuadrilla-day

  concepto           Concepto    @relation("ConceptoApus", fields: [conceptoId], references: [id], onDelete: Cascade)
  conceptoComoActual Concepto?   @relation("ConceptoApuActual")
  insumos            APUInsumo[]
  company            Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([conceptoId, version])
}

// Each line of an APU: a material, labor category, equipment, or basic.
// Each line of an APU references EITHER a raw Insumo (material, labor,
// equipment) OR another Concepto (sub-APU / concepto compuesto).
// Exactly one of insumoId or conceptoRefId must be set.
//
// When conceptoRefId is set:
//   - costoUnitario = the referenced concepto's apuActual.precioUnitario
//   - importe = cantidad × costoUnitario (same formula)
//   - the referenced concepto acts as a reusable building block
//     (e.g. "Mortero 1:3" used inside "Repellado" and "Aplanado")
//   - when the sub-APU's PU changes, the parent APU must be recomputed
//     (handled by the bulk price update and the recompute function)
model APUInsumo {
  id            String  @id @default(cuid())
  apuId         String
  insumoId      String? // raw insumo reference (mutually exclusive with conceptoRefId)
  conceptoRefId String? // sub-APU reference (mutually exclusive with insumoId)
  cantidad      Float
  costoUnitario Float // snapshot at time of APU build
  importe       Float // = cantidad * costoUnitario
  orden         Int     @default(0)

  apu         APU       @relation(fields: [apuId], references: [id], onDelete: Cascade)
  insumo      Insumo?   @relation(fields: [insumoId], references: [id])
  conceptoRef Concepto? @relation("SubAPU", fields: [conceptoRefId], references: [id])
}

// Master list of inputs: materials, labor categories, equipment, basics.
model Insumo {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  codigo      String
  descripcion String
  tipo        InsumoTipo
  unidad      String
  costoActual Float
  monedaCosto String     @default("MXN")

  // For MANO_OBRA: link to IMSS factor calc inputs
  salarioBase   Float? // daily base (SBC)
  factorSalario Float? // SDR factor including IMSS/INFONAVIT/prestaciones

  // For MATERIAL: SAT product key (carries over to CFDI)
  claveProdServ String?
  claveUnidad   String?

  apuLineas          APUInsumo[]
  partidas           SolicitudPartida[]
  gastos             Gasto[]
  presupuestoInsumos PresupuestoInsumo[]
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, codigo])
}

enum InsumoTipo {
  MATERIAL
  MANO_OBRA
  EQUIPO
  HERRAMIENTA
  BASICO
}

// Presupuesto = a project's catálogo de conceptos with quantities.
model Presupuesto {
  id         String   @id @default(cuid())
  companyId  String
  proyectoId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  nombre String?

  version    Int               @default(1)
  estado     PresupuestoEstado @default(BORRADOR)
  montoTotal Float             @default(0)

  // Contrato vs Ejecutado distinction.
  // CONTRATO = frozen, customer-signed. Revenue basis. Default for all existing rows.
  // EJECUTADO = living document reflecting actual construction reality.
  tipoPresupuesto  TipoPresupuesto @default(CONTRATO)
  // For EJECUTADO only: FK back to the contrato it was cloned from.
  contratoOrigenId String?
  contratoOrigen   Presupuesto?    @relation("ContratoEjecutado", fields: [contratoOrigenId], references: [id])
  ejecutados       Presupuesto[]   @relation("ContratoEjecutado")

  partidas     PresupuestoPartida[]
  estimaciones Estimacion[]
  versiones    PresupuestoVersion[]
  insumos      PresupuestoInsumo[]

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum TipoPresupuesto {
  CONTRATO
  EJECUTADO
}

enum PresupuestoEstado {
  BORRADOR
  APROBADO
  EN_EJECUCION
  CERRADO
  RECHAZADO // customer chose a different presupuesto in the same proyecto
}

// Per-project resource plan imported from the "Explosión de Insumos" sheet.
// One row per insumo, storing the project-total quantity and unit cost snapshot.
// Used as the "planeado" baseline in the Explosión vs Real view when per-concepto
// APU data is not available.
model PresupuestoInsumo {
  id            String @id @default(cuid())
  presupuestoId String
  insumoId      String
  cantidad      Float // project-total quantity from the explosion sheet
  costoUnitario Float // unit price snapshot at import time
  importe       Float // cantidad × costoUnitario

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  insumo      Insumo      @relation(fields: [insumoId], references: [id])

  @@unique([presupuestoId, insumoId])
  @@index([presupuestoId])
  @@map("construccion_presupuesto_insumo")
}

model PresupuestoPartida {
  id             String  @id @default(cuid())
  presupuestoId  String
  // conceptoId is required for LEAF partidas (actual work items) and null
  // for BRANCH partidas (capítulo rollup rows). See esRollup.
  conceptoId     String?
  apuVersion     Int     @default(1) // snapshot of which APU version was used (leaves only)
  cantidad       Float? // leaves only
  precioUnitario Float   @default(0) // leaves only; branches compute from children
  importe        Float   @default(0) // leaves: cantidad × PU; branches: sum of children
  orden          Int     @default(0) // global display order within the presupuesto

  // Legacy flat grouping (kept nullable for backwards read-compat during
  // the tree migration). Superseded by parentPartidaId + codigo.
  zona    String?
  partida String?

  // Internal operational notes — not shown to the customer.
  notas String? @db.Text

  // Capítulo tree (same pattern as ProgramaActividad).
  // Branches are rollup nodes: esRollup=true, conceptoId=null, cantidad=null.
  // Leaves are real work items: esRollup=false, conceptoId set, cantidad set.
  parentPartidaId String?
  parent          PresupuestoPartida?  @relation("PartidaHierarchy", fields: [parentPartidaId], references: [id])
  hijos           PresupuestoPartida[] @relation("PartidaHierarchy")
  nivel           Int                  @default(0) // denormalized depth, 0 = root
  codigo          String? // dotted path "1.1.3.5" — computed on write
  esRollup        Boolean              @default(false)

  // Optional unidad scope — usually null for template partidas; set when a
  // partida is specific to one depto/torre (e.g. "ventana custom Depto 101").
  unidadProyectoId String?
  unidad           UnidadProyecto? @relation(fields: [unidadProyectoId], references: [id])

  // For ejecutado partidas: FK back to the contrato partida they were
  // cloned from. Enables avance tracking to span contrato↔ejecutado.
  contratoPartidaId String?
  contratoPartida   PresupuestoPartida?  @relation("PartidaContratoEjecutado", fields: [contratoPartidaId], references: [id])
  ejecutadoPartidas PresupuestoPartida[] @relation("PartidaContratoEjecutado")

  presupuesto   Presupuesto                 @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  concepto      Concepto?                   @relation(fields: [conceptoId], references: [id])
  avances       EstimacionPartida[]
  templateLinks EstimacionTemplatePartida[]
  compras       SolicitudPartida[]
  bitacora      BitacoraEntrada[]
  rayaTrabajos  RayaTrabajo[]
  gastos        Gasto[]
}

// Estimaciones: government billing flow. Each one becomes a CFDI when timbrada.
model Estimacion {
  id            String   @id @default(cuid())
  companyId     String
  proyectoId    String
  presupuestoId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  numero        Int // 1, 2, 3... per project
  periodoInicio DateTime
  periodoFin    DateTime
  fechaCorte    DateTime? // Decolsa workflow: "CORTE AL" — cuando se cierra el período
  estado        EstimacionEstado @default(BORRADOR)

  subtotal             Float
  retencionGarantia    Float @default(0)
  amortizacionAnticipo Float @default(0)
  iva                  Float
  total                Float

  // Cumulative figures cached at the time this estimación is approved. Lets
  // us render the dashboard without recomputing every time.
  importeAcumulado Float @default(0)
  pctPeriodo       Float @default(0)
  pctAcumulado     Float @default(0)

  // Link to the actual stamped CFDI when timbrada
  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  // Cobranza link — when the cliente paga, the matched BankTransaction lands
  // here and the estado flips to PAGADA. Auto-matched by the bancos /
  // candidates flow (amount + invoice match) or set manually from the UI.
  bankTransactionId String?          @unique
  bankTransaction   BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  proyecto    Proyecto            @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  presupuesto Presupuesto         @relation(fields: [presupuestoId], references: [id])
  partidas    EstimacionPartida[]
  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([proyectoId, numero])
}

enum EstimacionEstado {
  BORRADOR
  APROBADA
  TIMBRADA
  PAGADA
  CANCELADA
}

// One row per estimación-period × tracking-row. There are TWO measurement
// modes (mutually exclusive on a single row but coexist in the same model
// because every product wants the same Estimacion parent):
//
//   1. LEAF MODE  (Bartiz pattern, original)
//      presupuestoPartidaId set → tracks cantidadEjecutada on a leaf partida.
//      Used for unit-by-unit avance tracking (qty m³, kg, etc.).
//
//   2. TEMPLATE MODE  (Decolsa pattern, Run 2)
//      templatePartidaId set → tracks viviendasAvancePeriodo against the
//      compacted EstimacionTemplate row. Used for vivienda billing where
//      the customer measures # viviendas completed per partida.
//
// Snapshot fields (descripcionSnapshot, importeContrato) freeze the contract
// numbers at the time the estimación is approved so editing the template
// later doesn't invalidate prior estimaciones.
model EstimacionPartida {
  id           String @id @default(cuid())
  estimacionId String

  // ── LEAF MODE (Bartiz)
  presupuestoPartidaId String?
  cantidadEjecutada    Float? // this period
  cantidadAcumulada    Float? // running total

  // ── TEMPLATE MODE (Decolsa)
  templatePartidaId        String?
  viviendasObjetivo        Int? // snapshot of denominator
  viviendasAvancePeriodo   Int? // ← Gerardo's input
  viviendasAvanceAnterior  Int? // carried forward from prev estimación
  viviendasAvanceAcumulado Int? // computed
  pctPeriodo               Float? // computed
  pctAcumulado             Float? // computed
  descripcionSnapshot      String?
  importeContrato          Float? // capítulo total at template-set time

  // ── Both modes share these
  importe          Float // periodo importe (qty × PU OR pct × contrato)
  unidadProyectoId String? // optional: which depto / nivel consumed this

  estimacion         Estimacion                 @relation(fields: [estimacionId], references: [id], onDelete: Cascade)
  presupuestoPartida PresupuestoPartida?        @relation(fields: [presupuestoPartidaId], references: [id])
  template           EstimacionTemplatePartida? @relation(fields: [templatePartidaId], references: [id])
  unidad             UnidadProyecto?            @relation(fields: [unidadProyectoId], references: [id])
}

// Compacted billing structure — defines which capítulos (or sub-capítulos)
// of the master tree show up as a single row in the estimaciones grid.
// Bootstrapped on /presupuesto/import using Decolsa's default rule
// (capítulos 1–15 rolled at nivel 1, ≥16 broken at nivel 2). Always editable.
model EstimacionTemplate {
  id         String   @id @default(cuid())
  proyectoId String   @unique
  companyId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  proyecto         Proyecto                    @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  company          Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partidas         EstimacionTemplatePartida[]
  curvas           EstimacionCurvaCapitulo[]
  calendarioCierre CalendarioCierreCapitulo[]
}

model EstimacionTemplatePartida {
  id                   String @id @default(cuid())
  templateId           String
  presupuestoPartidaId String // FK to master tree at any nivel

  // Display
  orden        Int    @default(0)
  descripcion  String // free-form label (defaults to the partida's descripcion)
  capituloCode String // top-level capítulo "1", "2", ..., "30" — for curve lookup

  // Per-partida override of viviendasObjetivo. Null = inherit from Proyecto.
  viviendasObjetivo Int?

  template           EstimacionTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  presupuestoPartida PresupuestoPartida  @relation(fields: [presupuestoPartidaId], references: [id])
  estimacionPartidas EstimacionPartida[]
}

// Customer's expected weekly distribution per top-level capítulo.
// Bootstrapped from CURVA_VIVIENDA_2R_DEFAULT on import; Gerardo can edit.
// Each row = one capítulo (1, 2, …, 30) with its weekly pesos.
model EstimacionCurvaCapitulo {
  id           String @id @default(cuid())
  templateId   String
  capituloCode String // "1", "2", ... matches EstimacionTemplatePartida.capituloCode

  descripcion    String? // snapshot for display
  pesoPctSemanal Json // Float[] sized to project.weekCount; sum ≈ 1.0

  template EstimacionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, capituloCode])
}

// CALENDARIO CIERRE — Gerardo's internal cashflow planner (sheet 4 of his
// Excel template). Same shape as EstimacionCurvaCapitulo (capítulo × weekly
// distribution) but for INTERNAL planning, not the customer's expected
// curve. Sums per capítulo can be < 1.0 (Gerardo only marks weeks where he
// expects to spend; unmarked = no plan).
//
// Used to project monthly/weekly outflow against the customer's expected
// inflow curve (sheet 3) — gives Gerardo his cashflow projection.
//
// Bootstrapped empty when the EstimacionTemplate is created. Editable
// per-cell from the Programa tab.
model CalendarioCierreCapitulo {
  id           String @id @default(cuid())
  templateId   String
  capituloCode String // "1", "2", ... matches EstimacionTemplatePartida.capituloCode

  descripcion    String?
  pesoPctSemanal Json // Float[] sized to project.weekCount; sum ≤ 1.0

  template EstimacionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, capituloCode])
}

// Project subdivisions — supports tower/apartment/nivel tree for multi-unit
// construction projects (Decolsa's Torres Platino: 3 towers × ~12 deptos each).
// Presupuesto partidas are usually scoped to the proyecto (template), and the
// specific unidad that consumed each unit of avance is recorded on the
// EstimacionPartida row.
model UnidadProyecto {
  id         String   @id @default(cuid())
  proyectoId String
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  nombre   String // "Torre A", "Depto 101", "Nivel 3"
  tipo     String? // "TORRE" | "NIVEL" | "DEPTO" — free-form tag
  codigo   String? // "T-A", "101"
  orden    Int     @default(0)
  metadata Json? // {"superficie": 95.5, "recamaras": 2}

  parent   UnidadProyecto?  @relation("UnidadHierarchy", fields: [parentId], references: [id])
  hijos    UnidadProyecto[] @relation("UnidadHierarchy")
  proyecto Proyecto         @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  partidas           PresupuestoPartida[]
  estimacionPartidas EstimacionPartida[]
  rayaTrabajos       RayaTrabajo[]

  @@index([proyectoId, parentId])
}

// Programa de obra: hierarchical activity tree (Gantt source).
model ProgramaActividad {
  id          String   @id @default(cuid())
  proyectoId  String
  nombre      String
  fechaInicio DateTime
  fechaFin    DateTime
  porcAvance  Float    @default(0)
  parentId    String?

  parent   ProgramaActividad?  @relation("Subactividades", fields: [parentId], references: [id])
  hijos    ProgramaActividad[] @relation("Subactividades")
  proyecto Proyecto            @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

// Solicitudes de compra: purchase request → approval → payment workflow.
// When pagada, links to a BankTransaction so the bank reconciliation loop closes.
model SolicitudCompra {
  id         String   @id @default(cuid())
  companyId  String
  proyectoId String?
  supplierId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  folio  String
  estado SolicitudEstado @default(PENDIENTE)
  total  Float
  notas  String?

  // Header metadata — matches the partner's "SOLICITUD DE COTIZACIÓN"
  // Excel template (OBRA / Fecha solicitud / Fecha entrega / SOLICITUD N° /
  // CRÉDITO vs CONTADO).
  fechaEntrega DateTime?
  formaPago    SolicitudFormaPago?

  // Approval tracking
  aprobadaPorId String?
  aprobadaAt    DateTime?
  pagadaAt      DateTime?

  // When paid, link to the BankTransaction that funded it
  bankTransactionId String? @unique

  proyecto        Proyecto?                   @relation(fields: [proyectoId], references: [id])
  supplier        Supplier?                   @relation(fields: [supplierId], references: [id])
  company         Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction?            @relation(fields: [bankTransactionId], references: [id])
  partidas        SolicitudPartida[]
  cotizaciones    SolicitudCompraCotizacion[]
  adjudicaciones  SolicitudAdjudicacion[]

  @@unique([companyId, folio])
  @@index([companyId, estado])
}

enum SolicitudEstado {
  BORRADOR
  PENDIENTE
  APROBADA
  RECHAZADA
  PAGADA
  CANCELADA
}

enum SolicitudFormaPago {
  CREDITO
  CONTADO
}

model SolicitudPartida {
  id             String  @id @default(cuid())
  solicitudId    String
  insumoId       String?
  descripcion    String
  unidad         String? // TON, PALLET, m3, kg, pza — keeps requisición rows aligned with the Excel template
  cantidad       Float
  precioUnitario Float
  importe        Float

  // Link purchase to a specific ejecutado partida for cost tracking
  presupuestoPartidaId String?
  presupuestoPartida   PresupuestoPartida? @relation(fields: [presupuestoPartidaId], references: [id])

  // Adjudicación por concepto: qué cotización (de qué proveedor) ganó esta
  // línea. Permite repartir una requisición entre varios proveedores (concepto
  // A → proveedor X, concepto B → proveedor Y) y fanout a una OC por proveedor.
  cotizacionGanadoraId String?
  cotizacionGanadora   SolicitudCompraCotizacion? @relation("PartidaAdjudicada", fields: [cotizacionGanadoraId], references: [id], onDelete: SetNull)

  solicitud    SolicitudCompra              @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  insumo       Insumo?                      @relation(fields: [insumoId], references: [id])
  cotizaciones SolicitudCotizacionPartida[]
}

// ─── Cotizaciones (multi-vendor quotes for a requisición) ────────────────────
//
// Gerardo's flow: he sends a requisición (SolicitudCompra in REQUESTED
// state) to several proveedores, each comes back with their own pricing
// per line. The winning quote becomes the SolicitudCompra final + drives
// the eventual OC. Replaces the manual "compare 3 Excels" loop.
//
// One Cotizacion row per vendor per requisición; many CotizacionPartida
// rows per cotización (one per item priced). Switching the winner is a
// single isSelected flip.
model SolicitudCompraCotizacion {
  id              String    @id @default(cuid())
  solicitudId     String
  supplierId      String?
  supplierNombre  String // "RYSCO", "BARAMAT" — free-text when supplier row doesn't exist yet
  fechaCotizacion DateTime  @default(now())
  vigenciaHasta   DateTime?
  total           Float     @default(0)
  moneda          String    @default("MXN")
  notas           String?
  isSelected      Boolean   @default(false)
  // Forma de pago de esta oferta: precargada de las condiciones del proveedor
  // (SupplierTerms) pero ajustable por oferta. true = a crédito, false = contado.
  tieneCredito    Boolean   @default(false)
  // Días de crédito ofrecidos (0/ null = contado). Precargado del proveedor
  // guardado pero capturable a mano para proveedores de texto libre; alimenta
  // la fecha de vencimiento en cuentas por pagar.
  diasCredito     Int?
  // Tiempo de entrega prometido por este proveedor (días hábiles). Cada
  // proveedor cotiza su propio plazo, por eso vive en la cotización y no como
  // una sola "fecha de entrega" en la requisición.
  diasEntrega     Int?
  // Scanned/uploaded quote — same dual-storage pattern as Gasto comprobantes.
  archivoUrl      String?
  archivoData     String?   @db.Text
  archivoMime     String?
  archivoName     String?
  createdAt       DateTime  @default(now())

  solicitud           SolicitudCompra              @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  supplier            Supplier?                    @relation(fields: [supplierId], references: [id])
  partidas            SolicitudCotizacionPartida[]
  partidasAdjudicadas SolicitudPartida[]           @relation("PartidaAdjudicada")
  adjudicaciones      SolicitudAdjudicacion[]

  @@index([solicitudId, isSelected])
}

// Adjudicación por proveedor: cuando se autoriza una requisición, las líneas
// ganadas se agrupan por proveedor en un "pagadero" independiente. Cada
// proveedor se paga por separado (monto propio, condición de crédito y fecha de
// entrega de su cotización). Es la unidad que ve tesorería en cuentas por pagar.
model SolicitudAdjudicacion {
  id                 String    @id @default(cuid())
  companyId          String // denormalizado para listar cuentas por pagar por empresa
  solicitudId        String
  cotizacionId       String // la cotización ganadora (origen de crédito/entrega)
  supplierId         String? // null cuando el proveedor es texto libre
  supplierNombre     String
  tieneCredito       Boolean   @default(false)
  diasCredito        Int? // días de crédito de la oferta ganadora → vencimiento
  diasEntrega        Int?
  total              Float // Σ importe de las líneas adjudicadas a este proveedor
  // POR_PAGAR → PARCIAL (pagos aplicados < total) → PAGADA (saldada) →
  // CONCILIADA (empatada con un movimiento bancario importado = pago real).
  // El pago vive en PagoProveedor (cuenta corriente del proveedor) y se
  // aplica a adjudicaciones vía PagoAplicacion — un pago puede cubrir varias
  // requisiciones, parciales o quedar como anticipo. Registrar pagos NO crea
  // movimientos bancarios: el banco se llena sólo con el CSV importado.
  estado             String    @default("POR_PAGAR") // POR_PAGAR | PARCIAL | PAGADA | CONCILIADA
  // Cuándo admin la mandó a tesorería para pago (workflow de cuentas por pagar).
  enviadaTesoreriaAt DateTime?
  pagadaAt           DateTime? // cuándo se registró el pago (comprobante)
  conciliadaAt       DateTime? // cuándo se empató con el movimiento bancario real
  referenciaPago     String? // referencia/folio SPEI capturado al registrar el pago
  // Comprobante de pago (SPEI/transferencia) — mismo patrón dual que las
  // cotizaciones. Se sube al registrar el pago, antes de conciliar.
  comprobanteData    String?   @db.Text
  comprobanteMime    String?
  comprobanteName    String?
  bankTransactionId  String?   @unique // se fija al conciliar, no al pagar
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  solicitud       SolicitudCompra           @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  cotizacion      SolicitudCompraCotizacion @relation(fields: [cotizacionId], references: [id])
  bankTransaction BankTransaction?          @relation("AdjudicacionPago", fields: [bankTransactionId], references: [id])
  aplicaciones    PagoAplicacion[]

  @@index([solicitudId])
  @@index([companyId, estado])
  @@map("construccion_solicitud_adjudicacion")
}

// ─── Cuenta corriente del proveedor (pagos + aplicaciones) ──────────────────
//
// Un pago se registra CONTRA EL PROVEEDOR (abono a su cuenta), no contra una
// requisición: un SPEI puede cubrir varias adjudicaciones, parcialidades, o
// quedar como anticipo (saldo a favor) cuando excede la deuda abierta. La
// aplicación (PagoAplicacion) es el puente pago ↔ adjudicación con monto
// parcial. NO toca el banco ni el ledger: el movimiento real llega por el CSV
// y se empata en la conciliación (CFDI ↔ movimiento).
model PagoProveedor {
  id              String   @id @default(cuid())
  companyId       String
  supplierId      String? // null cuando el proveedor es texto libre
  supplierNombre  String // clave de agrupación cuando no hay Supplier row
  fecha           DateTime @default(now())
  monto           Float // total del pago; lo no aplicado = anticipo/saldo a favor
  referencia      String? // folio SPEI / transferencia
  comprobanteData String?  @db.Text
  comprobanteMime String?
  comprobanteName String?
  notas           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier     Supplier?        @relation(fields: [supplierId], references: [id])
  aplicaciones PagoAplicacion[]

  @@index([companyId, supplierId])
  @@index([companyId, fecha])
  @@map("construccion_pago_proveedor")
}

// Aplicación parcial de un pago a una adjudicación. Un pago → N adjudicaciones
// y una adjudicación → N pagos. Σ monto por pago ≤ pago.monto; Σ monto por
// adjudicación ≤ adjudicación.total (con tolerancia de centavos).
model PagoAplicacion {
  id             String   @id @default(cuid())
  pagoId         String
  adjudicacionId String
  monto          Float
  createdAt      DateTime @default(now())

  pago         PagoProveedor         @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  adjudicacion SolicitudAdjudicacion @relation(fields: [adjudicacionId], references: [id], onDelete: Cascade)

  @@unique([pagoId, adjudicacionId])
  @@index([adjudicacionId])
  @@map("construccion_pago_aplicacion")
}

model SolicitudCotizacionPartida {
  id                 String  @id @default(cuid())
  cotizacionId       String
  solicitudPartidaId String
  precioUnitario     Float
  importe            Float
  tiempoEntrega      String?
  notas              String?

  cotizacion       SolicitudCompraCotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  solicitudPartida SolicitudPartida          @relation(fields: [solicitudPartidaId], references: [id])

  @@unique([cotizacionId, solicitudPartidaId])
}

// ─── Presupuesto versioning (ejecutado change log) ───────────────────────────

model PresupuestoVersion {
  id            String   @id @default(cuid())
  presupuestoId String
  version       Int
  createdAt     DateTime @default(now())
  descripcion   String? // "Engineer found stone walls", "Added waterproofing"
  snapshotTotal Float // montoTotal at time of snapshot

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@unique([presupuestoId, version])
}

// ─── Bitácora de obra (field log) ────────────────────────────────────────────

model BitacoraEntrada {
  id         String   @id @default(cuid())
  proyectoId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fecha DateTime     @default(now()) // field date (may differ from createdAt)
  texto String       @db.Text
  tipo  BitacoraTipo @default(NOTA)

  // Optional links
  presupuestoPartidaId String?
  fotos                String[] // URL array for photos

  proyecto           Proyecto            @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  presupuestoPartida PresupuestoPartida? @relation(fields: [presupuestoPartidaId], references: [id])

  @@index([proyectoId, fecha])
}

enum BitacoraTipo {
  NOTA
  DECISION
  PROBLEMA
  CLIMA
  FOTO
}

// ─── Pagos de proyecto (anticipo, estimaciones, retención) ───────────────────

model Pago {
  id         String   @id @default(cuid())
  proyectoId String
  companyId  String
  createdAt  DateTime @default(now())

  tipo              PagoTipo
  monto             Float
  fecha             DateTime
  referencia        String?
  bankAccountId     String?
  bankTransactionId String?  @unique
  estimacionId      String?

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([proyectoId])
}

enum PagoTipo {
  ANTICIPO
  ESTIMACION
  RETENCION_LIBERADA
}

// ─── CONSTRUCCION_CUADRILLAS add-on ─────────────────────────────────────────
//
// Decolsa-style weekly destajo workflow. A Cuadrilla is a trade team
// (albañilería, plomería, etc.) scoped to one proyecto. Miembros are
// optional named references — some may be IMSS-registered (employeeId FK),
// most are cash-only (free-text nombre, employeeId=null).
//
// Rayas are WEEKLY cash-flow events. When a raya is marked PAGADA we
// emit a BankTransaction; the raya keeps the FK so we can reconcile
// later. No PayrollRun integration — rayas sit parallel to the nomina
// module because most destajo workers are not formally registered.

model Cuadrilla {
  id         String   @id @default(cuid())
  companyId  String
  proyectoId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  nombre       String // "Albañilería", "Plomería y Gas"
  especialidad String // free-text tag: "ALBANILERIA" | "PLOMERIA" | "ELECTRICO" | ...
  jefeNombre   String? // "Maestro Juan", purely descriptive
  notas        String?
  isActive     Boolean @default(true)

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proyecto Proyecto           @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  miembros CuadrillaMiembro[]
  rayas    RayaSemanal[]

  @@unique([proyectoId, nombre])
  @@index([companyId, isActive])
}

model CuadrillaMiembro {
  id          String   @id @default(cuid())
  cuadrillaId String
  createdAt   DateTime @default(now())

  nombre         String // free-text (works for both formal & cash workers)
  employeeId     String? // optional FK when this miembro is also an IMSS-registered Employee
  rolEnCuadrilla String? // "Oficial" | "Ayudante" | "Maestro" — free text
  isActive       Boolean @default(true)

  cuadrilla Cuadrilla            @relation(fields: [cuadrillaId], references: [id], onDelete: Cascade)
  employee  Employee?            @relation(fields: [employeeId], references: [id])
  detalles  RayaDetalleMiembro[]

  @@index([cuadrillaId, isActive])
}

// A weekly raya for one cuadrilla. Always a cash-flow event — on pagar
// we create a BankTransaction debited from the cuadrilla's paying account
// and store its id here.
model RayaSemanal {
  id          String   @id @default(cuid())
  companyId   String
  proyectoId  String
  cuadrillaId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  semanaInicio DateTime // Monday 00:00 local
  semanaFin    DateTime // Sunday 23:59 local
  estado       RayaEstado @default(BORRADOR)
  totalDestajo Float      @default(0) // sum of RayaTrabajo.importeDestajo
  notas        String?

  // Filled when marked PAGADA. Unique so we can't double-book a raya.
  bankTransactionId String?   @unique
  pagadaAt          DateTime?

  company         Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proyecto        Proyecto             @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  cuadrilla       Cuadrilla            @relation(fields: [cuadrillaId], references: [id])
  bankTransaction BankTransaction?     @relation(fields: [bankTransactionId], references: [id])
  trabajos        RayaTrabajo[]
  detalles        RayaDetalleMiembro[]

  @@unique([cuadrillaId, semanaInicio])
  @@index([proyectoId, semanaInicio])
  @@index([companyId, estado])
}

enum RayaEstado {
  BORRADOR
  APROBADA
  PAGADA
}

// Line item inside a raya: "en el Depto 101, hicimos X de aplanados por $Y"
model RayaTrabajo {
  id                   String  @id @default(cuid())
  rayaId               String
  presupuestoPartidaId String? // optional link to a leaf partida (drives avance)
  unidadProyectoId     String? // optional "en el Depto 101"
  descripcion          String
  cantidad             Float?
  unidad               String?
  importeDestajo       Float

  raya               RayaSemanal         @relation(fields: [rayaId], references: [id], onDelete: Cascade)
  presupuestoPartida PresupuestoPartida? @relation(fields: [presupuestoPartidaId], references: [id])
  unidadProyecto     UnidadProyecto?     @relation(fields: [unidadProyectoId], references: [id])

  @@index([rayaId])
}

// How much each miembro got paid in this raya (days + importe). The sum
// of detalles.importe should match the raya's totalDestajo, but we don't
// enforce it at the DB level — the UI will show a diff if they disagree.
model RayaDetalleMiembro {
  id             String @id @default(cuid())
  rayaId         String
  miembroId      String
  diasTrabajados Float  @default(6)
  importe        Float

  raya    RayaSemanal      @relation(fields: [rayaId], references: [id], onDelete: Cascade)
  miembro CuadrillaMiembro @relation(fields: [miembroId], references: [id])

  @@unique([rayaId, miembroId])
}

// ─── Gasto (Katia's pay-and-register workflow) ──────────────────────────────
//
// Lightweight expense model for the WhatsApp-driven field-spending flow
// that SolicitudCompra is too heavy for. Rosy (field PM) requests a
// payment via WhatsApp; Katia (admin) creates a Gasto row, the system
// suggests which insumo/partida matches, she approves and pays in one
// click. Optional caja=true flag means the money came out of the petty
// cash fund (BankAccount with tipo=CAJA), not a main cuenta.
//
// Why a new model instead of extending SolicitudCompra:
//   - SolicitudCompra has partidas array, approval chain, receive step;
//     overkill for a single-line SPEI "varilla arena $2,375 to Jose Luis".
//   - Matching target is either a PresupuestoPartida (budget leaf) OR an
//     Insumo (material master) OR both. SolicitudPartida only links to
//     PresupuestoPartida.
//   - The value-add is fast entry + the "does this fit the explosión
//     de insumos" check, which is its own endpoint.
model Gasto {
  id            String   @id @default(cuid())
  companyId     String
  proyectoId    String
  // Cuenta que pagó. Opcional: la cuenta real se determina en la conciliación
  // (CFDI ↔ movimiento importado), no al capturar el gasto. Se conserva para
  // datos históricos y para caja chica.
  bankAccountId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // What + to whom + how much
  beneficiarioNombre String // "Lesly Flores", "Jose Luis Lopez Pozos"
  descripcion        String // free-text what was bought: "varilla y arena"
  importe            Float

  // Physical quantity + unit — optional for indirect gastos but required
  // for a meaningful insumo variance view (planned vs real PU). If set,
  // importe / cantidad should match the real PU Rosy paid.
  cantidad Float?
  unidad   String?

  // Optional budget linkage — Katia picks from auto-suggest
  presupuestoPartidaId String?
  insumoId             String?

  // Weekly reembolso this gasto belongs to. Set when the gasto is part
  // of a Rosy-style weekly reimbursement package; null for one-off pays.
  reembolsoId String?

  // Attachments — two flavors:
  //   *Url  = external URL (legacy, back-compat with pre-upload flow)
  //   *Data = base64 content directly in DB (same pattern as csdCer /
  //           fielCer elsewhere). Small-file friendly — Rosy's WhatsApp
  //           photos are usually < 2 MB. Mime + name let us serve them
  //           back with the right headers.
  comprobanteUrl      String? // invoice/receipt URL
  comprobanteData     String? @db.Text
  comprobanteMime     String?
  comprobanteName     String?
  pagoComprobanteUrl  String? // SPEI / cheque screenshot URL
  pagoComprobanteData String? @db.Text
  pagoComprobanteMime String?
  pagoComprobanteName String?

  estado GastoEstado @default(PENDIENTE)

  // Flag that this came out of the caja chica account (redundant with
  // bankAccount.tipo=CAJA but kept for fast filtering and audit).
  caja Boolean @default(false)

  // "Indirecto" = overhead / costo indirecto: gasolina, viáticos,
  // herramienta menor, flete, seguridad, renta de andamios, alimentos
  // del personal. These are legitimate project costs that DON'T belong
  // to a specific partida/insumo. Real construction accounting breaks
  // them out as % sobre MO+materiales.
  //
  // Approval rule enforced in aprobar-pagar: a Gasto must be EITHER
  //   - linked to a presupuestoPartidaId or insumoId (directo), OR
  //   - indirecto=true with a categoriaIndirecto tag.
  // Otherwise approval is refused — guarantees budget attribution.
  indirecto          Boolean @default(false)
  categoriaIndirecto String? // free-text tag: "GASOLINA" | "VIATICOS" | "FLETE" | "HERRAMIENTA_MENOR" | "EQUIPO_SEGURIDAD" | "RENTA_EQUIPO" | "ALIMENTOS" | etc.

  // Populated on /aprobar-pagar
  bankTransactionId  String?   @unique
  pagadoAt           DateTime?
  // Cuándo admin lo mandó a tesorería para pago (workflow de cuentas por pagar).
  enviadaTesoreriaAt DateTime?

  // Katia's approval audit
  aprobadoPor String? // User id
  aprobadoAt  DateTime?

  notas String?

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proyecto           Proyecto            @relation(fields: [proyectoId], references: [id])
  bankAccount        BankAccount?        @relation(fields: [bankAccountId], references: [id])
  presupuestoPartida PresupuestoPartida? @relation(fields: [presupuestoPartidaId], references: [id])
  insumo             Insumo?             @relation(fields: [insumoId], references: [id])
  bankTransaction    BankTransaction?    @relation(fields: [bankTransactionId], references: [id])
  reembolso          ReembolsoSemanal?   @relation(fields: [reembolsoId], references: [id], onDelete: SetNull)

  @@index([companyId, estado])
  @@index([proyectoId, createdAt])
  @@index([reembolsoId])
}

enum GastoEstado {
  PENDIENTE
  APROBADO // Katia validated; still waiting to pay
  PAGADO // BankTransaction created
  RECHAZADO // out of budget, duplicate, etc.
}

// ─── ReembolsoSemanal (Concentrado Semanal / weekly reimbursement) ───────────
//
// Rosy's pattern: at end of each week she submits a PDF package of what
// she spent + the nómina + next-week caja chica advance. Katia validates
// line-by-line, the system computes the total, and Juan SPEIs the
// balance to Rosy as a single transfer. Replaces the "WhatsApp table →
// spreadsheet → SPEI screenshot" loop.
//
// A ReembolsoSemanal is a HEADER containing many Gasto rows (each tied
// to insumo/partida or marked indirecto). On /reembolsar we:
//   1. Validate every gasto has attribution (enforced on aprobar-pagar
//      already, but double-check here so the reembolso as a whole is
//      consistent).
//   2. Compute totalGastos from the joined Gastos.
//   3. Create ONE BankTransaction DEBITO for totalReembolso (anticipo
//      aplicado is subtracted — that's the caja chica previously
//      advanced to Rosy).
//   4. Flip every Gasto in the package to PAGADO + set their
//      bankTransactionId to the single BT, so the cash-flow ties out.
//   5. Flip reembolso.estado = REEMBOLSADO.
//
// Integration with nómina (Phase A-5, deferred): a RayaSemanal can
// optionally point at a Reembolso so the weekly nómina is part of the
// same package. For now the v1 treats nómina as just another Gasto
// line with indirecto=true, categoriaIndirecto=NOMINA.
model ReembolsoSemanal {
  id            String   @id @default(cuid())
  companyId     String
  proyectoId    String
  bankAccountId String // account that will pay the final SPEI (usually CHEQUES)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  semanaInicio DateTime
  semanaFin    DateTime
  estado       ReembolsoEstado @default(SUBMITTED)

  // Running totals (denormalized for fast list views; recomputed on gasto add/remove)
  totalGastos      Float @default(0)
  // Adelanto previo de caja chica que este reembolso justifica.
  // Ejemplo: Rosy recibió $5,000 el lunes para caja chica; gastó $7,500
  // en la semana; reembolso total a pagar = $7,500 - $5,000 = $2,500.
  anticipoAplicado Float @default(0)
  totalReembolso   Float @default(0) // totalGastos - anticipoAplicado

  // Pago
  bankTransactionId String?   @unique
  reembolsadoAt     DateTime?
  reembolsadoPor    String?

  notas String?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proyecto        Proyecto         @relation(fields: [proyectoId], references: [id])
  bankAccount     BankAccount      @relation(fields: [bankAccountId], references: [id])
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  gastos          Gasto[]

  @@unique([proyectoId, semanaInicio])
  @@index([companyId, estado])
}

enum ReembolsoEstado {
  SUBMITTED // Rosy mandó el paquete, Katia aún no revisa
  REVISADO // Katia validó líneas, listo para pagar
  REEMBOLSADO // Juan ya SPEIó a Rosy, BankTransaction creada
  RECHAZADO // inconsistencias / duplicados / no justificado
}

// ─── WhatsApp channel (W0) ─────────────────────────────────────────────────────

// A verified binding between a WhatsApp phone number and an app user.
//
// SECURITY: caller ID alone is NEVER trusted. A link is only honored once
// `verifiedAt` is set via the in-app 6-digit code flow. Until then the row is
// inert (resolvePhone ignores it). One user may link several numbers; a number
// maps to exactly one user (a phone is an identity, not a shared mailbox).
model WhatsappLink {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  phoneE164 String @unique // normalized, e.g. "+5215512345678"
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Verification (code-based, started in-app). Unverified rows are inert.
  verifiedAt    DateTime?
  codeHash      String? // sha256 of the 6-digit code (never store the code)
  codeExpiresAt DateTime?
  attempts      Int       @default(0) // failed verify attempts → lockout

  // Opt-in (despacho operators) to receive a daily portfolio digest over
  // WhatsApp. Captured here; the digest cron is a separate future build.
  digestOptIn Boolean @default(false)

  // Which company this number is currently "talking about". Set after the user
  // disambiguates; switchable mid-conversation. Null = ask again on next inbound.
  activeCompanyId String?
  activeCompany   Company? @relation("WhatsappActiveCompany", fields: [activeCompanyId], references: [id], onDelete: SetNull)

  conversations WhatsappConversation[]

  @@index([userId])
}

// Pending link code for the deep-link (user-initiated) vinculación flow.
//
// El usuario genera un código de 6 dígitos en la app y lo ENVÍA al número del
// negocio por WhatsApp (mensaje iniciado por el usuario → abre la ventana de 24h,
// sin plantilla ni verificación de Meta). El teléfono es DESCONOCIDO al crear el
// código: sólo se conoce cuando llega el mensaje entrante. Por eso el código se
// ata al userId, no al teléfono. De un solo uso (`usedAt`) y con TTL (`expiresAt`,
// ~15 min). El código es un bearer token efímero y de bajo valor: sólo vincula el
// número que lo envía a la cuenta ya autenticada que lo generó.
model WhatsappLinkCode {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  code   String // 6 dígitos; se busca por él al llegar el mensaje entrante
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime? // sellado al canjearse → un solo uso

  @@index([code])
  @@index([userId])
}

// Tier 3 — "rieles" de escrituras de alto valor (timbrar, complemento de pago…).
// Una acción irreversible/fiscal NUNCA se ejecuta desde WhatsApp con un simple
// "sí": el asistente la ESCENIFICA aquí y manda un deep link a una pantalla de
// revisión DENTRO de la app (sesión autenticada = reautenticación real, resistente
// a SIM-swap). El usuario revisa el documento completo y confirma; recién ahí se
// ejecuta por la ruta endurecida (idempotencia + bitácora + gating de suscripción)
// y el bot responde el resultado (UUID) por la conversación de origen.
model StagedAction {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SHA-256 (hex) del token crudo del deep link. El token crudo solo sale del
  // servidor una vez, embebido en el enlace enviado por WhatsApp — nunca se guarda.
  tokenHash String @unique

  // Qué acción es (p.ej. "timbrar"). Determina cómo se ejecuta al confirmar.
  type String

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Usuario para quien se preparó (el emisor de WhatsApp). Al confirmar en la app
  // se re-verifica la membresía; este campo por sí solo NO autoriza.
  createdByUserId String

  // Conversación de WhatsApp de origen — para responder el resultado por ahí.
  whatsappConversationId String?

  // Resumen legible (lo que EXACTAMENTE pasará al confirmar) + payload de la acción.
  summary String
  payload Json

  status            StagedActionStatus @default(PENDING)
  expiresAt         DateTime
  confirmedAt       DateTime?
  confirmedByUserId String?
  // Resultado tras ejecutar (p.ej. folio fiscal del CFDI) o el error si falló.
  resultUuid        String?
  error             String?

  @@index([companyId])
  @@index([createdByUserId])
}

enum StagedActionStatus {
  PENDING // escenificada, esperando confirmación en la app
  EXECUTING // confirmada; ejecución en curso (candado de un solo uso)
  DONE // ejecutada con éxito
  FAILED // la ejecución falló (ver `error`)
  CANCELLED // el usuario la descartó
}

// One thread per (link, company). Holds rolling history + a reserved slot for a
// pending write action (unused in W0; for the W4 confirmation flow).
model WhatsappConversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  linkId    String
  link      WhatsappLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  companyId String
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Reserved for Pillar-F writes: a serialized action awaiting in-app/code
  // confirmation. Always null in W0 (read-only).
  pendingAction Json?

  messages WhatsappMessage[]

  @@unique([linkId, companyId])
  @@index([companyId])
}

enum WhatsappRole {
  USER
  ASSISTANT
}

// One SAT régimen a company/PF is registered under. The `isPrimary` row mirrors
// Company.regimenFiscal (kept in sync at create time). A taxpayer often has
// several (e.g. Sueldos y Salarios + Arrendamiento + Dividendos).
model CompanyRegimen {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  code      String // 3-digit SAT régimen code, e.g. "606"
  label     String // human label, e.g. "Arrendamiento"
  since     DateTime? // "Fecha Inicio" from the CSF régimenes table
  isPrimary Boolean   @default(false)

  @@unique([companyId, code])
  @@index([companyId])
}

model WhatsappMessage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  conversationId String
  conversation   WhatsappConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role        WhatsappRole
  body        String       @db.Text
  providerSid String? // Twilio message SID — inbound dedup / outbound audit

  @@index([conversationId, createdAt])
}

// Web Push (PWA + desktop) subscription — one row per browser/device. Pruned
// automatically when the push service returns 404/410 (expired endpoint).
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String // client public key (keys.p256dh)
  auth      String // client auth secret (keys.auth)
  userId    String
  companyId String? // active company when subscribed (optional scoping)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─── Fiscal knowledge base (RAG sobre legislación fiscal) ───────────────────
// Cited, version-aware retrieval over leyes/RMF/criterios/DOF. Requires the
// pgvector extension — run `npm run fiscal:setup` BEFORE `npm run db:push`.
// Design doc: docs/FISCAL-KNOWLEDGE-BASE.md

enum FiscalSource {
  LEY
  RMF
  CRITERIO
  DOF
  REGLAMENTO
  TESIS
  GUIA // guías de llenado / Anexo 20 (SAT)
}

model FiscalDocument {
  id            String        @id @default(cuid())
  source        FiscalSource
  clave         String // "LISR", "CFF", "RMF-2026"
  titulo        String
  url           String // canonical source URL
  publicadoDof  DateTime? // DOF publication date of this version, if known
  vigenciaDesde DateTime
  vigenciaHasta DateTime? // null = texto vigente
  hash          String // sha256 of normalized text — skips unchanged re-ingest
  chunks        FiscalChunk[]
  createdAt     DateTime      @default(now())

  @@unique([clave, vigenciaDesde])
  @@index([source, clave])
}

model FiscalChunk {
  id            String                      @id @default(cuid())
  documentId    String
  document      FiscalDocument              @relation(fields: [documentId], references: [id], onDelete: Cascade)
  articulo      String? // "113-E", "TRANSITORIOS"; null = preámbulo
  parte         Int? // sub-chunk index (1-based) for long articles
  contexto      String? // breadcrumb: TÍTULO / CAPÍTULO / SECCIÓN
  texto         String                      @db.Text
  embedding     Unsupported("vector(1536)") // dim must match EMBEDDING_DIM in src/lib/fiscal-kb/embed.ts
  vigenciaDesde DateTime // denormalized from document → filtered vector search sin join extra
  vigenciaHasta DateTime?
  regimenes     String[]                    @default([])

  @@index([documentId])
}

// Findings raised by the fiscal auditor (the "24/7 contador"). Deliberately
// standalone — only a `companyId` scalar, no relation back to Company — so this
// model is fully additive and touches no existing model. `dedupeKey` (checkClave
// + sorted referencias) makes re-runs idempotent: the same finding upserts in
// place and keeps its `estado` instead of duplicating.
model FiscalHallazgo {
  id        String @id @default(cuid())
  companyId String

  checkClave  String
  severidad   String // "info" | "warn" | "error"
  mensaje     String   @db.Text
  referencias String[] // CFDI ids involucrados
  sugerencia  String   @db.Text

  // Fundamento legal citado (denormalizado para consulta directa).
  fundamentoLey      String
  fundamentoArticulo String
  fundamentoFraccion String?

  // Ciclo de vida gestionado por el usuario/contador.
  estado String @default("ABIERTO") // "ABIERTO" | "RESUELTO" | "IGNORADO"

  // Posponer ("snooze"): silencia el hallazgo (de la lista de Abiertos y del
  // digest) hasta esta fecha; al vencer reaparece solo. Ortogonal a `estado`
  // (sigue ABIERTO). null = no pospuesto.
  posponerHasta DateTime?

  // Idempotencia de re-corridas del auditor.
  dedupeKey String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, dedupeKey])
  @@index([companyId, estado])
}

// Estado del ciclo de vida de un pendiente del inbox unificado. NUEVO al crearse
// (y al re-dispararse una alerta que el usuario ya había visto); VISTO al abrir
// el deep-link; HECHO al marcarlo atendido; POSPUESTO mientras `posponerHasta`
// no venza.
enum EstadoPendiente {
  NUEVO
  VISTO
  HECHO
  POSPUESTO
}

// Inbox unificado de "Pendientes" — cada notificación proactiva que hoy sólo se
// empuja por web-push se PERSISTE también aquí, para que el usuario pueda darle
// seguimiento (leer / hecho / posponer) cross-empresa, con deep-link. El push y
// el inbox son el MISMO registro: la idempotencia es por (recipientUserId,
// dedupeKey), reusando el `tag` de colapso del push como llave.
//
// Standalone — `recipientUserId` y `companyId` son escalares (sin relación), para
// ser puramente aditivo. `companyId` es null en pendientes a nivel cartera (p.ej.
// el briefing matutino, que agrega varias empresas).
model NotificationItem {
  id              String  @id @default(cuid())
  recipientUserId String
  companyId       String? // null = pendiente a nivel cartera (sin empresa única)

  categoria String // briefing | estado_cuenta | nomina | proyeccion | ce | otro
  severidad String // info | warn | error
  titulo    String
  cuerpo    String @db.Text
  url       String @db.Text // deep link

  // Idempotencia: reusa el `tag` de colapso del push. Un re-disparo actualiza el
  // mismo registro en vez de crear uno nuevo.
  dedupeKey String

  estado        EstadoPendiente @default(NUEVO)
  // Posponer ("snooze"): silencia el pendiente hasta esta fecha; al vencer
  // reaparece como pendiente. null = no pospuesto.
  posponerHasta DateTime?
  leidoAt       DateTime?
  hechoAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipientUserId, dedupeKey])
  @@index([recipientUserId])
  @@index([recipientUserId, estado])
}

// Snapshots del monitoreo de cumplimiento (opinión SAT 32-D, opinión IMSS,
// CSF). Standalone — solo companyId scalar, sin relación a Company — para ser
// puramente aditivo. `contenidoHash` permite saltar snapshots sin cambios; los
// Hallazgos derivados se persisten aparte (FiscalHallazgo).
model ComplianceSnapshot {
  id        String @id @default(cuid())
  companyId String

  tipo      String // "SAT_OPINION" | "IMSS_OPINION" | "CSF"
  resultado String // opinión: POSITIVA/NEGATIVA/…  · CSF: estatus del padrón
  motivos   String[] // obligaciones omitidas / motivos de negativa

  perfil   Json? // CSF: { rfc, regimenes, obligaciones, codigoPostal, estatusPadron }
  acuseUrl String? @db.Text // PDF/acuse de respaldo

  contenidoHash String // para detección de cambios entre corridas
  vigencia      DateTime?
  fetchedAt     DateTime  @default(now())

  createdAt DateTime @default(now())

  @@index([companyId, tipo, fetchedAt])
}

// ─── Module: Padel — "The Club Padel & Academy Puebla" ───────────────────────
//
// Gated behind CompanyModule(modulo = PADEL). Satellite app "theclubpadel"
// (React/Vite SPA) renders the UI; all data + auth + accounting live here in
// the hub. Every table is scoped by companyId so cross-tenant reads are
// impossible. Milestone 1 covers courts + reservations + Playtomic sync +
// the court-rental money loop (see src/lib/accounting/postings.ts). Lessons,
// shop/POS, sponsors and space rentals land in later milestones.

/// Per-club configuration + Playtomic integration credentials. One row per
/// Company that has the PADEL module. The Playtomic API key is encrypted at
/// rest via lib/crypto (enc:v1:… envelope) — never stored or logged in plain.
model PadelClubConfig {
  id        String   @id @default(cuid())
  companyId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Playtomic Manager → Settings → Developer Tools (External API credentials).
  playtomicTenantId   String? // the club's tenant/venue id in Playtomic
  playtomicApiKey     String?   @db.Text // encrypted(api key)
  playtomicEnabled    Boolean   @default(false)
  lastPlaytomicSyncAt DateTime?

  // Default IVA rate applied to court rentals / academy fees (0.16 = 16%).
  // 0 when the activity is exempt or the club bills IVA-incluido elsewhere.
  ivaRate Float @default(0.16)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Court {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nombre     String // e.g. "Cancha 1", "Central"
  superficie String? // e.g. "césped sintético", "cristal"
  techada    Boolean @default(false) // indoor (techada) vs outdoor
  activa     Boolean @default(true)

  // Maps to the Playtomic "resource"/court id so synced bookings land on the
  // right court. Null until the club links this court in Playtomic.
  playtomicResourceId String?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@unique([companyId, nombre])
  @@index([companyId, activa])
}

/// A club member / customer who can log into the satellite to book courts.
/// This is a B2C identity DISTINCT from the accounting `User`/`CompanyMember`
/// (staff) — members have their own hashed password and a parallel token flow
/// (POST /api/padel/auth/*, audience "theclubpadel:member"). Optionally linked
/// to a fiscal `Customer` when the member requests CFDI invoicing.
model ClubMember {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  email        String
  passwordHash String
  nombre       String
  telefono     String?
  activo       Boolean @default(true)

  // Optional link to the fiscal Customer used when invoicing this member.
  customerId String?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reservations Reservation[]

  @@unique([companyId, email])
  @@index([companyId, activo])
}

model Reservation {
  id        String   @id @default(cuid())
  companyId String
  courtId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inicio DateTime
  fin    DateTime

  estado ReservationEstado @default(CONFIRMADA)
  canal  ReservationCanal  @default(STAFF)

  // Who booked it. A member booking sets clubMemberId; a staff booking sets
  // bookedByUserId (the accounting User id, stored flat — no FK, mirrors the
  // `aprobadoPor` pattern in the construccion module). clienteNombre captures
  // walk-ins booked at the front desk without a member account.
  clubMemberId   String?
  bookedByUserId String?
  clienteNombre  String?

  // Playtomic two-way sync. Set when the booking originated in / was pushed to
  // Playtomic. Unique per company so re-running the sync is idempotent
  // (Postgres allows many NULLs in a unique index, so native-only bookings are
  // unaffected).
  playtomicBookingId String?

  // Pricing + collection. precio is the total charged for the slot; subtotal/iva
  // are filled when the slot is charged (see postCourtRentalRevenue).
  precio    Float                 @default(0)
  pagado    Boolean               @default(false)
  formaPago ReservationFormaPago?
  cobradoAt DateTime?

  // Bank reconciliation when cobrado por transferencia/tarjeta.
  bankTransactionId String? @unique

  // Set when the pre-game push reminder has been sent, so the reminders cron
  // never double-notifies a single reservation.
  recordatorioEnviadoAt DateTime?

  notas String?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  court           Court            @relation(fields: [courtId], references: [id], onDelete: Cascade)
  clubMember      ClubMember?      @relation(fields: [clubMemberId], references: [id], onDelete: SetNull)
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])

  @@unique([companyId, playtomicBookingId])
  @@index([companyId, inicio])
  @@index([courtId, inicio])
  @@index([clubMemberId, inicio])
}

enum ReservationEstado {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
  NO_SHOW
}

enum ReservationCanal {
  APP // booked by a member in the satellite
  STAFF // booked at the front desk
  PLAYTOMIC // imported from Playtomic
}

enum ReservationFormaPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CORTESIA
  CUENTA // on account (cuenta por cobrar)
}

// ─── Module: Restaurante — RestauranteOS ─────────────────────────────────────
//
// Gated behind CompanyModule(modulo = RESTAURANTE). Satellite app
// "restauranteos" (React/Vite SPA) renders the UI; all data + auth +
// accounting live here in the hub. Every table is scoped by companyId so
// cross-tenant reads are impossible. v1 covers:
//   • Insumos con costo promedio móvil e inventario (stock / stock mínimo)
//   • Compras a proveedores (ciclo ORDENADA → RECIBIDA → PAGADA) que
//     alimentan inventario, costo promedio y el libro (ver postings.ts)
//   • Menú con categorías y recetas → costeo teórico y margen por platillo
//   • Comandas (mesa / llevar / domicilio) con flujo de cocina por partida
//   • Money-loop de cobro: ingresos A&B + IVA + propinas (pasivo) + costo de
//     venta teórico con descarga de inventario
// La facturación CFDI reutiliza POST /api/facturas (Facturapi, bearer-aware);
// la orden queda ligada al Invoice timbrado vía invoiceId.

/// Configuración por restaurante. Una fila por Company con módulo RESTAURANTE.
model RestauranteConfig {
  id        String   @id @default(cuid())
  companyId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // IVA aplicado a la venta de alimentos y bebidas (0.16). Los precios del
  // menú son IVA-incluido (costumbre mexicana); al cobrar se desglosan.
  ivaRate Float @default(0.16)

  // Número de mesas del piso; alimenta el selector del POS (0 = texto libre).
  numMesas Int @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum RestUnidad {
  KG
  G
  L
  ML
  PZA
}

/// Ingrediente / insumo de almacén. El costo promedio móvil se recalcula al
/// RECIBIR cada compra: (stock*costoPromedio + qty*costo) / (stock + qty).
/// El stock se descarga al cobrar órdenes según las recetas (puede quedar
/// negativo — señal de recetas o capturas incompletas, se resalta en UI).
model RestInsumo {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nombre    String
  categoria String? // "Carnes", "Abarrotes", "Lácteos", …
  unidad    RestUnidad @default(PZA)

  costoPromedio Float @default(0) // por unidad, sin IVA
  stock         Float @default(0)
  stockMinimo   Float @default(0)

  activo Boolean @default(true)

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recetas     RestReceta[]
  compraItems RestCompraItem[]

  @@unique([companyId, nombre])
  @@index([companyId, activo])
}

enum RestCompraEstado {
  BORRADOR
  ORDENADA
  RECIBIDA
  PAGADA
  CANCELADA
}

enum RestFormaPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
}

/// Orden de compra a proveedor. Recibir descarga los items al inventario y
/// postea DR almacén + IVA acreditable / CR acreedores; pagar postea
/// DR acreedores / CR caja-bancos (ver postings.ts). El IVA se captura
/// explícito porque muchos insumos alimentarios son tasa 0%.
model RestCompra {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folio      String // "OC-0001", consecutivo por empresa
  supplierId String?
  estado     RestCompraEstado @default(ORDENADA)
  fecha      DateTime         @default(now())

  subtotal Float @default(0) // Σ items.importe, sin IVA
  iva      Float @default(0) // capturado explícito (insumos tasa 0% abundan)

  notas String?

  recibidaAt DateTime?

  pagadaAt          DateTime?
  formaPago         RestFormaPago?
  bankAccountId     String?
  bankTransactionId String?        @unique

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier        Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  items           RestCompraItem[]

  @@unique([companyId, folio])
  @@index([companyId, estado])
  @@index([companyId, fecha])
}

model RestCompraItem {
  id       String @id @default(cuid())
  compraId String
  insumoId String

  cantidad      Float
  costoUnitario Float // sin IVA, por unidad del insumo
  importe       Float // cantidad * costoUnitario

  compra RestCompra @relation(fields: [compraId], references: [id], onDelete: Cascade)
  insumo RestInsumo @relation(fields: [insumoId], references: [id])

  @@index([compraId])
  @@index([insumoId])
}

model RestMenuCategoria {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())

  nombre String
  orden  Int     @default(0)
  activa Boolean @default(true)

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   RestMenuItem[]

  @@unique([companyId, nombre])
  @@index([companyId, activa])
}

enum RestEstacion {
  COCINA
  BARRA
  POSTRES
}

/// Platillo / bebida del menú. `precio` es al público, IVA incluido. El costo
/// teórico = Σ receta.cantidad * insumo.costoPromedio se calcula al vuelo (no
/// se persiste aquí) y se congela por partida al cobrar cada orden.
model RestMenuItem {
  id          String   @id @default(cuid())
  companyId   String
  categoriaId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nombre      String
  descripcion String?

  precio Float // precio al público, IVA incluido

  // Claves SAT para facturar (CFDI 4.0): 90101500 = establecimientos para
  // comer y beber; E48 = unidad de servicio.
  claveProdServ String @default("90101500")
  claveUnidad   String @default("E48")

  // Estación del KDS a la que se enrutan las partidas de este platillo.
  estacion RestEstacion @default(COCINA)

  activo     Boolean @default(true) // en catálogo
  disponible Boolean @default(true) // toggle del día ("86")

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoria  RestMenuCategoria? @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  receta     RestReceta[]
  ordenItems RestOrdenItem[]

  @@unique([companyId, nombre])
  @@index([companyId, activo])
}

/// Línea de receta: cuánto insumo consume UNA unidad del platillo.
model RestReceta {
  id         String @id @default(cuid())
  menuItemId String
  insumoId   String
  cantidad   Float // en la unidad del insumo

  menuItem RestMenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  insumo   RestInsumo   @relation(fields: [insumoId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, insumoId])
}

enum RestOrdenTipo {
  MESA
  LLEVAR
  DOMICILIO
}

enum RestOrdenEstado {
  ABIERTA
  COBRADA
  CANCELADA
}

enum RestItemEstado {
  PENDIENTE
  EN_PREPARACION
  LISTO
  ENTREGADO
  CANCELADO
}

enum RestOrdenFormaPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CORTESIA
}

/// Comanda. Los importes se congelan al cobrar (precios IVA-incluido → se
/// desglosan con RestauranteConfig.ivaRate). La propina NO es ingreso: se
/// postea como pasivo (2107 Propinas por pagar). CORTESIA no postea nada.
model RestOrden {
  id        String   @id @default(cuid())
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folio         Int
  tipo          RestOrdenTipo @default(MESA)
  mesa          String?
  comensales    Int?
  clienteNombre String?
  notas         String?

  // Mesero/cajero que levantó la orden (User id plano, sin FK — mismo patrón
  // que Reservation.bookedByUserId).
  meseroUserId String?

  estado RestOrdenEstado @default(ABIERTA)

  subtotal   Float @default(0)
  iva        Float @default(0)
  total      Float @default(0) // subtotal + iva (sin propina)
  propina    Float @default(0)
  costoTotal Float @default(0) // costo teórico (recetas) congelado al cobrar

  formaPago         RestOrdenFormaPago?
  cobradaAt         DateTime?
  bankAccountId     String?
  bankTransactionId String?             @unique

  // Facturación CFDI: cliente fiscal + factura timbrada vía POST /api/facturas.
  customerId String?
  invoiceId  String? @unique

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoice         Invoice?         @relation(fields: [invoiceId], references: [id])
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  items           RestOrdenItem[]

  @@unique([companyId, folio])
  @@index([companyId, estado])
  @@index([companyId, createdAt])
}

/// Partida de la comanda. `estadoCocina` es el flujo del KDS; `precioUnitario`
/// se congela al agregar (el menú puede cambiar de precio después);
/// `costoUnitario` se congela al cobrar la orden.
model RestOrdenItem {
  id         String   @id @default(cuid())
  ordenId    String
  menuItemId String
  createdAt  DateTime @default(now())

  cantidad       Float
  precioUnitario Float // IVA incluido, congelado al agregar
  notas          String? // "sin cebolla", "término medio"

  estacion     RestEstacion   @default(COCINA)
  estadoCocina RestItemEstado @default(PENDIENTE)
  listoAt      DateTime?

  costoUnitario Float @default(0) // costo teórico congelado al cobrar

  orden    RestOrden    @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  menuItem RestMenuItem @relation(fields: [menuItemId], references: [id])

  @@index([ordenId])
  @@index([menuItemId])
  @@index([estadoCocina])
}

// ── Chat del asistente IA (persistencia + hilos) ──────────────────────────────
// Visibilidad por conversación: PRIVATE = sólo el dueño; COMPANY = todo el equipo
// de la empresa la ve (y puede continuarla) — tipo grupo de WhatsApp.
enum ChatVisibility {
  PRIVATE
  COMPANY
}

model ChatConversation {
  id         String         @id @default(cuid())
  companyId  String
  userId     String // dueño (creador)
  title      String         @default("Nueva conversación")
  visibility ChatVisibility @default(PRIVATE)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  archivedAt DateTime?

  // Acción reversible PROPUESTA por el asistente y PENDIENTE de confirmación
  // humana (el usuario toca "Confirmar"). El modelo nunca ejecuta directo: sólo
  // STAGEA aquí (resumen + payload + TTL de un solo uso). Ver
  // src/lib/ai/pending-action.ts. null = sin acción pendiente.
  pendingAction Json?

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([companyId, visibility, updatedAt])
  @@index([userId, updatedAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String   @db.Text
  // Autor del mensaje (para conversaciones compartidas). Null = asistente (IA).
  authorId       String?
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// Plan/tier comercial de una empresa. El gating de COGS (Syntage, banco,
// WhatsApp) se deriva de aquí — ver src/lib/planes.ts.
enum CompanyPlan {
  ASISTENTE // CFDIs + IA (sin Syntage, sin banco, sin WhatsApp) — COGS ~0
  AUTOMATIZADO // + Syntage: opinión/CSF/declaraciones (sin banco ni WhatsApp)
  PRO // + conciliación bancaria (Belvo) + WhatsApp (Twilio)
  DESPACHO // + revisión humana / SLA
}

// Bitácora de seguridad (append-only). Registra eventos sensibles: timbrado y
// cancelación de CFDI, dispersión de nómina, cambios de credenciales (FIEL/CSD/
// llave de Facturapi), altas/bajas de miembros, acciones confirmadas del
// asistente de IA y bajas de empresa/cuenta.
//
// DELIBERADAMENTE sin relación (FK) hacia Company ni User: la bitácora debe
// SOBREVIVIR a la eliminación de la empresa o de la cuenta. Un onDelete:
// Cascade borraría el rastro justo cuando más importa (baja de empresa), y un
// FK con Restrict impediría la baja. companyId/userId son columnas planas.
//
// `detalle` es SOLO metadatos (RFC, total, uuid, motivo...). NUNCA guardar
// secretos: contraseñas, llaves privadas, .key/.cer, tokens ni API keys.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  companyId  String? // sin FK a propósito — ver comentario del modelo
  userId     String? // sin FK a propósito — ver comentario del modelo
  actorEmail String?
  accion     String // kebab-case corto, p. ej. "factura.timbrar"
  entidad    String? // nombre del modelo afectado, p. ej. "Invoice"
  entidadId  String?
  detalle    Json? // sólo metadatos, nunca secretos
  ip         String?

  @@index([companyId, createdAt])
  @@index([accion, createdAt])
}

// Refresh tokens opacos para la API de satélites (flujo access corto + refresh
// rotatorio). Se guarda SOLO el SHA-256 del secreto (nunca el secreto en claro).
// La rotación encadena filas vía replacedById; presentar un token ya rotado o
// revocado se trata como robo y revoca la cadena completa (detección estándar
// de reutilización). Sin FK-cascade hacia AuditLog: la bitácora registra
// emisión/revocación por separado.
model ApiRefreshToken {
  id           String    @id @default(cuid())
  tokenHash    String    @unique // SHA-256 (hex) del secreto opaco
  userId       String
  etiqueta     String // satélite emisor (body `cliente` o User-Agent)
  scope        String? // scopes separados por espacio; null = acceso total
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String? // id del token que lo sustituyó al rotar
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  ip           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Candado de crons (single-flight, seguro ante el pool de conexiones) ──────

// Mutex por trabajo para los crons mutantes. Una fila por `job`; `lockedAt`
// marca cuándo la tomó la corrida en curso. La adquisición es un compare-and-set
// atómico sobre `lockedAt` condicionado a que el candado esté libre o vencido
// (TTL > maxDuration), así un crash que no liberó no deja el cron trabado. A
// diferencia de un advisory lock de sesión, NO depende de la afinidad de
// conexión del pool de Prisma. Ver src/lib/cron-lock.ts.
model CronLock {
  job      String   @id
  lockedAt DateTime
}
