// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed, null if OAuth only
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Subscription / trial — billing-per-RFC, sub lives on the account owner
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt        DateTime?
  // Stripe (filled in when phase 5 lands)
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique
  currentPeriodEnd     DateTime?

  accounts      Account[]
  sessions      Session[]
  memberships   CompanyMember[]
  // Despacho membership — each user belongs to at most ONE despacho.
  // Companies owned by the despacho are automatically visible to all members.
  // Per-company CompanyMember rows are still used for one-off access grants
  // to users outside the owning despacho.
  despachoMemberships DespachoMember[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Companies (Multi-tenant core) ───────────────────────────────────────────

model Company {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Despacho that owns this company. All despacho members have implicit ADMIN
  // access. Nullable for backwards-compat with companies created before the
  // despacho model was introduced; backfilled by the migration script.
  despachoId        String?
  despacho          Despacho? @relation(fields: [despachoId], references: [id], onDelete: SetNull)

  // SAT / fiscal data
  rfc               String   @unique
  razonSocial       String
  regimenFiscal     String   // e.g. "601" = General de Ley Personas Morales
  codigoPostal      String
  domicilioFiscal   String?

  // Contact / additional info
  nombreComercial   String?
  email             String?
  telefono          String?
  actividadEconomica String? // SCIAN code description

  // CSD — Certificado de Sello Digital (for CFDI stamping)
  csdCer            String?  @db.Text  // base64 encoded .cer file
  csdKey            String?  @db.Text  // base64 encoded .key file
  csdPassword       String?            // encrypted password
  csdVigencia       DateTime?          // expiry date

  // e.firma / FIEL (for SAT declarations)
  fielCer           String?  @db.Text  // base64 encoded .cer file
  fielKey           String?  @db.Text  // base64 encoded .key file
  fielPassword      String?            // encrypted password
  fielVigencia      DateTime?          // expiry date

  // Facturapi integration
  facturapiOrgId    String?  // Facturapi organization ID for this company
  facturapiApiKey   String?  // live API key stored encrypted

  // Logo / branding
  logoUrl           String?

  // ISR — Coeficiente de utilidad (Art. 14 LISR) set once per fiscal year
  coeficienteUtilidad Float?  // Stored after user confirms/overrides auto-calculation
  coeficienteAnio     Int?    // Which fiscal year this coeficiente applies to

  // Nómina — IMSS registro patronal (required for CFDI nómina emisor block)
  registroPatronal String?  // e.g. "A7025105103"

  isActive          Boolean  @default(true)

  // Relations
  members           CompanyMember[]
  invoices          Invoice[]
  customers         Customer[]
  suppliers         Supplier[]
  bankAccounts      BankAccount[]
  bankTransactions  BankTransaction[]
  employees         Employee[]
  payrollRuns       PayrollRun[]
  taxDeclarations   TaxDeclaration[]
  obligations       CompanyObligation[]
  accountingEntries AccountingEntry[]
  accounts          ChartAccount[]
  accountingPeriods AccountingPeriod[]
  satSyncRequests   SatSyncRequest[]

  // Module gating (SaaS): which features this company has contracted
  modules           CompanyModule[]

  // Construction module (only used when CONSTRUCCION is enabled)
  proyectos         Proyecto[]
  conceptos         Concepto[]
  apus              APU[]
  insumos           Insumo[]
  presupuestos      Presupuesto[]
  estimaciones      Estimacion[]
  solicitudesCompra SolicitudCompra[]
  pagos             Pago[]
  imssMovimientos   ImssMovimiento[]
  incidencias       Incidencia[]

  // CONSTRUCCION_CUADRILLAS add-on (only populated when that module is enabled)
  cuadrillas        Cuadrilla[]
  rayas             RayaSemanal[]

  // Gastos (Katia's validation + pay workflow for Bartiz field expenses)
  gastos            Gasto[]
  reembolsos        ReembolsoSemanal[]

  // Despacho per-company scoping junction
  despachoMemberScopes DespachoMemberCompany[]
}

model CompanyMember {
  id        String      @id @default(cuid())
  userId    String
  companyId String
  role      MemberRole  @default(VIEWER)
  createdAt DateTime    @default(now())

  /// Per-user module restriction. Empty array = full access to every module
  /// the company has enabled (backwards-compatible default). Non-empty =
  /// this user can ONLY see/use the listed modules on this company, even if
  /// the company itself has more modules enabled.
  ///
  /// Use case: a construction PM (Rosy) should only access CONSTRUCCION
  /// on CONSTRUCTORA BARTIZ-VERT — not the accounting CFDI / bancos /
  /// nómina modules. Set allowedModules = ["CONSTRUCCION"].
  ///
  /// Enforced in THREE places:
  ///   1. /api/auth/token + /api/companies: filters the `modulos` array in
  ///      the login response so satellite apps only see the allowed subset
  ///   2. requireModule(companyId, modulo, req): 403s if the module isn't in
  ///      the user's allowed set for that company
  ///   3. (app)/layout.tsx: redirects users with no CONTABILIDAD access away
  ///      from the contabilidad-os web UI entirely
  allowedModules ModuloApp[] @default([])

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

enum MemberRole {
  OWNER
  ADMIN
  ACCOUNTANT
  VIEWER
}

// ─── Despacho (multi-user organization) ─────────────────────────────────────
//
// A Despacho groups users under one "agency / firma contable" umbrella.
// All companies owned by a despacho are automatically visible to every
// despacho member; no per-company invitation needed.
//
// Roles inside the despacho:
//   OWNER      — full control, incl. inviting users + deleting the despacho
//   ADMIN      — full control except delete despacho
//   ACCOUNTANT — can view/edit all despacho companies but can't manage users
//
// Despacho membership is IN ADDITION to per-company CompanyMember rows. A
// user outside the owning despacho can still be given specific company access
// via the existing CompanyMember flow — this covers edge cases like "external
// contador gets read-only access to one company".
model Despacho {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   DespachoMember[]
  companies Company[]
}

model DespachoMember {
  id         String       @id @default(cuid())
  despachoId String
  userId     String
  role       DespachoRole @default(ACCOUNTANT)
  createdAt  DateTime     @default(now())

  despacho Despacho @relation(fields: [despachoId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Per-company scoping: if this member has DespachoMemberCompany rows,
  // they can ONLY access those companies. If they have ZERO rows, they
  // get access to ALL despacho companies (backwards-compatible default).
  companyScopes DespachoMemberCompany[]

  @@unique([userId, despachoId])
  // A user belongs to at most one despacho — enforced by unique(userId)
  // so we can't accidentally double-enroll. Remove this if you ever need
  // multi-despacho users.
  @@unique([userId])
}

// Per-company access scoping within a despacho. When a DespachoMember has
// rows here, they can only access those specific companies. When they have
// NO rows, they get access to all despacho companies (default/owner behavior).
model DespachoMemberCompany {
  id               String @id @default(cuid())
  despachoMemberId String
  companyId        String
  createdAt        DateTime @default(now())

  member  DespachoMember @relation(fields: [despachoMemberId], references: [id], onDelete: Cascade)
  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([despachoMemberId, companyId])
}

enum DespachoRole {
  OWNER
  ADMIN
  ACCOUNTANT
}

// ─── Module gating (SaaS) ────────────────────────────────────────────────────
// Tracks which product modules each Company has contracted. CONTABILIDAD is
// the base product and is enabled for every new company. Add-ons (CONSTRUCCION,
// FLOTA, etc.) are enabled manually or via Stripe webhook on add-on purchase.

model CompanyModule {
  id           String    @id @default(cuid())
  companyId    String
  modulo       ModuloApp
  habilitado   Boolean   @default(true)
  habilitadoAt DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, modulo])
}

enum ModuloApp {
  CONTABILIDAD
  CONSTRUCCION
  CONSTRUCCION_CUADRILLAS
  FLOTA
  MARKETING
}

// ─── Module 3: Invoicing / CFDI ───────────────────────────────────────────────

model Customer {
  id           String   @id @default(cuid())
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rfc          String
  razonSocial  String
  regimenFiscal String
  email        String?
  phone        String?
  domicilio    String?
  codigoPostal String?

  // Facturapi customer ID
  facturapiId  String?

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices Invoice[]
  proyectos Proyecto[]

  @@unique([companyId, rfc])
}

model Supplier {
  id           String   @id @default(cuid())
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rfc          String
  razonSocial  String
  regimenFiscal String?
  email        String?

  // Datos bancarios para enviar SPEIs. CLABE es el dato canónico (18 dígitos);
  // `banco` y `cuentaBancaria` son auxiliares cuando el proveedor proporciona
  // sólo cuenta interbancaria. `titularCuenta` cubre el caso donde la cuenta
  // está a nombre de un tercero (común con personas físicas que facturan a
  // otro RFC).
  clabe         String?
  banco         String?
  cuentaBancaria String?
  titularCuenta String?

  company              Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankTransactions     BankTransaction[]
  solicitudesCompra    SolicitudCompra[]
  cotizaciones         SolicitudCompraCotizacion[]

  @@unique([companyId, rfc])
}

model Invoice {
  id           String        @id @default(cuid())
  companyId    String
  customerId   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // CFDI data
  tipo         InvoiceType   // INGRESO, EGRESO, TRASLADO, NOMINA, PAGO
  serie        String?
  folio        String?
  fecha        DateTime
  formaPago    String        // SAT catalog key e.g. "01" = Efectivo
  metodoPago   String        // "PUE" or "PPD"
  usoCfdi      String        // SAT catalog key e.g. "G01"
  moneda       String        @default("MXN")
  tipoCambio   Float         @default(1.0)
  subtotal     Float
  descuento    Float         @default(0)
  totalImpuestos Float       @default(0)
  total        Float
  notas        String?

  // Contador override: if set, the posting engine uses this SAT account
  // instead of whatever classifyInvoice() would return. Stores the short
  // code like "601.15" — must match a ChartAccount in the catalog.
  overrideCuenta String?

  // SAT stamping data (from PAC/Facturapi)
  status       InvoiceStatus @default(DRAFT)
  uuid         String?       @unique // Folio fiscal
  facturapiId  String?       // Facturapi invoice ID
  xmlUrl       String?
  pdfUrl       String?
  cadenaOriginal String?     @db.Text
  selloSAT     String?       @db.Text
  selloCFD     String?       @db.Text

  // Provenance: which product module created this invoice. NULL = generic/manual.
  origenModulo ModuloApp?

  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer?        @relation(fields: [customerId], references: [id])
  items            InvoiceItem[]
  taxes            InvoiceTax[]
  bankTransactions BankTransaction[]
  estimacion       Estimacion?
}

model InvoiceItem {
  id           String  @id @default(cuid())
  invoiceId    String
  cantidad     Float
  claveUnidad  String  // SAT catalog key e.g. "E48"
  unidad       String?
  claveProdServ String // SAT product/service catalog key
  descripcion  String
  valorUnitario Float
  importe      Float
  descuento    Float   @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model InvoiceTax {
  id        String   @id @default(cuid())
  invoiceId String
  tipo      TaxType  // IVA, ISR, IEPS
  factor    TaxFactor // TASA, CUOTA, EXENTO
  tasa      Float
  importe   Float
  retencion Boolean  @default(false)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

enum InvoiceType {
  INGRESO
  EGRESO
  TRASLADO
  NOMINA
  PAGO
}

enum InvoiceStatus {
  DRAFT
  STAMPED    // timbrado
  CANCELLED
}

enum TaxType {
  IVA
  ISR
  IEPS
}

enum TaxFactor {
  TASA
  CUOTA
  EXENTO
}

// ─── Module 4: Bank Reconciliation ───────────────────────────────────────────

model BankAccount {
  id           String   @id @default(cuid())
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  banco        String   // e.g. "BBVA", "Banamex", "Santander"
  nombre       String   // friendly name
  numeroCuenta String
  clabe        String?
  moneda       String   @default("MXN")

  // CHEQUES = main operating account; TARJETA_DEPARTAMENTAL = debit card
  // handed to a specific person (GDCS, Esteban…) whose CSV gets imported
  // separately; CAJA = petty cash fund held by a field PM (Rosy's $5k caja chica).
  tipo         BankAccountTipo @default(CHEQUES)
  titular      String?         // free-text cardholder / account owner name

  // Belvo / open banking
  belvoAccountId String?
  belvoLinkId    String?

  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]
  gastos       Gasto[]
  reembolsos   ReembolsoSemanal[]

  @@unique([companyId, numeroCuenta])
}

enum BankAccountTipo {
  CHEQUES
  TARJETA_DEPARTAMENTAL
  CAJA
}

model BankTransaction {
  id             String              @id @default(cuid())
  companyId      String
  bankAccountId  String
  createdAt      DateTime            @default(now())

  fecha          DateTime
  descripcion    String
  referencia     String?
  monto          Float               // positive = credit, negative = debit
  saldo          Float?
  tipo           BankTransactionType

  // Reconciliation
  status         ReconciliationStatus @default(UNMATCHED)
  invoiceId      String?
  supplierId     String?
  notes          String?

  // Source
  source         String              @default("UPLOAD") // UPLOAD or BELVO
  belvoId        String?             @unique // Belvo transaction ID (for dedup)
  belvoCategory  String?             // Belvo auto-category (e.g. "Bills & Utilities")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  supplier    Supplier?   @relation(fields: [supplierId], references: [id])
  invoice     Invoice?    @relation(fields: [invoiceId], references: [id])
  rayaPagada              RayaSemanal?
  gastoPagado             Gasto?
  reembolsoPagado         ReembolsoSemanal?
  solicitudCompraPagada   SolicitudCompra?
}

enum BankTransactionType {
  CREDITO
  DEBITO
}

enum ReconciliationStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

// ─── Module 2: Nómina & IMSS ──────────────────────────────────────────────────

model Employee {
  id               String          @id @default(cuid())
  companyId        String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  nombre           String
  apellidoPaterno  String
  apellidoMaterno  String?
  rfc              String
  curp             String
  nss              String          // Número de Seguridad Social
  email            String?
  fechaIngreso     DateTime
  fechaBaja        DateTime?
  isActive         Boolean         @default(true)

  // Contract
  tipoContrato     String          // e.g. "01" = Indefinido
  tipoJornada      String          // e.g. "01" = Diurna
  tipoRegimen      String          @default("02")  // "02" = Sueldos, "05" = Asimilados
  salarioDiario    Float           // SBC for IMSS
  salarioDiarioIntegrado Float?    // SDI
  periodicidadPago String          // "04" = Quincenal, "05" = Mensual
  numEmpleado      String?         // Internal employee number; defaults to short id
  departamento     String?
  puesto           String?
  riesgoPuesto     String          @default("1")  // 1=Class I, 2=II, 3=III, 4=IV, 5=V
  claveEntFed      String          @default("PUE") // Estado SAT code (PUE, JAL, CMX, etc.)

  // INFONAVIT
  creditoInfonavit       String?
  tipoDescuentoInfonavit String?  // "PCT_SBC" | "VSM" | "PESOS"
  descuentoInfonavit     Float?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollItems     PayrollItem[]
  imssMovimientos  ImssMovimiento[]
  incidencias      Incidencia[]
  cuadrillaMiembros CuadrillaMiembro[]

  @@unique([companyId, rfc])
}

// Incidencias — absences, overtime, sick leave, permits that affect payroll
model Incidencia {
  id          String          @id @default(cuid())
  companyId   String
  employeeId  String
  createdAt   DateTime        @default(now())

  tipo        IncidenciaTipo
  fecha       DateTime        // Date of the incident
  fechaFin    DateTime?       // End date for multi-day (incapacidad, vacaciones)
  dias        Float           @default(1) // Number of days affected
  horas       Float?          // For overtime: number of extra hours

  // Incapacidad-specific
  folioImss   String?         // IMSS disability folio number
  ramoImss    String?         // "01"=Riesgo trabajo, "02"=Enfermedad, "03"=Maternidad

  notas       String?
  periodo     String?         // e.g. "2026-04" — linked to payroll period

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId, periodo])
  @@index([employeeId, fecha])
}

enum IncidenciaTipo {
  FALTA               // Absence (unjustified)
  FALTA_JUSTIFICADA   // Justified absence
  INCAPACIDAD         // IMSS disability leave
  PERMISO_CON_GOCE    // Paid leave
  PERMISO_SIN_GOCE    // Unpaid leave
  HORAS_EXTRA         // Overtime
  VACACIONES          // Vacation days taken
  RETARDO             // Late arrival
}

// IMSS Movimientos Afiliatorios — auto-detected from employee changes
model ImssMovimiento {
  id          String   @id @default(cuid())
  companyId   String
  employeeId  String
  createdAt   DateTime @default(now())

  tipo        ImssMovimientoTipo  // ALTA, BAJA, MODIFICACION_SALARIO, REINGRESO
  fechaMovimiento DateTime        // When the movement should be effective
  sbcAnterior     Float?          // Previous SBC (for modifications)
  sbcNuevo        Float?          // New SBC
  motivo          String?         // Reason text

  // Filing status
  status      ImssMovimientoStatus @default(PENDING)
  filedAt     DateTime?           // When it was filed with IMSS
  idseConfirmation String?        // IDSE confirmation number

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([companyId, status])
}

enum ImssMovimientoTipo {
  ALTA
  BAJA
  MODIFICACION_SALARIO
  REINGRESO
}

enum ImssMovimientoStatus {
  PENDING    // Needs to be filed
  EXPORTED   // Included in an IDSE export
  FILED      // Filed with IMSS
  REJECTED   // IMSS rejected it
}

model PayrollRun {
  id          String          @id @default(cuid())
  companyId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  periodo     String          // e.g. "2024-01-01/2024-01-15"
  fechaPago   DateTime
  tipo        PayrollRunType  // ORDINARIA, EXTRAORDINARIA, FINIQUITO, AGUINALDO
  status      PayrollStatus   @default(DRAFT)

  totalPercepciones Float     @default(0)
  totalDeducciones  Float     @default(0)
  totalNeto         Float     @default(0)

  // Type-specific data (e.g. { utilidadFiscalGravable } for PTU,
  // { diasAguinaldo, fechaCorte } for AGUINALDO)
  extraData         Json?

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items    PayrollItem[]
}

model PayrollItem {
  id           String  @id @default(cuid())
  payrollRunId String
  employeeId   String

  // Percepciones
  sueldoBase   Float
  horasExtra   Float   @default(0)
  bonosPagoFijo Float  @default(0)
  bonosPagoVar Float   @default(0)
  vales        Float   @default(0)
  otrasPercepciones Float @default(0)

  // Deducciones
  isrRetenido    Float   @default(0)
  imssObrero     Float   @default(0)
  imssPatronal   Float   @default(0)  // Informational (employer cost, not deducted from employee)
  infonavit      Float   @default(0)
  otrasDeducc    Float   @default(0)

  // Extraordinary percepciones (aguinaldo, vacaciones, PTU)
  aguinaldo        Float   @default(0)
  primaVacacional  Float   @default(0)
  vacaciones       Float   @default(0)
  ptu              Float   @default(0)

  totalPercepciones Float
  totalDeducciones  Float
  netoAPagar        Float

  // CFDI nómina
  cfdiUuid     String?
  facturapiId  String?

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id])
}

enum PayrollRunType {
  ORDINARIA
  EXTRAORDINARIA
  FINIQUITO
  AGUINALDO
  VACACIONES
  PTU
}

enum PayrollStatus {
  DRAFT
  CALCULATED
  STAMPED
  PAID
}

// ─── Module 1: Tax Declarations ───────────────────────────────────────────────

// Tax declarations. Created organically when the app computes a period,
// or bulk-imported as historical baseline (isHistorical=true) during
// onboarding via the AI wizard so contadores starting mid-year don't lose
// the carryover of IVA saldos a favor and ISR provisional pagado.
model TaxDeclaration {
  id            String             @id @default(cuid())
  companyId     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tipo          TaxDeclarationType // IVA_MENSUAL, ISR_PROVISIONAL, DIOT, ANUAL
  periodo       String             // e.g. "2024-01" or "2024"
  status        DeclarationStatus  @default(DRAFT)

  // IVA
  ivaTrasladadoCobrado  Float?
  ivaAcreditableGastado Float?
  ivaSaldoFavor         Float?
  ivaPagar              Float?
  ivaSaldoFavorAnterior Float?   // Carryover from previous months

  // ISR
  isrIngresos           Float?
  isrDeducciones        Float?
  isrBaseGravable       Float?
  isrTasa               Float?
  isrPagar              Float?
  isrCoeficienteUtilidad Float?  // Coeficiente asignado por el SAT del ejercicio anterior

  // DIOT
  diotXmlUrl            String?

  // Presentación
  acuseUrl              String?
  lineaCaptura          String?
  fechaPresentacion     DateTime?
  fechaLimitePago       DateTime?

  // True when the declaration was imported as a historical baseline during
  // onboarding (from a SAT acuse PDF). These rows are treated normally by
  // the carryover logic (saldo a favor, ISR pagado anterior) but are
  // visually marked in the UI and excluded from "periodos pendientes de
  // cierre" lists.
  isHistorical          Boolean  @default(false)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Tracks which fiscal obligations each company has (derived from régimen or parsed from CSF)
model CompanyObligation {
  id            String   @id @default(cuid())
  companyId     String
  tipo          String   // "IVA_MENSUAL" | "ISR_PROVISIONAL" | "DIOT" | "ISR_ANUAL" | etc.
  descripcion   String
  periodicidad  String   // "MENSUAL" | "BIMESTRAL" | "ANUAL"
  diaVencimiento Int     // day of month due (17 for most, 31 for ISR anual PM, 30 for PF)
  mesVencimiento Int?    // for ANUAL: 3 = March (PM), 4 = April (PF)
  activa        Boolean  @default(true)
  fuente        String   @default("REGIMEN") // "REGIMEN" | "CSF"
  desdeAnio     Int?
  desdeMes      Int?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, tipo])
}

enum TaxDeclarationType {
  IVA_MENSUAL
  ISR_PROVISIONAL
  DIOT
  DECLARACION_ANUAL
  CERO
}

enum DeclarationStatus {
  DRAFT
  CALCULATED
  FILED
  PAID
}

// ─── Module 5: Chart of Accounts / COE ────────────────────────────────────────

model ChartAccount {
  id          String   @id @default(cuid())
  companyId   String
  createdAt   DateTime @default(now())

  // SAT COE catalog
  cuentaSAT   String   // e.g. "101"
  subcuenta   String?  // e.g. "101.01"
  nombre      String
  tipo        AccountType // ACTIVO, PASIVO, CAPITAL, INGRESO, GASTO, COSTO
  nivel       Int         @default(1)
  isActive    Boolean     @default(true)

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries  AccountingEntry[]

  @@unique([companyId, cuentaSAT, subcuenta])
}

model AccountingEntry {
  id            String   @id @default(cuid())
  companyId     String
  chartAccountId String
  createdAt     DateTime @default(now())

  fecha         DateTime
  // Posting period (year + month) — denormalized so we can filter/delete
  // entire periods efficiently without a range query over fecha.
  year          Int
  month         Int       // 1-12
  periodId      String?   // FK to AccountingPeriod row
  descripcion   String
  referencia    String?   // e.g. UUID del CFDI, ESTIMACION id, etc.
  referenciaTipo String?  // "CFDI" | "ESTIMACION" | "SOLICITUD_COMPRA" | "BANK_TX" | etc.
  monto         Float
  tipo          EntryType // CARGO, ABONO
  fuente        EntrySource // CFDI, NOMINA, BANCO, MANUAL, CONSTRUCCION, FLOTA

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chartAccount ChartAccount       @relation(fields: [chartAccountId], references: [id])
  period       AccountingPeriod?  @relation(fields: [periodId], references: [id], onDelete: SetNull)

  @@index([companyId, year, month])
}

// Tracks which fiscal months have been posted to the general ledger.
// Monthly posting is a manual step: user clicks "Cerrar mes" → posting
// engine scans all CFDIs and bank txs with fecha in [monthStart, monthEnd]
// and writes the corresponding AccountingEntry rows.
model AccountingPeriod {
  id           String              @id @default(cuid())
  companyId    String
  year         Int
  month        Int                 // 1-12
  status       AccountingPeriodStatus @default(DRAFT)
  postedAt     DateTime?
  postedById   String?
  // Summary counts so the UI can show period health at a glance
  entriesCount Int                 @default(0)
  totalCargos  Float               @default(0)
  totalAbonos  Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entries AccountingEntry[]

  @@unique([companyId, year, month])
}

enum AccountingPeriodStatus {
  DRAFT   // No entries yet (month hasn't been closed)
  POSTED  // Entries generated — can still be deleted and re-posted
  CLOSED  // Officially closed — no more edits (for audit)
}

// ─────────────────────────────────────────────────────────────────────────────
// SAT Descarga Masiva — request lifecycle tracking
//
// Each "Sincronizar con SAT" click creates two SatSyncRequest rows (emitidos
// + recibidos). We persist them so we can:
//   1. Reuse pending requests instead of creating new ones (SAT limits N
//      concurrent requests per RFC — error code 5002 when exceeded)
//   2. Resume polling across page reloads
//   3. Show the user the request history per period
// ─────────────────────────────────────────────────────────────────────────────
model SatSyncRequest {
  id             String              @id @default(cuid())
  companyId      String
  tipo           SatRequestType
  year           Int
  month          Int
  requestId      String              @unique  // SAT's RequestID
  status         SatRequestStatus    @default(PENDING)
  cfdisFound     Int                 @default(0)
  imported       Int                 @default(0)
  lastVerifiedAt DateTime?
  errorMessage   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, year, month, tipo])
}

enum SatRequestType {
  EMITIDOS
  RECIBIDOS
}

enum SatRequestStatus {
  PENDING       // Just submitted, SAT hasn't acknowledged yet
  ACCEPTED      // SAT accepted the request, queued for processing
  IN_PROGRESS   // SAT is preparing the package
  FINISHED      // Packages ready (or empty)
  FAILED        // SAT rejected or our parsing failed
  EXPIRED       // SAT removed the request (>72h typically)
}

enum AccountType {
  ACTIVO
  PASIVO
  CAPITAL
  INGRESO
  GASTO
  COSTO
}

enum EntryType {
  CARGO
  ABONO
}

enum EntrySource {
  CFDI
  NOMINA
  BANCO
  MANUAL
  CONSTRUCCION
  FLOTA
}

// ─── Module 6: Construction Project Management ───────────────────────────────
// Gated behind CompanyModule(modulo = CONSTRUCCION). Tables exist for every
// company but are only populated and exposed in the UI when the module is on.

model Proyecto {
  id            String          @id @default(cuid())
  companyId     String
  customerId    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  codigo        String
  nombre        String
  descripcion   String?
  ubicacion     String?
  tipo          ProyectoTipo    @default(PRIVADO)
  estado        ProyectoEstado  @default(PLANEACION)

  // Government contract metadata
  numeroContrato     String?
  numeroLicitacion   String?
  modalidadContrato  String?  // "OBRA_PUBLICA" | "ADJUDICACION_DIRECTA" | "INVITACION"
  dependenciaCliente String?

  fechaInicio     DateTime?
  fechaFinPlan    DateTime?
  fechaFinReal    DateTime?
  montoContratado Float?
  anticipoPorc    Float?    // typical 30
  retencionPorc   Float?    // typical 5

  // Anticipo tracking — filled when the customer pays the anticipo
  anticipoMonto       Float?     // actual $ received (montoContratado × anticipoPorc / 100)
  anticipoFecha       DateTime?  // date received
  anticipoAmortizado  Float     @default(0)  // running total amortized across estimaciones
  anticipoBankTxId    String?   // link to the BankTransaction that recorded the deposit
  anticipoInvoiceId   String?   // link to the CFDI de anticipo (Invoice)

  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer          Customer?           @relation(fields: [customerId], references: [id])
  presupuestos      Presupuesto[]
  estimaciones      Estimacion[]
  programa          ProgramaActividad[]
  solicitudesCompra SolicitudCompra[]
  bitacora          BitacoraEntrada[]
  pagos             Pago[]
  unidades          UnidadProyecto[]
  cuadrillas        Cuadrilla[]
  rayas             RayaSemanal[]
  gastos            Gasto[]
  reembolsos        ReembolsoSemanal[]

  @@unique([companyId, codigo])
  @@index([companyId, estado])
}

enum ProyectoTipo {
  GOBIERNO
  PRIVADO
  MIXTO
}

enum ProyectoEstado {
  PLANEACION
  EN_EJECUCION
  SUSPENDIDO
  TERMINADO
  CANCELADO
}

// Catálogo de conceptos: master list per company. Each concepto is the
// header of an APU and is reusable across projects.
model Concepto {
  id          String   @id @default(cuid())
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  codigo      String
  descripcion String
  unidad      String   // "m3", "m2", "ton", "pza"
  categoria   String?  // "Preliminares" | "Cimentación" | etc.

  // Pointer to the current/active APU version. Versioning lives on APU.
  apuActualId String?  @unique
  apuActual   APU?     @relation("ConceptoApuActual", fields: [apuActualId], references: [id])

  apus       APU[]                 @relation("ConceptoApus")
  partidas   PresupuestoPartida[]
  usedAsSubAPU APUInsumo[]         @relation("SubAPU")  // where this concepto is referenced as a sub-APU
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, codigo])
}

// Análisis de Precios Unitarios: canonical cost breakdown for one Concepto.
// Versioned: each material edit creates a new APU; conceptos point to current.
model APU {
  id              String   @id @default(cuid())
  companyId       String
  conceptoId      String
  createdAt       DateTime @default(now())
  version         Int      @default(1)

  // Roll-up totals (computed from APUInsumo at write time, validated server-side)
  costoDirecto    Float    // sum of all insumos
  indirectosPorc  Float    @default(0)
  financierosPorc Float    @default(0)
  utilidadPorc    Float    @default(0)
  cargosAdicPorc  Float    @default(0)
  precioUnitario  Float    // final PU after all overhead
  rendimiento     Float    @default(1)  // qty produced per cuadrilla-day

  concepto           Concepto  @relation("ConceptoApus", fields: [conceptoId], references: [id], onDelete: Cascade)
  conceptoComoActual Concepto? @relation("ConceptoApuActual")
  insumos            APUInsumo[]
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([conceptoId, version])
}

// Each line of an APU: a material, labor category, equipment, or basic.
// Each line of an APU references EITHER a raw Insumo (material, labor,
// equipment) OR another Concepto (sub-APU / concepto compuesto).
// Exactly one of insumoId or conceptoRefId must be set.
//
// When conceptoRefId is set:
//   - costoUnitario = the referenced concepto's apuActual.precioUnitario
//   - importe = cantidad × costoUnitario (same formula)
//   - the referenced concepto acts as a reusable building block
//     (e.g. "Mortero 1:3" used inside "Repellado" and "Aplanado")
//   - when the sub-APU's PU changes, the parent APU must be recomputed
//     (handled by the bulk price update and the recompute function)
model APUInsumo {
  id            String  @id @default(cuid())
  apuId         String
  insumoId      String?  // raw insumo reference (mutually exclusive with conceptoRefId)
  conceptoRefId String?  // sub-APU reference (mutually exclusive with insumoId)
  cantidad      Float
  costoUnitario Float    // snapshot at time of APU build
  importe       Float    // = cantidad * costoUnitario
  orden         Int      @default(0)

  apu         APU       @relation(fields: [apuId], references: [id], onDelete: Cascade)
  insumo      Insumo?   @relation(fields: [insumoId], references: [id])
  conceptoRef Concepto? @relation("SubAPU", fields: [conceptoRefId], references: [id])
}

// Master list of inputs: materials, labor categories, equipment, basics.
model Insumo {
  id          String     @id @default(cuid())
  companyId   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  codigo      String
  descripcion String
  tipo        InsumoTipo
  unidad      String
  costoActual Float
  monedaCosto String     @default("MXN")

  // For MANO_OBRA: link to IMSS factor calc inputs
  salarioBase   Float?   // daily base (SBC)
  factorSalario Float?   // SDR factor including IMSS/INFONAVIT/prestaciones

  // For MATERIAL: SAT product key (carries over to CFDI)
  claveProdServ String?
  claveUnidad   String?

  apuLineas APUInsumo[]
  partidas  SolicitudPartida[]
  gastos    Gasto[]
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, codigo])
}

enum InsumoTipo {
  MATERIAL
  MANO_OBRA
  EQUIPO
  HERRAMIENTA
  BASICO
}

// Presupuesto = a project's catálogo de conceptos with quantities.
model Presupuesto {
  id          String   @id @default(cuid())
  companyId   String
  proyectoId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  nombre      String?

  version     Int               @default(1)
  estado      PresupuestoEstado @default(BORRADOR)
  montoTotal  Float             @default(0)

  // Contrato vs Ejecutado distinction.
  // CONTRATO = frozen, customer-signed. Revenue basis. Default for all existing rows.
  // EJECUTADO = living document reflecting actual construction reality.
  tipoPresupuesto  TipoPresupuesto @default(CONTRATO)
  // For EJECUTADO only: FK back to the contrato it was cloned from.
  contratoOrigenId String?
  contratoOrigen   Presupuesto?  @relation("ContratoEjecutado", fields: [contratoOrigenId], references: [id])
  ejecutados       Presupuesto[] @relation("ContratoEjecutado")

  partidas     PresupuestoPartida[]
  estimaciones Estimacion[]
  versiones    PresupuestoVersion[]

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum TipoPresupuesto {
  CONTRATO
  EJECUTADO
}

enum PresupuestoEstado {
  BORRADOR
  APROBADO
  EN_EJECUCION
  CERRADO
  RECHAZADO     // customer chose a different presupuesto in the same proyecto
}

model PresupuestoPartida {
  id              String   @id @default(cuid())
  presupuestoId   String
  // conceptoId is required for LEAF partidas (actual work items) and null
  // for BRANCH partidas (capítulo rollup rows). See esRollup.
  conceptoId      String?
  apuVersion      Int      @default(1) // snapshot of which APU version was used (leaves only)
  cantidad        Float?                // leaves only
  precioUnitario  Float    @default(0)  // leaves only; branches compute from children
  importe         Float    @default(0)  // leaves: cantidad × PU; branches: sum of children
  orden           Int      @default(0)  // global display order within the presupuesto

  // Legacy flat grouping (kept nullable for backwards read-compat during
  // the tree migration). Superseded by parentPartidaId + codigo.
  zona    String?
  partida String?

  // Internal operational notes — not shown to the customer.
  notas   String?    @db.Text

  // Capítulo tree (same pattern as ProgramaActividad).
  // Branches are rollup nodes: esRollup=true, conceptoId=null, cantidad=null.
  // Leaves are real work items: esRollup=false, conceptoId set, cantidad set.
  parentPartidaId String?
  parent          PresupuestoPartida?  @relation("PartidaHierarchy", fields: [parentPartidaId], references: [id])
  hijos           PresupuestoPartida[] @relation("PartidaHierarchy")
  nivel           Int                  @default(0)  // denormalized depth, 0 = root
  codigo          String?                           // dotted path "1.1.3.5" — computed on write
  esRollup        Boolean              @default(false)

  // Optional unidad scope — usually null for template partidas; set when a
  // partida is specific to one depto/torre (e.g. "ventana custom Depto 101").
  unidadProyectoId String?
  unidad           UnidadProyecto? @relation(fields: [unidadProyectoId], references: [id])

  // For ejecutado partidas: FK back to the contrato partida they were
  // cloned from. Enables avance tracking to span contrato↔ejecutado.
  contratoPartidaId String?
  contratoPartida   PresupuestoPartida?  @relation("PartidaContratoEjecutado", fields: [contratoPartidaId], references: [id])
  ejecutadoPartidas PresupuestoPartida[] @relation("PartidaContratoEjecutado")

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  concepto    Concepto?   @relation(fields: [conceptoId], references: [id])
  avances     EstimacionPartida[]
  compras     SolicitudPartida[]
  bitacora    BitacoraEntrada[]
  rayaTrabajos RayaTrabajo[]
  gastos      Gasto[]
}

// Estimaciones: government billing flow. Each one becomes a CFDI when timbrada.
model Estimacion {
  id            String   @id @default(cuid())
  companyId     String
  proyectoId    String
  presupuestoId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  numero        Int      // 1, 2, 3... per project
  periodoInicio DateTime
  periodoFin    DateTime
  estado        EstimacionEstado @default(BORRADOR)

  subtotal             Float
  retencionGarantia    Float @default(0)
  amortizacionAnticipo Float @default(0)
  iva                  Float
  total                Float

  // Link to the actual stamped CFDI when timbrada
  invoiceId String?  @unique
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  proyecto    Proyecto    @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id])
  partidas    EstimacionPartida[]
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([proyectoId, numero])
}

enum EstimacionEstado {
  BORRADOR
  APROBADA
  TIMBRADA
  PAGADA
  CANCELADA
}

model EstimacionPartida {
  id                   String @id @default(cuid())
  estimacionId         String
  presupuestoPartidaId String
  cantidadEjecutada    Float  // this period
  cantidadAcumulada    Float  // running total
  importe              Float

  // Optional — records which unidad (e.g. Depto 101) consumed this avance.
  // Null for projects without unidad breakdowns.
  unidadProyectoId String?

  estimacion         Estimacion          @relation(fields: [estimacionId], references: [id], onDelete: Cascade)
  presupuestoPartida PresupuestoPartida  @relation(fields: [presupuestoPartidaId], references: [id])
  unidad             UnidadProyecto?     @relation(fields: [unidadProyectoId], references: [id])
}

// Project subdivisions — supports tower/apartment/nivel tree for multi-unit
// construction projects (Decolsa's Torres Platino: 3 towers × ~12 deptos each).
// Presupuesto partidas are usually scoped to the proyecto (template), and the
// specific unidad that consumed each unit of avance is recorded on the
// EstimacionPartida row.
model UnidadProyecto {
  id         String  @id @default(cuid())
  proyectoId String
  parentId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  nombre     String              // "Torre A", "Depto 101", "Nivel 3"
  tipo       String?             // "TORRE" | "NIVEL" | "DEPTO" — free-form tag
  codigo     String?             // "T-A", "101"
  orden      Int     @default(0)
  metadata   Json?               // {"superficie": 95.5, "recamaras": 2}

  parent   UnidadProyecto?  @relation("UnidadHierarchy", fields: [parentId], references: [id])
  hijos    UnidadProyecto[] @relation("UnidadHierarchy")
  proyecto Proyecto         @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  partidas           PresupuestoPartida[]
  estimacionPartidas EstimacionPartida[]
  rayaTrabajos       RayaTrabajo[]

  @@index([proyectoId, parentId])
}

// Programa de obra: hierarchical activity tree (Gantt source).
model ProgramaActividad {
  id          String   @id @default(cuid())
  proyectoId  String
  nombre      String
  fechaInicio DateTime
  fechaFin    DateTime
  porcAvance  Float    @default(0)
  parentId    String?

  parent   ProgramaActividad?  @relation("Subactividades", fields: [parentId], references: [id])
  hijos    ProgramaActividad[] @relation("Subactividades")
  proyecto Proyecto            @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

// Solicitudes de compra: purchase request → approval → payment workflow.
// When pagada, links to a BankTransaction so the bank reconciliation loop closes.
model SolicitudCompra {
  id          String   @id @default(cuid())
  companyId   String
  proyectoId  String?
  supplierId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folio  String
  estado SolicitudEstado @default(PENDIENTE)
  total  Float
  notas  String?

  // Header metadata — matches the partner's "SOLICITUD DE COTIZACIÓN"
  // Excel template (OBRA / Fecha solicitud / Fecha entrega / SOLICITUD N° /
  // CRÉDITO vs CONTADO).
  fechaEntrega DateTime?
  formaPago    SolicitudFormaPago?

  // Approval tracking
  aprobadaPorId String?
  aprobadaAt    DateTime?
  pagadaAt      DateTime?

  // When paid, link to the BankTransaction that funded it
  bankTransactionId String? @unique

  proyecto        Proyecto?           @relation(fields: [proyectoId], references: [id])
  supplier        Supplier?           @relation(fields: [supplierId], references: [id])
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankTransaction BankTransaction?    @relation(fields: [bankTransactionId], references: [id])
  partidas        SolicitudPartida[]
  cotizaciones    SolicitudCompraCotizacion[]

  @@unique([companyId, folio])
  @@index([companyId, estado])
}

enum SolicitudEstado {
  PENDIENTE
  APROBADA
  RECHAZADA
  PAGADA
  CANCELADA
}

enum SolicitudFormaPago {
  CREDITO
  CONTADO
}

model SolicitudPartida {
  id             String @id @default(cuid())
  solicitudId    String
  insumoId       String?
  descripcion    String
  unidad         String?  // TON, PALLET, m3, kg, pza — keeps requisición rows aligned with the Excel template
  cantidad       Float
  precioUnitario Float
  importe        Float

  // Link purchase to a specific ejecutado partida for cost tracking
  presupuestoPartidaId String?
  presupuestoPartida   PresupuestoPartida? @relation(fields: [presupuestoPartidaId], references: [id])

  solicitud SolicitudCompra @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  insumo    Insumo?         @relation(fields: [insumoId], references: [id])
  cotizaciones SolicitudCotizacionPartida[]
}

// ─── Cotizaciones (multi-vendor quotes for a requisición) ────────────────────
//
// Gerardo's flow: he sends a requisición (SolicitudCompra in REQUESTED
// state) to several proveedores, each comes back with their own pricing
// per line. The winning quote becomes the SolicitudCompra final + drives
// the eventual OC. Replaces the manual "compare 3 Excels" loop.
//
// One Cotizacion row per vendor per requisición; many CotizacionPartida
// rows per cotización (one per item priced). Switching the winner is a
// single isSelected flip.
model SolicitudCompraCotizacion {
  id              String   @id @default(cuid())
  solicitudId     String
  supplierId      String?
  supplierNombre  String   // "RYSCO", "BARAMAT" — free-text when supplier row doesn't exist yet
  fechaCotizacion DateTime @default(now())
  vigenciaHasta   DateTime?
  total           Float    @default(0)
  moneda          String   @default("MXN")
  notas           String?
  isSelected      Boolean  @default(false)
  // Scanned/uploaded quote — same dual-storage pattern as Gasto comprobantes.
  archivoUrl      String?
  archivoData     String?  @db.Text
  archivoMime     String?
  archivoName     String?
  createdAt       DateTime @default(now())

  solicitud SolicitudCompra @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  supplier  Supplier?       @relation(fields: [supplierId], references: [id])
  partidas  SolicitudCotizacionPartida[]

  @@index([solicitudId, isSelected])
}

model SolicitudCotizacionPartida {
  id                 String @id @default(cuid())
  cotizacionId       String
  solicitudPartidaId String
  precioUnitario     Float
  importe            Float
  tiempoEntrega      String?
  notas              String?

  cotizacion       SolicitudCompraCotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  solicitudPartida SolicitudPartida          @relation(fields: [solicitudPartidaId], references: [id])

  @@unique([cotizacionId, solicitudPartidaId])
}

// ─── Presupuesto versioning (ejecutado change log) ───────────────────────────

model PresupuestoVersion {
  id              String   @id @default(cuid())
  presupuestoId   String
  version         Int
  createdAt       DateTime @default(now())
  descripcion     String?  // "Engineer found stone walls", "Added waterproofing"
  snapshotTotal   Float    // montoTotal at time of snapshot

  presupuesto Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)

  @@unique([presupuestoId, version])
}

// ─── Bitácora de obra (field log) ────────────────────────────────────────────

model BitacoraEntrada {
  id          String       @id @default(cuid())
  proyectoId  String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  fecha       DateTime     @default(now())  // field date (may differ from createdAt)
  texto       String       @db.Text
  tipo        BitacoraTipo @default(NOTA)

  // Optional links
  presupuestoPartidaId String?
  fotos                String[]  // URL array for photos

  proyecto           Proyecto            @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  presupuestoPartida PresupuestoPartida? @relation(fields: [presupuestoPartidaId], references: [id])

  @@index([proyectoId, fecha])
}

enum BitacoraTipo {
  NOTA
  DECISION
  PROBLEMA
  CLIMA
  FOTO
}

// ─── Pagos de proyecto (anticipo, estimaciones, retención) ───────────────────

model Pago {
  id                String   @id @default(cuid())
  proyectoId        String
  companyId         String
  createdAt         DateTime @default(now())

  tipo              PagoTipo
  monto             Float
  fecha             DateTime
  referencia        String?
  bankAccountId     String?
  bankTransactionId String?  @unique
  estimacionId      String?

  proyecto Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([proyectoId])
}

enum PagoTipo {
  ANTICIPO
  ESTIMACION
  RETENCION_LIBERADA
}

// ─── CONSTRUCCION_CUADRILLAS add-on ─────────────────────────────────────────
//
// Decolsa-style weekly destajo workflow. A Cuadrilla is a trade team
// (albañilería, plomería, etc.) scoped to one proyecto. Miembros are
// optional named references — some may be IMSS-registered (employeeId FK),
// most are cash-only (free-text nombre, employeeId=null).
//
// Rayas are WEEKLY cash-flow events. When a raya is marked PAGADA we
// emit a BankTransaction; the raya keeps the FK so we can reconcile
// later. No PayrollRun integration — rayas sit parallel to the nomina
// module because most destajo workers are not formally registered.

model Cuadrilla {
  id           String   @id @default(cuid())
  companyId    String
  proyectoId   String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  nombre       String   // "Albañilería", "Plomería y Gas"
  especialidad String   // free-text tag: "ALBANILERIA" | "PLOMERIA" | "ELECTRICO" | ...
  jefeNombre   String?  // "Maestro Juan", purely descriptive
  notas        String?
  isActive     Boolean  @default(true)

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proyecto  Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  miembros  CuadrillaMiembro[]
  rayas     RayaSemanal[]

  @@unique([proyectoId, nombre])
  @@index([companyId, isActive])
}

model CuadrillaMiembro {
  id             String   @id @default(cuid())
  cuadrillaId    String
  createdAt      DateTime @default(now())

  nombre         String   // free-text (works for both formal & cash workers)
  employeeId     String?  // optional FK when this miembro is also an IMSS-registered Employee
  rolEnCuadrilla String?  // "Oficial" | "Ayudante" | "Maestro" — free text
  isActive       Boolean  @default(true)

  cuadrilla Cuadrilla @relation(fields: [cuadrillaId], references: [id], onDelete: Cascade)
  employee  Employee? @relation(fields: [employeeId], references: [id])
  detalles  RayaDetalleMiembro[]

  @@index([cuadrillaId, isActive])
}

// A weekly raya for one cuadrilla. Always a cash-flow event — on pagar
// we create a BankTransaction debited from the cuadrilla's paying account
// and store its id here.
model RayaSemanal {
  id           String   @id @default(cuid())
  companyId    String
  proyectoId   String
  cuadrillaId  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  semanaInicio DateTime    // Monday 00:00 local
  semanaFin    DateTime    // Sunday 23:59 local
  estado       RayaEstado  @default(BORRADOR)
  totalDestajo Float       @default(0)  // sum of RayaTrabajo.importeDestajo
  notas        String?

  // Filled when marked PAGADA. Unique so we can't double-book a raya.
  bankTransactionId String? @unique
  pagadaAt          DateTime?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proyecto  Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  cuadrilla Cuadrilla @relation(fields: [cuadrillaId], references: [id])
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  trabajos  RayaTrabajo[]
  detalles  RayaDetalleMiembro[]

  @@unique([cuadrillaId, semanaInicio])
  @@index([proyectoId, semanaInicio])
  @@index([companyId, estado])
}

enum RayaEstado {
  BORRADOR
  APROBADA
  PAGADA
}

// Line item inside a raya: "en el Depto 101, hicimos X de aplanados por $Y"
model RayaTrabajo {
  id                   String   @id @default(cuid())
  rayaId               String
  presupuestoPartidaId String?  // optional link to a leaf partida (drives avance)
  unidadProyectoId     String?  // optional "en el Depto 101"
  descripcion          String
  cantidad             Float?
  unidad               String?
  importeDestajo       Float

  raya               RayaSemanal         @relation(fields: [rayaId], references: [id], onDelete: Cascade)
  presupuestoPartida PresupuestoPartida? @relation(fields: [presupuestoPartidaId], references: [id])
  unidadProyecto     UnidadProyecto?     @relation(fields: [unidadProyectoId], references: [id])

  @@index([rayaId])
}

// How much each miembro got paid in this raya (days + importe). The sum
// of detalles.importe should match the raya's totalDestajo, but we don't
// enforce it at the DB level — the UI will show a diff if they disagree.
model RayaDetalleMiembro {
  id             String @id @default(cuid())
  rayaId         String
  miembroId      String
  diasTrabajados Float  @default(6)
  importe        Float

  raya    RayaSemanal      @relation(fields: [rayaId], references: [id], onDelete: Cascade)
  miembro CuadrillaMiembro @relation(fields: [miembroId], references: [id])

  @@unique([rayaId, miembroId])
}

// ─── Gasto (Katia's pay-and-register workflow) ──────────────────────────────
//
// Lightweight expense model for the WhatsApp-driven field-spending flow
// that SolicitudCompra is too heavy for. Rosy (field PM) requests a
// payment via WhatsApp; Katia (admin) creates a Gasto row, the system
// suggests which insumo/partida matches, she approves and pays in one
// click. Optional caja=true flag means the money came out of the petty
// cash fund (BankAccount with tipo=CAJA), not a main cuenta.
//
// Why a new model instead of extending SolicitudCompra:
//   - SolicitudCompra has partidas array, approval chain, receive step;
//     overkill for a single-line SPEI "varilla arena $2,375 to Jose Luis".
//   - Matching target is either a PresupuestoPartida (budget leaf) OR an
//     Insumo (material master) OR both. SolicitudPartida only links to
//     PresupuestoPartida.
//   - The value-add is fast entry + the "does this fit the explosión
//     de insumos" check, which is its own endpoint.
model Gasto {
  id           String     @id @default(cuid())
  companyId    String
  proyectoId   String
  bankAccountId String     // which account paid (main cuenta or caja chica)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // What + to whom + how much
  beneficiarioNombre String   // "Lesly Flores", "Jose Luis Lopez Pozos"
  descripcion        String   // free-text what was bought: "varilla y arena"
  importe            Float

  // Physical quantity + unit — optional for indirect gastos but required
  // for a meaningful insumo variance view (planned vs real PU). If set,
  // importe / cantidad should match the real PU Rosy paid.
  cantidad Float?
  unidad   String?

  // Optional budget linkage — Katia picks from auto-suggest
  presupuestoPartidaId String?
  insumoId             String?

  // Weekly reembolso this gasto belongs to. Set when the gasto is part
  // of a Rosy-style weekly reimbursement package; null for one-off pays.
  reembolsoId String?

  // Attachments — two flavors:
  //   *Url  = external URL (legacy, back-compat with pre-upload flow)
  //   *Data = base64 content directly in DB (same pattern as csdCer /
  //           fielCer elsewhere). Small-file friendly — Rosy's WhatsApp
  //           photos are usually < 2 MB. Mime + name let us serve them
  //           back with the right headers.
  comprobanteUrl      String?  // invoice/receipt URL
  comprobanteData     String?  @db.Text
  comprobanteMime     String?
  comprobanteName     String?
  pagoComprobanteUrl  String?  // SPEI / cheque screenshot URL
  pagoComprobanteData String?  @db.Text
  pagoComprobanteMime String?
  pagoComprobanteName String?

  estado       GastoEstado @default(PENDIENTE)

  // Flag that this came out of the caja chica account (redundant with
  // bankAccount.tipo=CAJA but kept for fast filtering and audit).
  caja         Boolean     @default(false)

  // "Indirecto" = overhead / costo indirecto: gasolina, viáticos,
  // herramienta menor, flete, seguridad, renta de andamios, alimentos
  // del personal. These are legitimate project costs that DON'T belong
  // to a specific partida/insumo. Real construction accounting breaks
  // them out as % sobre MO+materiales.
  //
  // Approval rule enforced in aprobar-pagar: a Gasto must be EITHER
  //   - linked to a presupuestoPartidaId or insumoId (directo), OR
  //   - indirecto=true with a categoriaIndirecto tag.
  // Otherwise approval is refused — guarantees budget attribution.
  indirecto         Boolean @default(false)
  categoriaIndirecto String? // free-text tag: "GASOLINA" | "VIATICOS" | "FLETE" | "HERRAMIENTA_MENOR" | "EQUIPO_SEGURIDAD" | "RENTA_EQUIPO" | "ALIMENTOS" | etc.

  // Populated on /aprobar-pagar
  bankTransactionId String?   @unique
  pagadoAt          DateTime?

  // Katia's approval audit
  aprobadoPor  String?   // User id
  aprobadoAt   DateTime?

  notas        String?

  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proyecto          Proyecto            @relation(fields: [proyectoId], references: [id])
  bankAccount       BankAccount         @relation(fields: [bankAccountId], references: [id])
  presupuestoPartida PresupuestoPartida? @relation(fields: [presupuestoPartidaId], references: [id])
  insumo            Insumo?             @relation(fields: [insumoId], references: [id])
  bankTransaction   BankTransaction?    @relation(fields: [bankTransactionId], references: [id])
  reembolso         ReembolsoSemanal?   @relation(fields: [reembolsoId], references: [id], onDelete: SetNull)

  @@index([companyId, estado])
  @@index([proyectoId, createdAt])
  @@index([reembolsoId])
}

enum GastoEstado {
  PENDIENTE
  APROBADO   // Katia validated; still waiting to pay
  PAGADO     // BankTransaction created
  RECHAZADO  // out of budget, duplicate, etc.
}

// ─── ReembolsoSemanal (Concentrado Semanal / weekly reimbursement) ───────────
//
// Rosy's pattern: at end of each week she submits a PDF package of what
// she spent + the nómina + next-week caja chica advance. Katia validates
// line-by-line, the system computes the total, and Juan SPEIs the
// balance to Rosy as a single transfer. Replaces the "WhatsApp table →
// spreadsheet → SPEI screenshot" loop.
//
// A ReembolsoSemanal is a HEADER containing many Gasto rows (each tied
// to insumo/partida or marked indirecto). On /reembolsar we:
//   1. Validate every gasto has attribution (enforced on aprobar-pagar
//      already, but double-check here so the reembolso as a whole is
//      consistent).
//   2. Compute totalGastos from the joined Gastos.
//   3. Create ONE BankTransaction DEBITO for totalReembolso (anticipo
//      aplicado is subtracted — that's the caja chica previously
//      advanced to Rosy).
//   4. Flip every Gasto in the package to PAGADO + set their
//      bankTransactionId to the single BT, so the cash-flow ties out.
//   5. Flip reembolso.estado = REEMBOLSADO.
//
// Integration with nómina (Phase A-5, deferred): a RayaSemanal can
// optionally point at a Reembolso so the weekly nómina is part of the
// same package. For now the v1 treats nómina as just another Gasto
// line with indirecto=true, categoriaIndirecto=NOMINA.
model ReembolsoSemanal {
  id            String             @id @default(cuid())
  companyId     String
  proyectoId    String
  bankAccountId String             // account that will pay the final SPEI (usually CHEQUES)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  semanaInicio  DateTime
  semanaFin     DateTime
  estado        ReembolsoEstado    @default(SUBMITTED)

  // Running totals (denormalized for fast list views; recomputed on gasto add/remove)
  totalGastos   Float              @default(0)
  // Adelanto previo de caja chica que este reembolso justifica.
  // Ejemplo: Rosy recibió $5,000 el lunes para caja chica; gastó $7,500
  // en la semana; reembolso total a pagar = $7,500 - $5,000 = $2,500.
  anticipoAplicado Float           @default(0)
  totalReembolso Float             @default(0)  // totalGastos - anticipoAplicado

  // Pago
  bankTransactionId String?        @unique
  reembolsadoAt DateTime?
  reembolsadoPor String?

  notas         String?

  company       Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  proyecto      Proyecto           @relation(fields: [proyectoId], references: [id])
  bankAccount   BankAccount        @relation(fields: [bankAccountId], references: [id])
  bankTransaction BankTransaction? @relation(fields: [bankTransactionId], references: [id])
  gastos        Gasto[]

  @@unique([proyectoId, semanaInicio])
  @@index([companyId, estado])
}

enum ReembolsoEstado {
  SUBMITTED   // Rosy mandó el paquete, Katia aún no revisa
  REVISADO    // Katia validó líneas, listo para pagar
  REEMBOLSADO // Juan ya SPEIó a Rosy, BankTransaction creada
  RECHAZADO   // inconsistencias / duplicados / no justificado
}
