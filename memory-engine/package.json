{
  "name": "memory-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Personal autobiographical archive. Standalone: shares no database, no auth and no code with contabilidad-os.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p ${PORT:-3100}",
    "build": "next build",
    "start": "next start -p ${PORT:-3100}",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "export": "tsx scripts/export-markdown.ts",
    "test:db": "vitest run -c vitest.integration.config.mts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
