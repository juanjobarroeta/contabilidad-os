FROM node:22.23.2-bookworm@sha256:8a34c4ab3ea2c5cd194f07e317b2a8f09461d3c8b05c4e34c8ccd56d56024c4d AS base

ENV NODE_ENV=production

FROM base AS runtime-dependencies

ENV NODE_ENV=production
WORKDIR /app

COPY workers/sat-native-pilot/package.json workers/sat-native-pilot/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund \
  && npm audit --omit=dev --audit-level=high

FROM base AS prisma-client

ENV NODE_ENV=development
WORKDIR /build

COPY workers/sat-native-pilot-build/package.json workers/sat-native-pilot-build/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY prisma/schema.prisma ./prisma/schema.prisma
RUN node_modules/.bin/prisma generate --schema=prisma/schema.prisma

FROM base AS runtime

WORKDIR /app

COPY --from=runtime-dependencies /app/node_modules ./node_modules
COPY --from=prisma-client /build/node_modules/.prisma ./node_modules/.prisma
COPY workers/sat-native-pilot/package.json ./package.json
COPY tsconfig.json ./
COPY src/lib/crypto.ts src/lib/prisma.ts src/lib/prisma-decimal.ts ./src/lib/
COPY src/lib/legal/documentos.ts ./src/lib/legal/documentos.ts
COPY \
  src/lib/fiscal/cumplimiento/sat-native/ce-login-probe.ts \
  src/lib/fiscal/cumplimiento/sat-native/credential-broker.ts \
  src/lib/fiscal/cumplimiento/sat-native/errors.ts \
  src/lib/fiscal/cumplimiento/sat-native/preflight.ts \
  src/lib/fiscal/cumplimiento/sat-native/routes.ts \
  src/lib/fiscal/cumplimiento/sat-native/transport.ts \
  src/lib/fiscal/cumplimiento/sat-native/types.ts \
  src/lib/fiscal/cumplimiento/sat-native/worker-action.ts \
  ./src/lib/fiscal/cumplimiento/sat-native/
COPY src/lib/fiscal/cumplimiento/sat-native/fixtures/ce-login-contract.2026-09-08.json ./src/lib/fiscal/cumplimiento/sat-native/fixtures/ce-login-contract.2026-09-08.json
COPY \
  scripts/sat-native-ce-pilot-worker.ts \
  scripts/sat-native-ce-preflight.ts \
  scripts/sat-native-ce-login-probe.ts \
  ./scripts/

USER node

CMD ["node", "node_modules/tsx/dist/cli.mjs", "scripts/sat-native-ce-pilot-worker.ts"]
