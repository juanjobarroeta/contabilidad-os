# Database (Railway Postgres)
DATABASE_URL="postgresql://user:password@host:5432/contabilidad_os"

# NextAuth (v5 reads AUTH_SECRET; older refs read NEXTAUTH_SECRET — set both the same)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_SECRET="same value as NEXTAUTH_SECRET"

# Facturapi
FACTURAPI_SECRET_KEY="sk_test_..."   # sandbox key for dev
# FACTURAPI_SECRET_KEY="sk_live_..." # production
# FACTURAPI_MASTER_KEY="..."         # only if auto-provisioning Facturapi orgs

# Anthropic (AI Assistant)
ANTHROPIC_API_KEY="sk-ant-..."

# OpenAI — Whisper (WhatsApp voice notes) + embeddings del knowledge base
# fiscal (search_fiscal_knowledge). If unset, the bot declines voice notes and
# the fiscal KB tool reports itself unavailable instead of erroring.
# Setup del KB: npm run fiscal:setup → npm run db:push → npm run fiscal:ingest-ley LISR
# OPENAI_API_KEY="sk-..."

# Encryption-at-rest for credentials (CSD/FIEL keys + passwords, Facturapi key).
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# If unset, secrets are stored WITHOUT encryption (dev only — REQUIRED in prod).
CREDENTIALS_ENCRYPTION_KEY="generate-with: openssl rand -base64 32"

# ── Sentry ───────────────────────────────────────────────────────────────────
# Sin DSN, TODO el monitoreo es un no-op silencioso (solo console).
# Las dos primeras llevan el MISMO valor (la DSN del proyecto en Sentry): una
# la lee el servidor y la otra se hornea al bundle del navegador. Una DSN solo
# permite ESCRIBIR eventos, así que exponerla al cliente es normal y seguro.
# SENTRY_DSN="https://<key>@<org>.ingest.us.sentry.io/<project>"
# NEXT_PUBLIC_SENTRY_DSN="https://<key>@<org>.ingest.us.sentry.io/<project>"
#
# Muestreo de trazas: 0 apaga el tracing, 1 lo graba todo. Default 0.1 en
# producción y 0 en desarrollo. Las trazas son lo que conecta un error del
# satélite Automotriz con la excepción del hub que lo causó — con 0 se pierde
# esa correlación. Subirlo consume más cuota.
# SENTRY_TRACES_SAMPLE_RATE="0.1"
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
#
# Session Replay (graba la pantalla del usuario cuando hay error). APAGADO por
# omisión a propósito: aquí se ven RFCs, montos y declaraciones. Al encenderlo
# el texto va enmascarado, pero decídelo a conciencia.
# NEXT_PUBLIC_SENTRY_REPLAY="1"
#
# Subida de source maps en el build (si falta, el build NO falla: solo se salta
# la subida y los stack traces de producción quedan minificados). Genera el
# token en Sentry → Settings → Auth Tokens con el scope `project:releases`.
# En Railway va como variable de BUILD, no solo de runtime.
# SENTRY_AUTH_TOKEN="sntrys_..."
# SENTRY_ORG="cumplo-id"
# SENTRY_PROJECT="contabilidad-os"

# Background SAT sync cron (/api/cron/sat-sync).
# Endpoint returns 401 until this is set. Pass it as:
#   Authorization: Bearer <secret>   or   x-cron-secret: <secret>
CRON_SECRET="generate-with: openssl rand -base64 32"

# MCP del operador (/api/mcp/<llave>): conecta Claude a la operación completa.
# VARIAS llaves separadas por coma a propósito — rotar es agregar la nueva,
# migrar el conector y borrar la vieja, sin ventana de corte. Mínimo 24 chars
# por llave (las más cortas se ignoran). Sin la variable, la ruta responde 404.
# SOLO para el operador: las tools ven todas las empresas.
MCP_OPERADOR_KEYS="generate-with: openssl rand -hex 24"

# CORS allowlist for the bearer-token / satellite API (comma-separated origins).
# Not needed for the web app or the cron. Optional.
# API_ALLOWED_ORIGINS="https://app.example.com,https://otra.example.com"

# WhatsApp channel (W0) — Twilio. Webhook is a no-op until these are set.
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."                 # also the HMAC key Twilio signs webhooks with
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"   # your Twilio WhatsApp sender
# Pin the exact public webhook URL Twilio POSTs to (recommended behind proxies);
# if unset it's reconstructed from x-forwarded-proto/host headers.
# TWILIO_WEBHOOK_URL="https://staging.example.com/api/whatsapp/webhook"
#
# Proactive sends to "cold" numbers (outside WhatsApp's 24h service window) require
# a pre-approved Content template. These are Content SIDs (HX...) from Twilio's
# Content Template Builder. Optional: when unset we fall back to freeform send
# (which only works inside the service window / sandbox / dev).
# TWILIO_OTP_TEMPLATE_SID="HX..."   # authentication (OTP) template; verification code = variable {{1}}
# TWILIO_IVA_TEMPLATE_SID="HX..."   # utility template for IVA-change notice; vars: {{1}}=periodo, {{2}}=IVA actual, {{3}}=IVA previo
# TWILIO_DIGEST_TEMPLATE_SID="HX..." # utility template del digest matutino (src/lib/whatsapp/digest.ts)
# Per-message cost estimate (USD) for COGS/rentabilidad. Default 0.012 (utility
# template, all-in). Optional overrides; session/freeform replies are cheaper.
# TWILIO_WHATSAPP_MESSAGE_USD="0.012"
# TWILIO_WHATSAPP_TEMPLATE_USD="0.012"   # overrides MESSAGE_USD for template sends
# TWILIO_WHATSAPP_SESSION_USD="0.012"    # overrides MESSAGE_USD for in-window replies

# Gating REAL de suscripción en las ESCRITURAS de alto valor (timbrado, nómina,
# declaraciones, bancos, clientes, chat IA, WhatsApp...). Apagado (default):
# nadie se bloquea aunque su prueba haya vencido — despliega seguro antes de
# que el cobro en línea (Stripe) exista. Encendido: EXPIRED/CANCELED reciben
# 402 en escrituras (las lecturas NUNCA se bloquean); PAST_DUE tiene periodo de
# gracia con advertencia. Ver src/lib/subscription-gate.ts.
# SUBSCRIPTION_ENFORCEMENT_ENABLED="true"

# Suspensión total por falta de pago (pantalla CuentaSuspendida). Apagado por
# default; ver src/lib/billing/suspension.ts.
# BILLING_SUSPENSION_ENABLED="true"

# Belvo (Open Banking - Module 4, optional)
# BELVO_SECRET_ID=""
# BELVO_SECRET_PASSWORD=""
# BELVO_ENV="sandbox"

# Padel module (theclubpadel satellite). Per-club Playtomic credentials live on
# PadelClubConfig (encrypted); this only selects the API host. Crons reuse
# CRON_SECRET above; the satellite origin must be added to API_ALLOWED_ORIGINS.
# PLAYTOMIC_BASE_URL="https://api.playtomic.io"

# Web Push (VAPID) — booking reminders + notifications. Generate a keypair with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""           # same as VAPID_PUBLIC_KEY, exposed to the client
# VAPID_SUBJECT="mailto:soporte@theclubpadel.com"

# Payroll/IMSS constant (UMA diario), optional unless testing nómina
# UMA_DIARIO="113.14"
# Salarios mínimos 2026 (general y Zona Libre de la Frontera Norte). El código
# trae los valores vigentes por default; el env los overridea en el ajuste anual.
# SALARIO_MINIMO_GENERAL="315.04"
# SALARIO_MINIMO_ZLFN="440.87"

# Satellite app link (cosmetic), optional
# NEXT_PUBLIC_BARTIZ_URL="https://bartiz.example.com"

# Stripe (suscripciones SaaS). Sin estas variables, las rutas de facturación
# responden 503 y la UI muestra "pagos aún no habilitados" — se puede desplegar
# sin cuenta de Stripe. Los montos/moneda viven en los objetos Price de Stripe.
# Webhook: crea un endpoint en Stripe apuntando a <APP_URL>/api/billing/webhook
# suscrito a los eventos: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted,
# invoice.payment_failed. El signing secret del endpoint va en
# STRIPE_WEBHOOK_SECRET (sin él, el webhook responde 503 — falla cerrado).
# STRIPE_SECRET_KEY="sk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Precios de lista decididos (2026-07): Básico $499 MXN/mes y Profesional
# $1,299 MXN/mes. Crear los Price en Stripe con esos montos. Si cambian,
# actualizar también PLANS en src/app/onboarding/page.tsx.
# Los precios A LA MEDIDA (despachos, multiempresa, negociaciones) NO son un
# plan aparte: se dan con un CÓDIGO DE DESCUENTO generado por el admin de
# plataforma en /configuracion/codigos, que el cliente escribe en la pantalla
# de pago de Stripe.
# STRIPE_PRICE_BASICO="price_..."     # plan Básico (tier AUTOMATIZADO)
# STRIPE_PRICE_PRO="price_..."        # plan Profesional (tier PRO)
# Precios ANUALES (opcionales; sin ellos el checkout anual responde 503 con
# mensaje claro y el mensual sigue funcionando). Crear cada uno en Stripe como
# Price de intervalo anual con monto = 10 meses («2 meses gratis»): Básico
# $4,990, Profesional $12,990.
# STRIPE_PRICE_BASICO_ANUAL="price_..."
# STRIPE_PRICE_PRO_ANUAL="price_..."
# LEGACY: el plan Despacho ($299 MXN/empresa/mes per-unit, mínimo 10) ya no se
# ofrece en la UI; sus variables sólo importan si existe alguna suscripción
# COMPLEMENTOS (add-ons): módulos a la medida que se cobran como una partida
# EXTRA de la misma suscripción, así el cliente paga todo en un solo cargo. El
# satélite los pide por clave (addons: ["PURIFICADORA"]) — nunca por Price ID —
# y sin la variable el checkout simplemente omite la partida.
# STRIPE_PRICE_PURIFICADORA="price_..."   # PurificadoraOS ($1,701 MXN/mes)
# USO EXTRA DE IA: pago ÚNICO que amplía el tope mensual de IA de una empresa
# para el mes en curso (IA_PAQUETE_EXTRA_USD en src/lib/planes.ts, 10 USD de
# costo). Crear el Price en Stripe como "one-time" con el precio de venta que
# decidas (sugerido: $299 MXN). Sin la variable, "Ampliar límite" responde 503.
# STRIPE_PRICE_IA_EXTRA="price_..."

# Admin de PLATAFORMA (correos separados por coma, sin distinguir mayúsculas):
# habilita el generador de códigos de descuento en /configuracion/codigos.
# Vacío o ausente = nadie es admin (falla cerrado).
# PLATFORM_ADMIN_EMAILS="tu@correo.com"

# Syntage (agregador de cumplimiento fiscal: opinión, CSF, declaraciones, CE).
# Sin la key, el cliente lanza al construirse — los crons de compliance la
# necesitan. BASE_URL sólo para apuntar a otro ambiente.
# SYNTAGE_API_KEY=""
# SYNTAGE_BASE_URL="https://api.syntage.com"

# Selector de PAC. Default "facturapi" (el activo). "swsapien" es un andamio
# implementado pero NO activo (ver src/lib/pac/swsapien.ts); sus credenciales
# sólo importan si se activa.
# PAC_PROVIDER="facturapi"
# SW_TOKEN=""
# SW_USER=""
# SW_PASSWORD=""
# SW_BASE_URL=""

# Banxico SIE (INPC para actualización Art. 57 + tipo de cambio FIX). Sin token,
# el cron de cotejo se salta la parte que lo necesita (no truena). Las series
# tienen default correcto (SP1 = INPC); sólo overridear si Banxico las cambia.
# BANXICO_TOKEN=""
# BANXICO_INPC_SERIE="SP1"
# BANXICO_FIX_SERIE=""

# Lista EFOS 69-B del SAT. El código trae la URL oficial por default; esta
# variable sólo la overridea (p. ej. un mirror si el SAT cambia el sitio).
# EFOS_LIST_URL=""

# Modelo del chat IA (/api/ai/chat y WhatsApp). Default en código con fallback
# automático si el tier de la key no tiene el primario.
# AI_CHAT_MODEL="claude-fable-5"

# Knowledge base fiscal — palancas de búsqueda (Fase 2 del copiloto). Se
# fijan con el eval; ver docs/FISCAL-KNOWLEDGE-BASE.md §8.
# FISCAL_KB_MODO="vector"        # "vector" | "hibrido" (léxico + exacto + RRF)
# FISCAL_KB_RERANK="1"           # default ON (48 % → 65 % en el eval); "0" lo apaga
# AI_RERANK_MODEL="claude-haiku-4-5-20251001"

# Scheduler de crons DENTRO de la app (src/lib/cron-scheduler.ts). En producción
# está encendido salvo IN_APP_CRON="0"; fuera de producción sólo con "1".
# IN_APP_CRON="1"

# Aviso por WhatsApp cuando cambia el IVA de un periodo ya declarado. Apagado
# salvo que valga exactamente "true".
# IVA_CHANGE_NOTICE_ENABLED="true"

# ── Intake & prioritization (docs/INTAKE.md) ─────────────────────────────────
# Master switch de la captura (tap de WhatsApp, ingest de Zoom y crons de
# intake). Sin "1" todo el subsistema es un no-op.
# INTAKE_ENABLED="1"

# Webhook de Zoom (app Server-to-Server OAuth → Secret Token).
# ZOOM_WEBHOOK_SECRET_TOKEN=""

# Transcripción primaria de grabaciones (nova-2 + vocabulario fiscal en
# config/vocabulary.es-mx.json). Sin ella cae a Whisper (OPENAI_API_KEY).
# DEEPGRAM_API_KEY=""

# Bot de aprobación por Telegram (tarjetas + digests).
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# TELEGRAM_WEBHOOK_SECRET=""

# Creación de issues al aprobar. Repo default "owner/repo"; override por
# producto con INTAKE_GITHUB_REPO_<PRODUCTO>. El board Projects v2 y su campo
# Score son opcionales (fase 5).
# INTAKE_GITHUB_TOKEN=""
# INTAKE_GITHUB_REPO=""
# INTAKE_GITHUB_PROJECT_ID=""
# INTAKE_GITHUB_SCORE_FIELD_ID=""

# Modelo del agente de extracción (default: AI_CHAT_MODEL).
# AI_EXTRACT_MODEL=""
